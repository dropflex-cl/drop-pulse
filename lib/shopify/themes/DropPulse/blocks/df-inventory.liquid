<div data-df-pdp-component="inventory">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.inventory.value -%}
<script src="{{ 'df-inventory.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-inventory">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% if df_default.content.state == 'empty' %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% else %}{% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% if df_variant.content.state == 'empty' %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% else %}{% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% if df_variants.state == 'empty' %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% else %}{% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_variants %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'inventory', product: df_product %}{% endif %}
{%- endif -%}

</div>



{% schema %}
{
  "name": "DropFlex · Disponibilidad",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "El estado sale del inventario real de la variante. Los textos vienen del metafield dropflex.inventory; estos son el respaldo."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Mensaje de urgencia",
      "info": "Texto comercial fijo, independiente del inventario. Déjalo vacío para ocultarlo.",
      "default": "Últimas unidades disponibles"
    },
    {
      "type": "text",
      "id": "available_text",
      "label": "Disponible",
      "info": "Puedes usar {min} y {max} (días hábiles de entrega).",
      "default": "En stock, recíbelo en {min} a {max} días hábiles"
    },
    {
      "type": "text",
      "id": "limited_text",
      "label": "Quedan pocas",
      "info": "{qty} es la cantidad real. Sin inventario rastreado no se muestra.",
      "default": "Solo quedan {qty} unidades"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Agotado",
      "default": "Agotado, vuelve pronto"
    },
    {
      "type": "text",
      "id": "preorder_text",
      "label": "Preventa",
      "info": "Sin stock pero con venta permitida."
    },
    {
      "type": "header",
      "content": "Reglas"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Umbral de pocas unidades",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Mostrar cuántas quedan",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_when_untracked",
      "label": "Mostrar sin inventario rastreado",
      "info": "Típico en dropshipping: se muestra como disponible.",
      "default": true
    },
    {
      "type": "range",
      "id": "handling_days",
      "label": "Días de preparación",
      "info": "Respaldo si la tienda no tiene logística cargada.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "transit_days_min",
      "label": "Tránsito mínimo (días)",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "transit_days_max",
      "label": "Tránsito máximo (días)",
      "info": "El de regiones: el texto debe ser verdad en todo el país.",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Punto animado",
      "default": true
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Disponibilidad"
    }
  ]
}
{% endschema %}
