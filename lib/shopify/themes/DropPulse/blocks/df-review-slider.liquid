{%- assign df_conversion_product = closest.product | default: product | default: section.settings.product -%}
{%- unless df_conversion_product.metafields.dropflex.conversion_supports.value.disabled_components contains 'review-slider' -%}
<div data-df-pdp-component="review-slider">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.review_slider.value -%}
<script src="{{ 'df-slider.js' | asset_url }}" defer></script>
<script src="{{ 'df-review-slider.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-review-slider">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% if df_default.content.state == 'empty' %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% else %}{% render 'df-review-slider-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% if df_variant.content.state == 'empty' %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% else %}{% render 'df-review-slider-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% if df_variants.state == 'empty' %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% else %}{% render 'df-review-slider-content', product: df_product, section: section, block: block, content: df_variants %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-slider', product: df_product %}{% endif %}
{%- endif -%}

</div>

{%- endunless -%}

{% stylesheet %}
  .df-review-slider {
    display: block;
    min-width: 0;
    scroll-margin-top: 96px;
    --df-slide-width: 100%;
    --df-slide-gap: 12px;
  }

  /* Título del bloque: el mismo aire que separa los bloques de la ficha. */
  .df-review-slider__heading {
    margin-bottom: 16px;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .df-review-slider .df-slider__track > .df-review-slider__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-bg);
  }

  .df-review-slider--compact .df-slider__track > .df-review-slider__card {
    padding-inline: 20px;
  }

  .df-review-slider__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 50px;
    height: 50px;
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-accent-soft);
    color: var(--df-accent-ink);
    font-weight: 700;
    font-size: 1.125rem;
  }

  .df-review-slider__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-review-slider__body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .df-review-slider__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 0;
    font-size: 0.8125rem;
  }

  .df-review-slider__author {
    font-weight: 600;
    white-space: nowrap;
  }

  .df-review-slider__text {
    margin: 0;
  }

  .df-review-slider__text p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--df-review-lines, 2);
    line-clamp: var(--df-review-lines, 2);
    color: var(--df-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .df-review-slider__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
    color: var(--df-muted);
    font-size: 0.75rem;
  }

  .df-review-slider__full summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    list-style: none;
  }

  .df-review-slider__full summary::-webkit-details-marker {
    display: none;
  }

  .df-review-slider__full p {
    margin: 0 0 4px;
    color: var(--df-fg);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* «ver completa» se abre creciendo (::details-content + interpolate-size, como el FAQ); donde el
     navegador no lo soporta, abre sin animar. */
  .df-review-slider {
    interpolate-size: allow-keywords;
  }

  .df-review-slider__full::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--df-dur-slow) var(--df-ease-standard),
      content-visibility var(--df-dur-slow) allow-discrete;
  }

  .df-review-slider__full[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .df-review-slider__full::details-content {
      transition: none;
    }
  }

  [data-df-motion='off'] .df-review-slider__full::details-content {
    transition: none;
  }


  @media (min-width: 750px) {
    .df-review-slider__avatar {
      width: 62px;
      height: 62px;
    }

    .df-review-slider__meta,
    .df-review-slider__text p {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Reseñas",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra reseñas aprobadas en DropFlex. La selección y los extractos vienen del metafield dropflex.review_slider; sin él, se eligen con estos ajustes."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Opcional. Puedes usar {count} y {rating} (datos reales)."
    },
    {
      "type": "header",
      "content": "Selección"
    },
    {
      "type": "range",
      "id": "min_reviews",
      "label": "Mínimo de reseñas",
      "info": "Con menos reseñas aprobadas, el bloque no se muestra.",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Reseñas a mostrar",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Calificación mínima",
      "info": "Solo sin metafield. La nota y la cantidad totales se muestran igual en las estrellas.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "only_with_photo",
      "label": "Solo reseñas con foto",
      "info": "Solo sin metafield.",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancla",
      "info": "Id del bloque (sin #). Las estrellas llevan aquí si usan la misma. Usa uno solo por página.",
      "default": "resenas"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "photo", "label": "Con foto y flechas" },
        { "value": "compact", "label": "Compacto con puntos" }
      ],
      "default": "photo"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Tiempo por reseña",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "text_lines",
      "label": "Líneas del texto",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Mostrar fecha",
      "default": false
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Reseñas"
    }
  ]
}
{% endschema %}
