{%- assign df_product = closest.product | default: product -%}
{%- assign df_variants = df_product.metafields.dropflex.landing_listing.value -%}

{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-title">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-title-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-title-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-title-content', product: df_product, section: section, block: block %}
{%- endif -%}

{% stylesheet %}
  .df-title {
    font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Título",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "El nombre del producto, como el título principal de la página."
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Título"
    }
  ]
}
{% endschema %}
