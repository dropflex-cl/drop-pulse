{%- assign df_product = closest.product | default: product -%}
{%- assign df_variants = df_product.metafields.dropflex.landing_listing.value -%}

{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-subtitle">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-subtitle-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-subtitle-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-subtitle-content', product: df_product, section: section, block: block %}
{%- endif -%}

{% stylesheet %}
  .df-subtitle {
    font-size: var(--df-subtitle-size, 15px);
    line-height: 1.45;
    color: var(--df-muted);
    text-wrap: pretty;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Bajada",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "El texto sale del metafield dropflex.subtitle (la descripción corta de la ficha aprobada en DropFlex). Este es el respaldo."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto de respaldo"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño del texto",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Bajada"
    }
  ]
}
{% endschema %}
