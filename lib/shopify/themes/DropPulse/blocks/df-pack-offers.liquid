{%- doc -%}
  DropFlex · Packs (pack-offers). Bloque de la columna del producto, sobre el botón: la oferta en
  una línea y una tarjeta por pack (1, 2 y 3 unidades) con su foto, su nombre, el precio y el
  precio tachado. La tarjeta elegida es la variante que se compra.

  REGLA: cada pack es una VARIANTE real del producto; precio y tachado salen de la variante, nunca
  del metafield. Los textos (nombre, apoyo, distintivo) son las etiquetas de los packs aprobadas en
  DropFlex, en el orden de las variantes; sin ellas, el nombre de la variante. Con una sola
  variante (o más de una opción) no se dibuja: el selector del tema se encarga.

  Contenido: metafield `dropflex.offer` (json)
    { offer_line?: string, packs: [{ units, label, support?, badge? }] }
  Al elegir, cambia el input[name="id"] del formulario del producto y lo avisa con `change`:
  df-price y df-inventory lo escuchan (df-pack-offers.js).
{%- enddoc -%}
{%- liquid
  # closest.product: el producto de la ficha. Sin ajuste «product» propio: si el bloque tuviera uno
  # vacío, closest.product lo tomaría a él primero y el bloque quedaría sin producto.
  assign product = closest.product | default: product
  assign s = block.settings
  assign offer = product.metafields.dropflex.offer.value
  assign selected = product.selected_or_first_available_variant
  assign heading = offer.offer_line | default: s.heading

  assign show = false
  if product != blank and product.variants.size > 1 and product.options.size == 1
    assign show = true
  endif
-%}
{%- if show -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'df-pack-offers.js' | asset_url }}" defer></script>
  <df-pack-offers
    class="df df-pack-offers"
    style="{% render 'df-accent-vars', product: product %} margin-block: {{ s.margin_top }}px {{ s.margin_bottom }}px;"
    {{ block.shopify_attributes }}
  >
    <fieldset class="df-pack-offers__set">
      <legend class="df-visually-hidden">{{ heading | default: 'Elige tu pack' | escape }}</legend>
      {%- if heading != blank -%}
        <p class="df-pack-offers__heading" aria-hidden="true"><span>{{ heading | escape }}</span></p>
      {%- endif -%}
      {%- assign badge_used = false -%}
      {%- for v in product.variants limit: 4 -%}
        {%- liquid
          assign idx = forloop.index0
          assign pack = offer.packs[idx]
          assign label = pack.label | default: v.title
          assign support = pack.support
          assign badge = blank
          if pack.badge != blank and badge_used == false
            assign badge = pack.badge
            assign badge_used = true
          endif
          assign save = 0
          if v.compare_at_price > v.price
            assign save = v.compare_at_price | minus: v.price
          endif
          if support == blank and save > 0 and s.show_savings
            assign save_money = save | money
            assign support = s.savings_label | replace: '{amount}', save_money
          endif
          assign image = v.featured_image | default: product.featured_image
        -%}
        <label class="df-pack-offers__card{% if badge != blank %} df-pack-offers__card--badge{% endif %}">
          <input
            type="radio"
            class="df-pack-offers__radio"
            name="df-pack-{{ block.id }}"
            value="{{ v.id }}"
            data-price="{{ v.price | money | escape }}"
            data-label="{{ label | escape }}"
            {% if v.id == selected.id %}checked{% endif %}
            {% unless v.available %}disabled{% endunless %}
          >
          {%- if badge != blank -%}
            <span class="df-pack-offers__badge">{{ badge | escape }}</span>
          {%- endif -%}
          {%- if image != blank and s.show_image -%}
            <span class="df-pack-offers__media">
              {{ image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '56px', alt: '', loading: 'lazy', class: 'df-pack-offers__img' }}
            </span>
          {%- endif -%}
          <span class="df-pack-offers__body">
            <span class="df-pack-offers__label">{{ label | escape }}</span>
            {%- if v.available == false -%}
              <span class="df-pack-offers__support">Agotado</span>
            {%- elsif support != blank -%}
              <span class="df-pack-offers__support">{{ support | escape }}</span>
            {%- endif -%}
          </span>
          <span class="df-pack-offers__prices">
            <span class="df-pack-offers__price">{{ v.price | money }}</span>
            {%- if save > 0 -%}
              <s class="df-pack-offers__was"><span class="df-visually-hidden">Precio normal </span>{{ v.compare_at_price | money }}</s>
            {%- endif -%}
          </span>
        </label>
      {%- endfor -%}
    </fieldset>
  </df-pack-offers>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-placeholder" {{ block.shopify_attributes }}>
    Packs: aparecen cuando el producto tiene sus packs como variantes (1, 2 y 3 unidades) en una sola opción.
  </div>
{%- endif -%}

{% stylesheet %}
  /* Con packs, la cantidad la elige la tarjeta: el selector de cantidad del tema sobra. */
  .product-details:has(df-pack-offers) .quantity-selector-wrapper {
    display: none;
  }

  .df-pack-offers__set {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* La oferta entre dos líneas: ── 2 por $39.990 · Paga al recibir ── */
  .df-pack-offers__heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--df-fg);
  }

  .df-pack-offers__heading::before,
  .df-pack-offers__heading::after {
    content: '';
    flex: 1 0 24px;
    height: 1px;
    background: var(--df-hairline);
  }

  .df-pack-offers__heading span {
    flex: 0 1 auto;
    text-wrap: balance;
  }

  .df-pack-offers__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 12px 16px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-bg);
    cursor: pointer;
    transition: border-color 120ms var(--df-ease), background-color 120ms var(--df-ease);
  }

  .df-pack-offers__card--badge {
    margin-top: 8px;
  }

  .df-pack-offers__card:hover {
    border-color: color-mix(in srgb, var(--df-fg) 30%, transparent);
  }

  .df-pack-offers__card:has(:checked) {
    border-color: var(--df-accent);
    box-shadow: inset 0 0 0 1px var(--df-accent);
    background: var(--df-accent-soft);
  }

  .df-pack-offers__card:has(:focus-visible) {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  .df-pack-offers__card:has(:disabled) {
    cursor: not-allowed;
    background: var(--df-surface);
    color: var(--df-muted);
  }

  /* El radio real queda accesible y encima de la tarjeta; lo que se ve es la tarjeta. */
  .df-pack-offers__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .df-pack-offers__badge {
    position: absolute;
    top: 0;
    right: 12px;
    transform: translateY(-50%);
    padding: 3px 10px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
    color: var(--df-on-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .df-pack-offers__media {
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  .df-pack-offers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-pack-offers__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .df-pack-offers__label {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .df-pack-offers__support {
    font-size: 13px;
    line-height: 1.35;
    color: var(--df-muted);
  }

  .df-pack-offers__prices {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: right;
  }

  .df-pack-offers__price {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .df-pack-offers__was {
    font-size: 13px;
    color: var(--df-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .df-pack-offers__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Packs",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Una tarjeta por variante (los packs de 1, 2 y 3 unidades). Precios de cada variante; nombres del metafield dropflex.offer o, si falta, el nombre de la variante."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de respaldo",
      "default": "Elige tu pack"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar la foto de cada pack",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Mostrar el ahorro si no hay texto",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Texto del ahorro",
      "info": "{amount} es lo que ahorra frente al precio tachado.",
      "default": "Ahorras {amount}"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Packs"
    }
  ]
}
{% endschema %}
