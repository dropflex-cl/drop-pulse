{%- doc -%}
  DropFlex · Packs (pack-offers). Bloque de la columna del producto, sobre el botón: la oferta en
  una línea y una tarjeta por pack (1, 2 y 3 unidades) con su foto, su nombre, el precio y el
  precio tachado. La tarjeta elegida es la CANTIDAD que se compra.

  REGLA: un pack es la variante de 1 unidad × N, nunca una variante propia. Dropify (Dropi) enlaza
  el producto entero con un solo id y manda la cantidad de la línea: una variante «2 unidades»
  llegaba a Dropi como 1 unidad. El precio del pack lo cobra EasySell con su oferta por cantidad;
  df-pack-offers.js comprueba que cobre lo mismo que dice la tarjeta y esconde la que no.

  Contenido: metafield `dropflex.offer` (json)
    { offer_line?: string, packs: [{ units, label, price, compare_at?, support?, badge? }] }
  price y compare_at en centavos, como los precios de Liquid. Transición: un producto publicado
  antes (packs como variantes de una sola opción, sin price en el metafield) toma el precio de la
  variante del mismo orden.
  Al elegir, deja la variante de 1 unidad en input[name="id"] y la cantidad en
  input[name="quantity"]: EasySell las lee al abrir su formulario y elige su oferta de esa cantidad.
  df-price muestra el pack elegido (evento df:pack).
{%- enddoc -%}
{%- liquid
  # closest.product: el producto de la ficha. Sin ajuste «product» propio: si el bloque tuviera uno
  # vacío, closest.product lo tomaría a él primero y el bloque quedaría sin producto.
  assign product = closest.product | default: product
  assign s = block.settings
  assign offer = product.metafields.dropflex.offer.value
  assign unit = product.variants.first
  assign heading = offer.offer_line | default: s.heading

  assign legacy = false
  if product.options.size == 1 and product.variants.size > 1
    assign legacy = true
  endif

  assign show = false
  if product != blank and unit != blank and offer.packs.size > 1
    assign show = true
  endif
-%}
{%- if show -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'df-pack-offers.js' | asset_url }}" defer></script>
  <df-pack-offers
    class="df df-pack-offers"
    data-product="{{ product.id }}"
    data-variant="{{ unit.id }}"
    data-unit-cents="{{ unit.price }}"
    style="{% render 'df-accent-vars', product: product %} margin-block: {{ s.margin_top }}px {{ s.margin_bottom }}px;"
    {{ block.shopify_attributes }}
  >
    <fieldset class="df-pack-offers__set">
      <legend class="df-visually-hidden">{{ heading | default: 'Elige tu pack' | escape }}</legend>
      {%- if heading != blank -%}
        <p class="df-pack-offers__heading" aria-hidden="true"><span>{{ heading | escape }}</span></p>
      {%- endif -%}
      {%- assign badge_used = false -%}
      {%- assign checked_done = false -%}
      {%- for pack in offer.packs limit: 4 -%}
        {%- liquid
          assign idx = forloop.index0
          assign price = pack.price
          assign was = pack.compare_at
          if price == blank and legacy
            assign price = product.variants[idx].price
            assign was = product.variants[idx].compare_at_price
          endif
          assign valid = true
          if price == blank or pack.units == blank
            assign valid = false
          endif
          if pack.units == 1
            assign fallback_label = '1 unidad'
          else
            assign fallback_label = pack.units | append: ' unidades'
          endif
          assign label = pack.label | default: fallback_label
          assign support = pack.support
          assign badge = blank
          if pack.badge != blank and badge_used == false
            assign badge = pack.badge
            assign badge_used = true
          endif
          assign save = 0
          assign percent = 0
          if was > price
            assign save = was | minus: price
            assign percent = save | times: 100.0 | divided_by: was | round
          endif
          if support == blank and save > 0 and s.show_savings
            assign save_money = save | money
            assign support = s.savings_label | replace: '{amount}', save_money
          endif
        -%}
        {%- if valid -%}
        <label class="df-pack-offers__card{% if badge != blank %} df-pack-offers__card--badge{% endif %}">
          <input
            type="radio"
            class="df-pack-offers__radio"
            name="df-pack-{{ block.id }}"
            value="{{ pack.units }}"
            data-cents="{{ price }}"
            data-price="{{ price | money | escape }}"
            data-was="{% if save > 0 %}{{ was | money | escape }}{% endif %}"
            data-save="{% if save > 0 %}{{ save | money | escape }}{% endif %}"
            data-pc="{{ percent }}"
            data-label="{{ label | escape }}"
            {% unless checked_done %}checked{% endunless %}
            {% unless unit.available %}disabled{% endunless %}
          >
          {%- assign checked_done = true -%}
          {%- if badge != blank -%}
            <span class="df-pack-offers__badge">{{ badge | escape }}</span>
          {%- endif -%}
          {%- if product.featured_image != blank and s.show_image -%}
            <span class="df-pack-offers__media">
              {{ product.featured_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '56px', alt: '', loading: 'lazy', class: 'df-pack-offers__img' }}
            </span>
          {%- endif -%}
          <span class="df-pack-offers__body">
            <span class="df-pack-offers__label">{{ label | escape }}</span>
            {%- if unit.available == false -%}
              <span class="df-pack-offers__support">Agotado</span>
            {%- elsif support != blank -%}
              <span class="df-pack-offers__support">{{ support | escape }}</span>
            {%- endif -%}
          </span>
          <span class="df-pack-offers__prices">
            <span class="df-pack-offers__price">{{ price | money }}</span>
            {%- if save > 0 -%}
              <s class="df-pack-offers__was"><span class="df-visually-hidden">Precio normal </span>{{ was | money }}</s>
            {%- endif -%}
          </span>
        </label>
        {%- endif -%}
      {%- endfor -%}
    </fieldset>
    {%- comment -%} Solo en el editor de temas: por qué un pack (o el bloque) no se muestra. {%- endcomment -%}
    <div class="df-pack-offers__notice" role="note" data-df-notice hidden></div>
  </df-pack-offers>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-placeholder" {{ block.shopify_attributes }}>
    Packs: aparecen cuando DropFlex publica el producto con sus packs (1, 2 y 3 unidades).
  </div>
{%- endif -%}

{% stylesheet %}
  /* Con packs, la cantidad la elige la tarjeta: el selector de cantidad del tema sobra. */
  .product-details:has(df-pack-offers) .quantity-selector-wrapper {
    display: none;
  }

  .df-pack-offers[hidden],
  .df-pack-offers__set[hidden],
  .df-pack-offers__card[hidden],
  .df-pack-offers__notice[hidden] {
    display: none;
  }

  .df-pack-offers__notice {
    margin-top: 10px;
    padding: 10px 12px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-surface);
    color: var(--df-fg);
    font-size: 13px;
    line-height: 1.4;
  }

  .df-pack-offers__notice ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  .df-pack-offers__set {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* La oferta entre dos líneas: ── 2 por $39.990 · Paga al recibir ── */
  .df-pack-offers__heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--df-fg);
  }

  .df-pack-offers__heading::before,
  .df-pack-offers__heading::after {
    content: '';
    flex: 1 0 24px;
    height: 1px;
    background: var(--df-hairline);
  }

  .df-pack-offers__heading span {
    flex: 0 1 auto;
    text-wrap: balance;
  }

  .df-pack-offers__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 12px 16px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-bg);
    cursor: pointer;
    transition: border-color 120ms var(--df-ease), background-color 120ms var(--df-ease);
  }

  .df-pack-offers__card--badge {
    margin-top: 8px;
  }

  .df-pack-offers__card:hover {
    border-color: color-mix(in srgb, var(--df-fg) 30%, transparent);
  }

  .df-pack-offers__card:has(:checked) {
    border-color: var(--df-accent);
    box-shadow: inset 0 0 0 1px var(--df-accent);
    background: var(--df-accent-soft);
  }

  .df-pack-offers__card:has(:focus-visible) {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  .df-pack-offers__card:has(:disabled) {
    cursor: not-allowed;
    background: var(--df-surface);
    color: var(--df-muted);
  }

  /* El radio real queda accesible y encima de la tarjeta; lo que se ve es la tarjeta. */
  .df-pack-offers__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .df-pack-offers__badge {
    position: absolute;
    top: 0;
    right: 12px;
    transform: translateY(-50%);
    padding: 3px 10px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
    color: var(--df-on-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .df-pack-offers__media {
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  .df-pack-offers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-pack-offers__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .df-pack-offers__label {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .df-pack-offers__support {
    font-size: 13px;
    line-height: 1.35;
    color: var(--df-muted);
  }

  .df-pack-offers__prices {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: right;
  }

  .df-pack-offers__price {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .df-pack-offers__was {
    font-size: 13px;
    color: var(--df-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .df-pack-offers__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Packs",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Una tarjeta por pack (1, 2 y 3 unidades) del metafield dropflex.offer. Cada pack es la variante de 1 unidad × N y lo cobra la oferta por cantidad de EasySell: crea una opción por pack, con el mismo precio y sin preseleccionar. Un pack que EasySell no cobra igual no se muestra."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de respaldo",
      "default": "Elige tu pack"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar la foto de cada pack",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Mostrar el ahorro si no hay texto",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Texto del ahorro",
      "info": "{amount} es lo que ahorra frente al precio tachado.",
      "default": "Ahorras {amount}"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Packs"
    }
  ]
}
{% endschema %}
