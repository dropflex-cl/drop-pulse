{%- comment -%} Respeta la sección habilitada y la variante de la página. {%- endcomment -%}
<div data-df-pdp-component="shipping-timeline">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.shipping_timeline.value -%}
<script src="{{ 'df-shipping-timeline.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-shipping-timeline">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'shipping-timeline', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'shipping-timeline', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_variants %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'shipping-timeline', product: df_product %}{% endif %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-shipping-timeline {
    --df-st-scene: var(--df-accent-soft);
    --df-st-track: color-mix(in srgb, var(--df-accent) 24%, var(--df-bg));
    --df-st-duration: calc(var(--df-dur-reveal) * 5 + var(--df-dur-base));
    display: grid;
    gap: var(--df-gap);
    min-width: 0;
  }
  .df-shipping-timeline [hidden] { display: none; }
  .df-shipping-timeline__countdown[data-pending] { display: none; }
  .df-shipping-timeline p { margin: 0; }
  .df-shipping-timeline__eyebrow {
    display: flex; align-items: center; gap: calc(var(--df-gap) / 2);
    font-size: .875rem; line-height: 1.4; color: var(--df-muted);
  }
  .df-shipping-timeline__eyebrow .df-icon { width: 18px; height: 18px; color: var(--df-accent-ink); }
  .df-shipping-timeline__countdown { display: grid; gap: calc(var(--df-gap) / 2); }
  .df-shipping-timeline__clock { display: flex; align-items: baseline; gap: calc(var(--df-gap) / 2); }
  .df-shipping-timeline__unit { display: inline-flex; align-items: baseline; gap: calc(var(--df-gap) / 3); }
  .df-shipping-timeline__unit strong { font-size: 2.5rem; line-height: 1.1; font-weight: 700; letter-spacing: -.025em; font-variant-numeric: tabular-nums; color: var(--df-accent-ink); }
  .df-shipping-timeline__unit > span { font-size: .875rem; color: var(--df-muted); }
  .df-shipping-timeline__colon { font-size: 1.75rem; color: var(--df-st-track); }
  .df-shipping-timeline__cutoff { font-size: .875rem; line-height: 1.4; color: var(--df-muted); }
  .df-shipping-timeline__scene { padding: var(--df-gap); border-radius: var(--df-radius-lg); background: var(--df-st-scene); }
  .df-shipping-timeline__scene-head { display: flex; justify-content: space-between; align-items: center; gap: var(--df-gap); }
  .df-shipping-timeline__arrival { min-width: 0; }
  .df-shipping-timeline__headline { margin: calc(var(--df-gap) / 3) 0 0; font-family: var(--df-font-heading); font-size: 1.5rem; font-weight: var(--df-font-heading-weight); line-height: 1.15; letter-spacing: -.02em; overflow-wrap: anywhere; color: var(--df-fg); }
  .df-shipping-timeline__calendar { flex: none; display: grid; width: 80px; background: var(--df-bg); color: var(--df-fg); border-radius: var(--df-radius-sm); overflow: hidden; text-align: center; }
  .df-shipping-timeline__calendar-top { padding: calc(var(--df-gap) / 3); background: var(--df-accent); color: var(--df-on-accent); font-size: .75rem; line-height: 1.4; font-weight: 700; text-transform: uppercase; }
  .df-shipping-timeline__calendar strong { padding-top: calc(var(--df-gap) / 3); font-size: 2.5rem; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .df-shipping-timeline__calendar-month { padding-bottom: calc(var(--df-gap) / 2); font-size: .75rem; line-height: 1.4; text-transform: uppercase; color: var(--df-muted); }
  .df-shipping-timeline__route { position: relative; height: 72px; margin-top: var(--df-gap); animation-duration: var(--df-st-duration); transition-timing-function: var(--df-ease-standard); }
  .df-shipping-timeline__rail { position: absolute; inset-inline: 8px 24px; top: 48px; height: 3px; background: var(--df-st-track); border-radius: var(--df-radius-pill); }
  .df-shipping-timeline__rail-fill { position: absolute; inset: 0; border-radius: inherit; background: var(--df-accent); transform-origin: left center; }
  .df-shipping-timeline__truck { position: absolute; inset-inline-start: 0; top: 16px; display: grid; place-items: center; width: 44px; height: 36px; color: var(--df-accent-ink); background: var(--df-st-scene); translate: var(--df-st-travel, 0px) 0; }
  .df-shipping-timeline__truck .df-icon, .df-shipping-timeline__home .df-icon, .df-shipping-timeline__img { width: 36px; height: 36px; object-fit: contain; }
  .df-shipping-timeline__home { position: absolute; inset-inline-end: 0; top: 8px; color: var(--df-accent-ink); background: var(--df-st-scene); }
  .df-shipping-timeline__check { position: absolute; inset-inline-end: 7px; bottom: 0; display: grid; place-items: center; width: 22px; height: 22px; border-radius: var(--df-radius-pill); background: var(--df-accent); color: var(--df-on-accent); }
  .df-shipping-timeline__check .df-icon { width: 14px; height: 14px; }
  .df-shipping-timeline__dispatch { font-size: .75rem; line-height: 1.4; color: var(--df-muted); }
  .df-shipping-timeline__destinations { display: grid; gap: calc(var(--df-gap) / 3); margin-top: var(--df-gap); }
  .df-shipping-timeline__destination { font-size: .875rem; line-height: 1.4; color: var(--df-fg); }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Envío",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Las fechas se calculan con la logística real de la tienda (plazos, hora de corte, feriados). Los textos vienen del metafield dropflex.shipping_timeline; estos son el respaldo."
    },
    {
      "type": "header",
      "content": "Textos"
