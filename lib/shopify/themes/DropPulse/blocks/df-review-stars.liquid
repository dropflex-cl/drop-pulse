<div data-df-pdp-component="review-stars">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.review_stars.value -%}
<script src="{{ 'df-review-stars.js' | asset_url }}" defer></script>
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-review-stars">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% if df_default.content.state == 'empty' %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% else %}{% render 'df-review-stars-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% if df_variant.content.state == 'empty' %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% else %}{% render 'df-review-stars-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% if df_variants.state == 'empty' %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% else %}{% render 'df-review-stars-content', product: df_product, section: section, block: block, content: df_variants %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'review-stars', product: df_product %}{% endif %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-review-stars {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .df-review-stars--center { align-items: center; text-align: center; }
  .df-review-stars--right { align-items: flex-end; text-align: right; }
  .df-review-stars--left { align-items: flex-start; }

  .df-review-stars__row {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    min-height: 44px;
    color: var(--df-fg);
    font-size: var(--df-review-stars-text, 14px);
    line-height: 1.2;
    text-decoration: none;
  }

  a.df-review-stars__row:hover .df-review-stars__label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a.df-review-stars__row:focus-visible {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
    border-radius: var(--df-radius-sm);
  }

  .df-review-stars__stars {
    display: inline-flex;
    line-height: 0;
  }

  .df-review-stars__label {
    font-weight: 500;
  }

  /* Fila compacta: mantiene size-touch (44 px), sin el argumento largo de prueba social. */
  .df-review-stars--compact .df-review-stars__row { flex-wrap: nowrap; max-width: 100%; }
  .df-review-stars--compact .df-review-stars__stars { flex: none; }
  .df-review-stars--compact .df-review-stars__label { font-size: 12px; line-height: 16px; }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Estrellas",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "La calificación y la cantidad salen de las reseñas aprobadas en DropFlex. No se pueden escribir a mano."
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Mostrar resumen compacto",
      "info": "Una fila de estrellas, calificación y cantidad. Conserva los textos guardados para la vista completa.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Mostrar texto",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto junto a las estrellas",
      "info": "Respaldo de dropflex.review_stars. Los tokens {count} y {rating} son opcionales.",
      "default": "{rating} · {count} reseñas"
    },
    {
      "type": "header",
      "content": "Reglas"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla de las reseñas",
      "info": "Id del bloque de reseñas al que lleva el clic (sin #). Vacío: no es enlace.",
      "default": "resenas"
    },
    {
      "type": "range",
      "id": "scroll_offset",
      "label": "Compensar encabezado",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Tamaño de estrellas",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "info": "Negativo acerca las estrellas al título (van con él, no con el bloque de arriba).",
      "min": -16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Estrellas"
    }
  ]
}
{% endschema %}
