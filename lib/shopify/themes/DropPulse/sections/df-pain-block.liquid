{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.pain_block.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-pain-block">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-pain-block-content', product: df_product, section: section, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-pain-block-content', product: df_product, section: section, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-pain-block-content', product: df_product, section: section, content: df_variants %}
{%- endif -%}

{% stylesheet %}
  .df-pain-block {
    padding-block: calc(var(--df-pain-pt, 48px) * var(--df-space, 1)) calc(var(--df-pain-pb, 48px) * var(--df-space, 1));
    background: var(--df-pain-bg, transparent);
  }

  .df-pain-block__inner {
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--df-gutter);
  }

  .df-pain-block__heading {
    max-width: 36rem;
    margin: 0 auto var(--df-title-gap);
    font-size: min(var(--df-title-size), var(--df-pain-heading, 36px));
    text-align: center;
  }

  .df-pain-block__hl {
    color: var(--df-accent-ink);
  }

  /* Móvil: una lista vertical; cada momento con una marca del acento a la izquierda. */
  .df-pain-block__list {
    display: grid;
    gap: 12px;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .df-pain-block__item {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 20px 18px 16px;
    border-radius: var(--df-radius);
    background: var(--df-surface);
  }

  .df-pain-block__marker {
    display: block;
    width: 4px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
  }

  .df-pain-block__title {
    margin: 0 0 6px;
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.0625rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .df-pain-block__text {
    font-size: 0.9375rem;
  }

  .df-pain-block__text strong,
  .df-pain-block__bridge strong {
    color: var(--df-fg);
    font-weight: 600;
  }

  /* El remate: centrado, más grande, entre dos filetes; es el paso del dolor al producto. */
  .df-pain-block__bridge {
    max-width: 36rem;
    margin: calc(40px * var(--df-space, 1)) auto 0;
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.1875rem;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }

  .df-pain-block__bridge::before {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    margin: 0 auto 16px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
  }

  /* Revelado del remate (df-motion.js): el filete se dibuja desde el centro y después aparece el
     texto; con opacidad el filete se vería recién al final, por eso el texto va con color. */
  .df-pain-block__bridge.df-reveal-pending,
  .df-pain-block__bridge.df-reveal-pending strong {
    opacity: 1;
    translate: none;
    color: transparent;
  }

  .df-pain-block__bridge.df-reveal-pending::before {
    scale: 0 1;
  }

  .df-pain-block__bridge.df-reveal-run,
  .df-pain-block__bridge.df-reveal-run strong {
    transition: color var(--df-dur-slow) var(--df-ease-standard) 250ms;
  }

  .df-pain-block__bridge.df-reveal-run::before {
    transition: scale 400ms var(--df-ease-enter);
  }

  /* Escritorio, diseño en tarjetas: 3 columnas con la marca arriba. */
  @media (min-width: 990px) {
    .df-pain-block--cards .df-pain-block__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      max-width: none;
    }

    .df-pain-block--cards .df-pain-block__item {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 14px;
      padding: 24px;
    }

    .df-pain-block--cards .df-pain-block__marker {
      width: 32px;
      height: 4px;
    }

    .df-pain-block__title {
      font-size: 1.1875rem;
    }

    .df-pain-block__text {
      font-size: 1rem;
    }

    .df-pain-block__bridge {
      font-size: 1.375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Lo que te pasa",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.pain_block; el título, el remate y los bloques son el respaldo. Usa 3 momentos."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Una pregunta de reconocimiento. Encierra una palabra entre ** para destacarla.",
      "default": "¿Te pasa esto?"
    },
    {
      "type": "textarea",
      "id": "bridge",
      "label": "Remate",
      "info": "Una frase que lleva de lo que le pasa al cliente a lo que hace distinto al producto."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Momentos en escritorio",
      "options": [
        { "value": "cards", "label": "Tres tarjetas" },
        { "value": "list", "label": "Lista" }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "info": "Vacío: el fondo de la página."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "info": "Vacío: el color de texto del tema."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Momento",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "La escena en pocas palabras.",
          "default": "Un momento concreto"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "info": "1 o 2 oraciones en primera o tercera persona, con las palabras de tu cliente.",
          "default": "Cuenta lo que le pasa a tu cliente en ese momento, con sus palabras y sin diagnosticarlo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Lo que te pasa",
      "blocks": [
        { "type": "moment", "settings": { "title": "El primer momento", "text": "Cuenta la escena en la que tu cliente nota el problema, con sus palabras." } },
        { "type": "moment", "settings": { "title": "El segundo momento", "text": "Otra escena distinta: lo que ya probó y por qué no le funcionó." } },
        { "type": "moment", "settings": { "title": "El tercer momento", "text": "Una tercera escena, en primera o tercera persona, sin diagnosticar." } }
      ]
    }
  ]
}
{% endschema %}
