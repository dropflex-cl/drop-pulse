    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Cifra 2"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Texto de la cifra 2"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Cifra 3"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Texto de la cifra 3"
    },
    {
      "type": "header",
      "content": "Botón"
