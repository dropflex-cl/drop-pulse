<div data-df-pdp-component="stats-with-image">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.stats_with_image.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
<script src="{{ 'df-stats-with-image.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-stats-with-image">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-stats-with-image-content', product: df_product, section: section, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-stats-with-image-content', product: df_product, section: section, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-stats-with-image-content', product: df_product, section: section, content: df_variants %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-stats-with-image {
    padding-block: calc(var(--df-swi-pt, 48px) * var(--df-space, 1)) calc(var(--df-swi-pb, 48px) * var(--df-space, 1));
  }

  .df-stats-with-image__card {
    display: grid;
    max-width: var(--df-container);
    margin-inline: auto;
    background: var(--df-swi-bg, var(--df-surface));
  }

  .df-stats-with-image__collage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 16px 16px 0;
  }

  .df-stats-with-image--media-last .df-stats-with-image__collage {
    order: 2;
    padding: 0 16px 24px;
  }

  .df-stats-with-image__photo {
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-hairline);
    aspect-ratio: 1;
  }

  .df-stats-with-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-stats-with-image__collage--1 {
    grid-template-columns: minmax(0, 1fr);
  }

  .df-stats-with-image__collage--2 .df-stats-with-image__photo {
    aspect-ratio: 3 / 4;
  }

  /* Tres fotos: la primera en vertical a la izquierda, dos cuadradas apiladas a la derecha. */
  .df-stats-with-image__collage--3 {
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .df-stats-with-image__collage--3 .df-stats-with-image__photo:first-child {
    grid-row: 1 / span 2;
    aspect-ratio: auto;
  }

  .df-stats-with-image__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 24px 16px 32px;
  }

  .df-stats-with-image__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .df-stats-with-image__rating-text {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }


  .df-stats-with-image__heading {
    font-size: var(--df-title-size);
  }

  .df-stats-with-image__hl {
    color: var(--df-accent-ink);
  }

  .df-stats-with-image__description {
    font-size: 0.9375rem;
  }

  .df-stats-with-image__description strong {
    color: var(--df-fg);
  }

  .df-stats-with-image__bullets,
  .df-stats-with-image__stats {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-stats-with-image__bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .df-stats-with-image__bullet .df-icon {
    margin-top: 0.05em;
    color: var(--df-accent-ink);
  }

  .df-stats-with-image__stats {
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 12px;
    width: 100%;
    padding-block: 4px;
  }

  .df-stats-with-image__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-inline-start: 12px;
    border-inline-start: 2px solid var(--df-accent);
  }

  .df-stats-with-image__stat-value {
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.5rem;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .df-stats-with-image__stat-label {
    color: var(--df-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .df-stats-with-image__review {
    display: flex;
    gap: 12px;
    width: 100%;
    max-width: 600px;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius-sm);
    background: var(--df-bg);
  }

  .df-stats-with-image__avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--df-accent-soft);
    color: var(--df-accent-ink);
    font-weight: 600;
  }

  .df-stats-with-image__review-body {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .df-stats-with-image__quote {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .df-stats-with-image__quote p {
    margin: 0;
  }

  .df-stats-with-image__review-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 0.8125rem;
  }

  .df-stats-with-image__author {
    font-weight: 600;
  }


  .df-stats-with-image__cta-wrap {
    display: block;
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
  }

  .df-stats-with-image__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: var(--df-radius-sm);
    background: var(--df-accent);
    color: var(--df-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--df-ease),
      scale var(--df-dur-fast) var(--df-ease-standard);
  }

  .df-stats-with-image__cta svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s var(--df-ease);
  }

  .df-stats-with-image__cta:hover svg {
    transform: translateX(4px);
  }

  .df-stats-with-image__cta:focus-visible {
    outline: 2px solid var(--df-accent-ink);
    outline-offset: 3px;
  }

  @media (min-width: 990px) {
    .df-stats-with-image {
      padding-inline: var(--df-gutter);
    }

    .df-stats-with-image__card {
      border-radius: var(--df-swi-radius, 14px);
      overflow: hidden;
    }

    .df-stats-with-image--media .df-stats-with-image__card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .df-stats-with-image__collage,
    .df-stats-with-image--media-last .df-stats-with-image__collage {
      order: 0;
      gap: 14px;
      padding: 40px;
    }

    .df-stats-with-image--reverse .df-stats-with-image__collage {
      order: 2;
    }

    .df-stats-with-image__collage--3 {
      aspect-ratio: 1;
    }

    .df-stats-with-image__collage--3 .df-stats-with-image__photo {
      aspect-ratio: auto;
    }

    .df-stats-with-image__body {
      gap: 18px;
      padding: 40px;
    }

    .df-stats-with-image__description {
      font-size: 1.0625rem;
    }

    .df-stats-with-image__bullet {
      font-size: 1rem;
    }

    .df-stats-with-image__cta-wrap {
      width: auto;
      margin-inline: 0;
    }

    .df-stats-with-image__cta {
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Hero y cifras",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.stats_with_image; estos son el respaldo. La calificación, el testimonio y las cifras salen de datos reales."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "header",
      "content": "Fotos"
    },
    {
      "type": "paragraph",
      "content": "Sin fotos aquí se usan las del metafield dropflex.stats_with_image_images y, si no, las del producto."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Foto 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foto 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Foto 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Foto 4"
    },
    {
      "type": "range",
      "id": "max_images",
      "label": "Fotos del producto",
      "info": "Cuántas usar cuando vienen del producto.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Fotos en escritorio",
      "options": [
        { "value": "left", "label": "A la izquierda" },
        { "value": "right", "label": "A la derecha" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Fotos arriba en móvil",
      "default": true
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar calificación",
      "info": "Solo aparece con reseñas reales suficientes.",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_label",
