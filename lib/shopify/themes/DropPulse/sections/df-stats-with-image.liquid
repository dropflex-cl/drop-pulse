    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "info": "Una o dos oraciones. Puedes marcar una frase con **…**."
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Razón 1",
      "default": "Diseño que se adapta a ti"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Razón 2",
      "default": "Materiales para uso diario"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Razón 3",
      "default": "Pagas al recibirlo"
    },
    {
      "type": "text",
      "id": "bullet_4",
      "label": "Razón 4"
    },
    {
      "type": "header",
      "content": "Testimonio"
    },
    {
      "type": "checkbox",
      "id": "show_testimonial",
      "label": "Mostrar testimonio",
