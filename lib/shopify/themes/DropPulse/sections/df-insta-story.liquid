{%- comment -%}
  DropFlex · Historias (insta-story). Sección de la landing: una fila de círculos al estilo de
  Instagram que abre un visor de historias a pantalla completa en un <dialog> nativo.

  REGLA: los medios son SIEMPRE archivos reales subidos (del comerciante o del proveedor). La IA
  solo escribe los textos, alineados por índice con los medios. Una imagen generada con IA de una
  persona nunca se presenta como cliente o experto. El texto va en HTML sobre el medio (nunca
  horneado en la imagen): se lee, se traduce y se edita.

  Medios: metafield `dropflex.insta_story_media` (list.file_reference: imágenes y videos) → si
  falta, los bloques «Historia» (imagen o video).
  Textos: metafield `dropflex.insta_story` (json) → si falta, los textos de cada bloque.
    { heading?, stories[{ title, caption_line_1, caption_line_2?, cta_label? }] }  (stories[i] ↔ medio i)

  Visor: barras segmentadas, toque izquierda/derecha, mantener para pausar, deslizar hacia abajo
  o Esc para cerrar, flechas del teclado, avance automático (imágenes: duración del ajuste;
  videos: su duración). Los videos se crean al abrir su historia (preload="none", con póster).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = s.product
  endif
  assign content = product.metafields.dropflex.insta_story.value
  assign media_list = product.metafields.dropflex.insta_story_media.value

  assign from_metafield = false
  assign total = section.blocks.size
  if media_list.size > 0
    assign from_metafield = true
    assign total = media_list.size
  endif
  assign total = total | at_most: 12
  assign last = total | minus: 1

  assign heading = content.heading | default: s.heading

  # Destino del botón: el enlace del bloque, o un #ancla de esta página, o la página del producto.
  assign default_href = product.url
  assign anchor_first = s.cta_anchor | slice: 0
  if anchor_first == '#'
    assign default_href = s.cta_anchor
  endif

  assign thumb_loading = 'lazy'
  if section.index != blank and section.index <= 2
    assign thumb_loading = 'eager'
  endif
  assign thumb_sizes = s.circle_size | append: 'px'

  assign bg = s.background
  assign bg_hex = nil
  assign dark_bg = false
  if bg != blank and bg.alpha != 0
    assign bg_hex = bg | color_to_hex
    assign bg_brightness = bg | color_brightness
    if bg_brightness < 128
      assign dark_bg = true
    endif
  endif

  assign count = 0
  assign circles_html = ''
  assign bars_html = ''
  assign slides_html = ''
-%}

{%- if total > 0 -%}
  {%- for i in (0..last) -%}
    {%- liquid
      assign blk = section.blocks[i]
      if from_metafield
        assign m = media_list[i]
        assign thumb = nil
        assign link = nil
        assign blk_attrs = ''
      else
        assign m = blk.settings.video | default: blk.settings.image
        assign thumb = blk.settings.thumbnail
        assign link = blk.settings.link
        assign blk_attrs = blk.shopify_attributes
      endif
      unless m.media_type == 'image' or m.media_type == 'video'
        continue
      endunless

      # Textos: la historia i del metafield; si no existe, los del bloque i.
      assign story = content.stories[i]
      if story != blank
        assign title = story.title
        assign line_1 = story.caption_line_1
        assign line_2 = story.caption_line_2
        assign cta_label = story.cta_label
      else
        assign title = blk.settings.title
        assign line_1 = blk.settings.caption_line_1
        assign line_2 = blk.settings.caption_line_2
        assign cta_label = blk.settings.cta_label
      endif

      assign count = count | plus: 1
      assign idx = count | minus: 1
      if title == blank
        assign title = 'Historia ' | append: count
      endif
      if thumb == blank
        if m.media_type == 'video'
          assign thumb = m.preview_image
        else
          assign thumb = m
        endif
      endif
      assign href = link | default: default_href
      assign alt_text = title
      if line_1 != blank
        assign alt_text = alt_text | append: '. ' | append: line_1
      endif
    -%}

    {%- capture circle -%}
      <li class="df-insta-story__item" data-df-story="{{ idx }}" {{ blk_attrs }}>
        <button type="button" class="df-insta-story__circle" data-df-open="{{ idx }}" aria-haspopup="dialog">
          <span class="df-insta-story__ring">
            {%- if thumb != blank -%}
              {{
                thumb
                | image_url: width: 240, height: 240, crop: 'center'
                | image_tag: widths: '80, 160, 240', sizes: thumb_sizes, alt: '', loading: thumb_loading, class: 'df-insta-story__thumb'
              }}
            {%- else -%}
              <span class="df-insta-story__thumb df-insta-story__thumb--empty"></span>
            {%- endif -%}
          </span>
          <span class="df-insta-story__label">{{ title | escape }}</span>
        </button>
      </li>
    {%- endcapture -%}

    {%- capture bar -%}
      <span class="df-insta-story__bar"><span class="df-insta-story__fill" data-df-fill></span></span>
    {%- endcapture -%}

    {%- capture slide -%}
      <li class="df-insta-story__slide" data-df-slide data-type="{{ m.media_type }}" data-label="{{ title | escape }}" hidden>
        {%- if m.media_type == 'video' -%}
          <template data-df-video>
            {{- m | video_tag: class: 'df-insta-story__media', preload: 'none', playsinline: true, muted: true, image_size: '1080x' -}}
          </template>
        {%- else -%}
          {{
            m
            | image_url: width: 1080
            | image_tag:
              widths: '540, 720, 1080',
              sizes: '(min-width: 750px) 52vh, 100vw',
              alt: alt_text,
              loading: 'lazy',
              class: 'df-insta-story__media'
          }}
        {%- endif -%}
        {%- if line_1 != blank or line_2 != blank or cta_label != blank -%}
          <div class="df-insta-story__caption">
            {%- if line_1 != blank -%}
              <p class="df-insta-story__line-1">{{ line_1 | escape }}</p>
            {%- endif -%}
            {%- if line_2 != blank -%}
              <p class="df-insta-story__line-2"><span>{{ line_2 | escape }}</span></p>
            {%- endif -%}
            {%- if cta_label != blank and href != blank -%}
              <a class="df-insta-story__cta" href="{{ href | escape }}" data-df-cta>{{ cta_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </li>
    {%- endcapture -%}

    {%- liquid
      assign circles_html = circles_html | append: circle
      assign bars_html = bars_html | append: bar
      assign slides_html = slides_html | append: slide
    -%}
  {%- endfor -%}
{%- endif -%}

{%- if count > 0 or request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'df-insta-story.js' | asset_url }}" defer></script>

  <df-insta-story
    class="df df-insta-story df-insta-story--ring-{{ s.ring_style }}{% if s.card %} df-insta-story--card{% endif %}"
    style="{% render 'df-accent-vars', product: product, background: bg_hex %} padding-block: calc({{ s.padding_top }}px * var(--df-space, 1)) calc({{ s.padding_bottom }}px * var(--df-space, 1)); --df-story-size: {{ s.circle_size }}px;{% if bg_hex != blank %} --df-bg: {{ bg_hex }}; background: {{ bg_hex }};{% endif %}{% if dark_bg %} --df-fg: #ffffff;{% endif %}"
    data-duration="{{ s.duration | times: 1000 }}"
    data-start-muted="{{ s.start_muted }}"
    data-close-at-end="{{ s.close_at_end }}"
  >
    <div class="df-insta-story__inner">
      {%- if count == 0 -%}
        <p class="df-placeholder">
          Historias: agrega bloques con una imagen o un video vertical (9:16), o sube los medios desde DropFlex. Sin medios no se muestra en la tienda.
        </p>
      {%- else -%}
        {%- if heading != blank or s.subheading != blank -%}
          <div class="df-insta-story__header">
            {%- if heading != blank -%}
              <h2 class="df-heading df-insta-story__heading">{{ heading | escape }}</h2>
            {%- endif -%}
            {%- if s.subheading != blank -%}
              <p class="df-text df-insta-story__subheading">{{ s.subheading | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <ul class="df-insta-story__row" role="list">
          {{ circles_html }}
        </ul>

        <dialog class="df-insta-story__viewer" aria-label="{{ heading | default: 'Historias' | escape }}">
          <div class="df-insta-story__stage" data-df-stage>
            <div class="df-insta-story__bars" aria-hidden="true">{{ bars_html }}</div>

            <ol class="df-insta-story__slides">
              {{ slides_html }}
            </ol>

            <p class="df-visually-hidden" data-df-status aria-live="polite"></p>

            <div class="df-insta-story__controls">
              <button type="button" class="df-insta-story__control" data-df-pause aria-pressed="false" aria-label="Pausar">
                {% render 'df-icon', name: 'pause', class: 'df-insta-story__icon-pause' %}
                {% render 'df-icon', name: 'play', class: 'df-insta-story__icon-play' %}
              </button>
              <button type="button" class="df-insta-story__control" data-df-mute aria-pressed="true" aria-label="Silenciar" hidden>
                {% render 'df-icon', name: 'volume', class: 'df-insta-story__icon-sound' %}
                {% render 'df-icon', name: 'volume-off', class: 'df-insta-story__icon-muted' %}
              </button>
              <button type="button" class="df-insta-story__control" data-df-close aria-label="Cerrar" autofocus>
                {% render 'df-icon', name: 'x' %}
              </button>
            </div>

            {%- if count > 1 -%}
              <button type="button" class="df-insta-story__nav df-insta-story__nav--prev" data-df-prev aria-label="Historia anterior">
                {% render 'df-icon', name: 'chevron-left' %}
              </button>
              <button type="button" class="df-insta-story__nav df-insta-story__nav--next" data-df-next aria-label="Historia siguiente">
                {% render 'df-icon', name: 'chevron-right' %}
              </button>
            {%- endif -%}
          </div>
        </dialog>
      {%- endif -%}
    </div>
  </df-insta-story>

{%- endif -%}

{% stylesheet %}
  df-insta-story {
    display: block;
  }

  .df-insta-story {
    --df-story-size: 80px;
    --df-story-ring: linear-gradient(210deg, var(--df-accent), color-mix(in srgb, var(--df-accent) 35%, var(--df-star)));
    /* El visor es un lienzo oscuro sobre fotos y videos (como Instagram): blanco y negro fijos
       a propósito, no colores de marca. */
    --df-story-ink: #ffffff;
    --df-story-canvas: #000000;
    --df-story-scrim: rgb(0 0 0 / 0.88);
  }

  .df-insta-story--ring-solid {
    --df-story-ring: var(--df-accent);
  }

  .df-insta-story--ring-none {
    --df-story-ring: transparent;
  }

  .df-insta-story__inner {
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
  }

  .df-insta-story--card .df-insta-story__inner {
    width: calc(100% - var(--df-gutter) * 2);
    max-width: var(--df-container);
    margin-inline: auto;
    padding-block: 24px;
    border-radius: var(--df-radius-lg);
    background: var(--df-surface);
  }

  .df-insta-story__header {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
    padding-inline: var(--df-gutter);
    text-align: center;
  }

  .df-insta-story__heading {
    font-size: var(--df-title-size);
  }

  .df-insta-story__row {
    display: flex;
    justify-content: safe center;
    gap: 16px;
    margin: 0;
    padding: 4px 16px 8px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .df-insta-story__row::-webkit-scrollbar {
    display: none;
  }

  .df-insta-story__item {
    flex: none;
    scroll-snap-align: start;
  }

  .df-insta-story__circle {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: calc(var(--df-story-size) + 8px);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .df-insta-story__ring {
    display: block;
    width: var(--df-story-size);
    height: var(--df-story-size);
    padding: 3px;
    border-radius: 50%;
    background: var(--df-story-ring);
    transition: transform 0.2s var(--df-ease);
  }

  .df-insta-story__circle:hover .df-insta-story__ring {
    transform: scale(1.04);
  }

  .df-insta-story__circle:focus-visible {
    outline: none;
  }

  .df-insta-story__circle:focus-visible .df-insta-story__ring {
    outline: 2px solid var(--df-fg);
    outline-offset: 3px;
  }

  .df-insta-story__item.is-seen .df-insta-story__ring {
    background: color-mix(in srgb, var(--df-fg) 18%, transparent);
  }

  .df-insta-story--ring-none .df-insta-story__item.is-seen .df-insta-story__ring {
    background: transparent;
  }

  .df-insta-story__thumb {
    display: block;
    width: 100%;
    height: 100%;
    border: 3px solid var(--df-bg);
    border-radius: 50%;
    object-fit: cover;
    background: var(--df-surface);
  }

  .df-insta-story--card .df-insta-story__thumb {
    border-color: var(--df-surface);
  }

  .df-insta-story__label {
    display: -webkit-box;
    max-width: 100%;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    color: var(--df-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Visor */
  .df-insta-story__viewer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--df-story-ink);
    overflow: hidden;
  }

  .df-insta-story__viewer[open] {
    display: grid;
    place-items: center;
  }

  .df-insta-story__viewer::backdrop {
    background: var(--df-story-scrim);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .df-insta-story__stage {
    position: relative;
    width: 100%;
    height: 100%;
    margin-inline: auto;
    overflow: hidden;
    background: var(--df-story-canvas);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .df-insta-story__slides {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-insta-story__slide {
    position: relative;
    height: 100%;
  }

  .df-insta-story__slide[hidden] {
    display: none;
  }

  .df-insta-story__slide::before,
  .df-insta-story__slide::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    pointer-events: none;
  }

  .df-insta-story__slide::before {
    top: 0;
    height: 120px;
    background: linear-gradient(rgb(0 0 0 / 0.5), transparent);
  }

  .df-insta-story__slide::after {
    bottom: 0;
    height: 50%;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
  }

  .df-insta-story__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .df-insta-story__bars {
    position: absolute;
    inset: 10px 10px auto;
    z-index: 3;
    display: flex;
    gap: 4px;
  }

  .df-insta-story__bar {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.35);
  }

  .df-insta-story__fill {
    display: block;
    height: 100%;
    background: var(--df-story-ink);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .df-insta-story__controls {
    position: absolute;
    top: 18px;
    right: 4px;
    z-index: 3;
    display: flex;
    transition: opacity 0.2s var(--df-ease);
  }

  .df-insta-story__control,
  .df-insta-story__nav {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--df-story-ink);
    cursor: pointer;
  }

  .df-insta-story__control svg {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }

  .df-insta-story__control[hidden] {
    display: none;
  }

  .df-insta-story__control:focus-visible,
  .df-insta-story__nav:focus-visible,
  .df-insta-story__cta:focus-visible {
    outline: 2px solid var(--df-story-ink);
    outline-offset: 2px;
  }

  [data-df-pause][aria-pressed='true'] .df-insta-story__icon-pause,
  [data-df-pause][aria-pressed='false'] .df-insta-story__icon-play,
  [data-df-mute][aria-pressed='true'] .df-insta-story__icon-sound,
  [data-df-mute][aria-pressed='false'] .df-insta-story__icon-muted {
    display: none;
  }

  .df-insta-story__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    background: rgb(0 0 0 / 0.35);
    transform: translateY(-50%);
    transition: opacity 0.2s var(--df-ease);
  }

  .df-insta-story__nav svg {
    width: 24px;
    height: 24px;
  }

  .df-insta-story__nav--prev {
    left: 6px;
  }

  .df-insta-story__nav--next {
    right: 6px;
  }

  .df-insta-story__nav[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  .df-insta-story__viewer.is-holding .df-insta-story__controls,
  .df-insta-story__viewer.is-holding .df-insta-story__nav {
    opacity: 0;
  }

  .df-insta-story__caption {
    position: absolute;
    inset: auto 16px max(24px, env(safe-area-inset-bottom));
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
  }

  .df-insta-story__line-1 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .df-insta-story__line-2 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  .df-insta-story__line-2 span {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--df-accent);
    color: var(--df-on-accent);
    text-shadow: none;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .df-insta-story__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 10px;
    padding: 12px 28px;
    border-radius: var(--df-radius-pill);
    background: var(--df-story-ink);
    color: var(--df-story-canvas);
    font-weight: 700;
    text-decoration: none;
    text-shadow: none;
  }

  @media (min-width: 750px) {
    .df-insta-story__row {
      gap: 24px;
    }

    .df-insta-story--card .df-insta-story__inner {
      margin-inline: auto;
      padding-block: 32px;
    }

    .df-insta-story__stage {
      width: auto;
      height: min(92dvh, 960px);
      aspect-ratio: 9 / 16;
      border-radius: var(--df-radius);
    }

    .df-insta-story__nav--prev {
      left: 10px;
    }

    .df-insta-story__nav--next {
      right: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Historias",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los medios vienen del metafield dropflex.insta_story_media o de los bloques; los textos, de dropflex.insta_story o de cada bloque. Usa solo fotos y videos reales: una persona generada con IA no puede presentarse como cliente."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Míralo en acción"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Bajada",
      "default": "Toca una historia para verla"
    },
    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Destino del botón",
      "info": "Un #ancla de esta página (ej.: #comprar). Vacío = página del producto. El enlace de cada historia tiene prioridad."
    },
    {
      "type": "header",
      "content": "Visor"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duración de imágenes",
      "info": "Los videos duran lo que dura el video.",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "start_muted",
      "label": "Videos sin sonido",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "close_at_end",
      "label": "Cerrar al terminar",
      "default": true
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Tamaño del círculo",
      "min": 60,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "ring_style",
      "label": "Aro",
      "options": [
        { "value": "gradient", "label": "Degradado" },
        { "value": "solid", "label": "Sólido" },
        { "value": "none", "label": "Sin aro" }
      ],
      "default": "gradient"
    },
    {
