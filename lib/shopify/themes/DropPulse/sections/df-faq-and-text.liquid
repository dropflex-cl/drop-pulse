{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.faq_and_text.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
<script src="{{ 'df-faq-and-text.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-faq-and-text">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-faq-and-text-content', product: df_product, section: section, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-faq-and-text-content', product: df_product, section: section, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-faq-and-text-content', product: df_product, section: section, content: df_variants %}
{%- endif -%}

{% stylesheet %}
  df-faq-and-text {
    display: block;
  }

  .df-faq-and-text {
    interpolate-size: allow-keywords;
  }

  .df-faq-and-text__inner {
    display: grid;
    gap: 24px;
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--df-gutter);
  }

  .df-faq-and-text--card .df-faq-and-text__inner {
    width: calc(100% - var(--df-gutter) * 2);
    max-width: var(--df-container);
    margin-inline: auto;
    padding: 28px 20px;
    border-radius: var(--df-radius-lg);
    background: var(--df-surface);
  }

  .df-faq-and-text__intro {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: center;
    text-align: center;
  }

  .df-faq-and-text__heading {
    font-size: var(--df-title-size);
  }

  .df-faq-and-text__highlight {
    color: var(--df-accent-ink);
  }

  .df-faq-and-text__body {
    max-width: 48ch;
  }

  .df-faq-and-text__proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .df-faq-and-text__avatars {
    display: flex;
    margin: 0;
    padding: 0 0 0 10px;
    list-style: none;
  }

  .df-faq-and-text__avatars li {
    margin-left: -10px;
  }

  .df-faq-and-text__avatar {
    display: block;
    width: 44px;
    height: 44px;
    border: 2px solid var(--df-bg);
    border-radius: 50%;
    object-fit: cover;
  }

  .df-faq-and-text__proof-text {
    display: grid;
    gap: 4px;
    justify-items: inherit;
  }

  .df-faq-and-text__proof-line {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }


  .df-faq-and-text__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 8px;
    padding: 12px 24px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
    color: var(--df-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--df-ease),
      scale var(--df-dur-fast) var(--df-ease-standard);
  }

  .df-faq-and-text__cta:hover {
    transform: translateY(-1px);
  }

  .df-faq-and-text__cta:focus-visible,
  .df-faq-and-text__question:focus-visible {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  .df-faq-and-text__list {
    display: grid;
    align-content: start;
  }

  .df-faq-and-text__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 16px 0;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    text-align: start;
    cursor: pointer;
    list-style: none;
    border-radius: var(--df-radius-sm);
  }

  .df-faq-and-text__question::-webkit-details-marker {
    display: none;
  }

  /* Signo + que pasa a −: dos barras en CSS; la vertical gira y se esconde. */
  .df-faq-and-text__sign {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .df-faq-and-text__sign::before,
  .df-faq-and-text__sign::after {
    content: '';
    position: absolute;
    inset: 7px 0 auto;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--df-ease), opacity 0.3s var(--df-ease);
  }

  .df-faq-and-text__sign::after {
    transform: rotate(90deg);
  }

  .df-faq-and-text__item[open] .df-faq-and-text__sign::after {
    transform: rotate(180deg);
    opacity: 0;
  }

  .df-faq-and-text__answer {
    padding-bottom: 18px;
  }

  .df-faq-and-text__answer .df-text {
    font-size: 0.9375rem;
  }

  /* Apertura animada donde el navegador lo permite (::details-content); si no, abre sin animar. */
  .df-faq-and-text__item::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.35s var(--df-ease), content-visibility 0.35s allow-discrete;
  }

  .df-faq-and-text__item[open]::details-content {
    block-size: auto;
  }

  .df-faq-and-text--dividers .df-faq-and-text__item {
    border-bottom: 1px solid var(--df-hairline);
  }

  .df-faq-and-text--cards .df-faq-and-text__list {
    gap: 12px;
  }

  .df-faq-and-text--cards .df-faq-and-text__item {
    border-radius: var(--df-radius-sm);
    background: var(--df-surface);
  }

  .df-faq-and-text--cards.df-faq-and-text--card .df-faq-and-text__item {
    background: var(--df-bg);
  }

  .df-faq-and-text--cards .df-faq-and-text__question {
    padding-inline: 18px;
  }

  .df-faq-and-text--cards .df-faq-and-text__answer {
    padding-inline: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .df-faq-and-text__item::details-content {
      transition: none;
    }
  }

  @media (min-width: 990px) {
    .df-faq-and-text__inner {
      grid-template-columns: minmax(0, var(--df-faq-left, 40%)) minmax(0, 1fr);
      gap: 56px;
    }

    .df-faq-and-text--card .df-faq-and-text__inner {
      margin-inline: auto;
      padding: 56px;
    }

    .df-faq-and-text__intro {
      position: sticky;
      top: 24px;
      justify-items: start;
      text-align: start;
    }

    .df-faq-and-text__proof {
      align-items: flex-start;
    }

    .df-faq-and-text__question {
      font-size: 1.125rem;
    }

    .df-faq-and-text__answer .df-text {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · FAQ con texto",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.faq_and_text; estos ajustes y las preguntas son el respaldo. Usa {return_days}, {min} y {max} para plazos: se llenan con tus políticas y logística."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Resolvemos tus dudas antes de pedir"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Palabras en acento",
      "info": "Deben aparecer tal cual en el título.",
      "default": "tus dudas"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Bajada"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón",
      "info": "Vacío = página del producto."
    },
    {
      "type": "header",
      "content": "Prueba social"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Mostrar prueba social",
      "default": true
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Texto",
      "info": "{count} y {rating} salen de tus reseñas aprobadas. Sin reseñas, no se muestra.",
      "default": "{rating} de 5 según {count} reseñas"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1",
      "info": "Solo clientes reales con permiso, o ilustraciones que no se hagan pasar por clientes."
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "header",
      "content": "Acordeón"
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Una abierta a la vez",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Primera abierta",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "emit_schema",
      "label": "Datos estructurados FAQ",
      "info": "Agrega JSON-LD FAQPage. Desactívalo si otra app ya lo agrega en esta página.",
      "default": false
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "Tarjeta alrededor",
      "default": true
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "Estilo de preguntas",
      "options": [
        { "value": "dividers", "label": "Divisores" },
        { "value": "cards", "label": "Tarjetas" }
      ],
      "default": "dividers"
    },
    {
      "type": "range",
      "id": "left_width",
      "label": "Ancho del texto",
      "info": "En escritorio.",
      "min": 30,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "info": "Como la pensaría el comprador, en primera persona.",
          "default": "¿Pago cuando me llegue?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta",
          "info": "Primera frase responde directo. Plazos con {min}, {max}, {return_days}.",
          "default": "Sí. Pagas al recibir tu pedido en la puerta de tu casa, sin adelantar nada."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · FAQ con texto",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "¿Pago cuando me llegue?",
            "answer": "Sí. Pagas al recibir tu pedido en la puerta de tu casa, sin adelantar nada."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto demora en llegar?",
            "answer": "Entre {min} y {max} días hábiles. Te avisamos cuando tu pedido salga a reparto."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Y si no me queda o no me gusta?",
            "answer": "Tienes {return_days} días para pedir el cambio. Escríbenos y te guiamos paso a paso."
          }
        }
      ]
    }
  ]
}
{% endschema %}
