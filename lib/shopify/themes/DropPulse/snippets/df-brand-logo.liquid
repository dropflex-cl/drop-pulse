{% stylesheet %}
  /* Cada tono sale de las variables que el snippet calcula en Liquid desde el acento del producto;
     esto solo las asigna a las partes del dibujo. */
  .df-brand-logo {
    display: block;
    width: auto;
    height: var(--df-brand-logo-height, 52px);
    max-width: 100%;
    overflow: visible;
  }

  .df-brand-logo__ink {
    fill: var(--df-logo-ink);
  }

  .df-brand-logo__ink-line {
    fill: none;
    stroke: var(--df-logo-ink);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .df-brand-logo__tint {
    fill: var(--df-logo-tint);
  }

  .df-brand-logo__shade {
    fill: var(--df-logo-shade);
  }

  .df-brand-logo__orb {
    fill: var(--df-logo-orb);
  }

  .df-brand-logo__glint {
    fill: #ffffff;
    opacity: 0.75;
  }

  .df-brand-logo__tag {
    fill: var(--df-logo-tag);
  }

  /* El contorno de sticker es el propio trazo de las letras, pintado bajo su relleno. */
  .df-brand-logo__word {
    fill: #ffffff;
    stroke: var(--df-logo-ink);
    stroke-width: 22;
    stroke-linejoin: round;
    paint-order: stroke;
  }
{% endstylesheet %}
