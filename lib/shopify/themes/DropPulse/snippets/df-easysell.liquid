{%- doc -%}
  DropFlex · EasySell COD Form con el design system de DropFlex (portado de v1, flux ›
  dropflex-cod-cta-accent y la capa «EASYSELL» de flux-redesign.css). Va al final del <body>.

  - Formulario: campos, prefijos, resumen del pedido, fotos, errores y modales con los tokens del
    tema (Geist, tinta, bordes, radios 6/10/14px, anillo de foco, radio de las fotos del producto).
  - Formulario de pedido como CodOrderForm del design system: packs como BundlePicker (radio, el
    elegido en acento, el ahorro en verde), agregados como OrderBump (casilla de 22px, sin borde
    punteado; marcados en acento), resumen con el ahorro y el envío gratis en verde, y el orden
    agregados → resumen → botón. Solo la vista: ningún nodo de EasySell se mueve, se crea ni se
    borra, y ningún id, name, clase ni manejador cambia (EasySell mide impresiones y conversiones
    por esos selectores). Packs, agregados y la X se anuncian como radio, casilla y botón y se usan
    con el teclado (hacen clic en el mismo nodo).
  - Botones: el que abre el formulario, la barra fija de la app, el de enviar y el de aceptar del
    downsell toman el botón principal del tema: el acento del producto (df-design-system), su
    texto, su hover y su radio. Planos, sin el degradado ni la sombra de la app.
  - El de rechazar del downsell (y del upsell posterior a la compra) va como texto subrayado en
    gris: la salida no pesa lo mismo que la oferta. Por defecto el popup del downsell lo reemplaza
    df-downsell; esto es lo que se ve cuando ese ajuste está apagado o no aplica.
  - Brillo en el botón que abre el formulario (ajuste `df_easysell_motion`): al aparecer en
    pantalla, dos pasadas de una franja de luz con un leve pulso, y se detiene.
  - Una sola barra fija de compra: la del tema, con el texto del botón de EasySell; al tocarla hace
    clic en el propio botón de EasySell (sus eventos de píxel quedan iguales). La de la app se oculta.

  POR QUÉ HAY SCRIPT: EasySell escribe color, fondo, borde, radio y sombra de sus botones y de la
  tarjeta del formulario como estilos INLINE con !important, que le ganan a cualquier hoja de
  estilos. La única forma es escribir esos mismos estilos inline después de que la app monta cada
  nodo, y volver a escribirlos cuando la app los repone (cambio de variante, animación, carrito).
  El pintado es idempotente: compara antes de escribir, así el observador no entra en bucle.

  El DOM de una app de terceros no es un contrato: sin la app, o si cambia su markup, no pasa nada
  (la app queda con sus colores). Solo toca pintura, nunca comportamiento.

  Se apaga con el ajuste `df_easysell` (o con todo el design system, `df_design_system`).
{%- enddoc -%}
{%- if settings.df_design_system != false and settings.df_easysell != false -%}
  {% style %}
    #easysell,
    .es-modal {
      --df-es-ink: var(--color-foreground, #15171c);
      --df-es-bg: var(--color-background, #ffffff);
      --df-es-muted: color-mix(in srgb, var(--df-es-ink) 68%, var(--df-es-bg));
      --df-es-hairline: color-mix(in srgb, var(--df-es-ink) 12%, transparent);
      --df-es-surface: color-mix(in srgb, var(--df-es-ink) 4%, var(--df-es-bg));
      --df-es-line: var(--color-input-border, #7d838e);
      --df-es-field-radius: var(--style-border-radius-inputs, 10px);
      --df-es-card-radius: var(--style-border-radius-lg, 14px);
      --df-es-ring: var(--df-ds-ring, #1f4bd8);
      --df-es-border: color-mix(in srgb, var(--df-es-ink) 12%, var(--df-es-bg));
      --df-es-muted-bg: color-mix(in srgb, var(--df-es-ink) 5%, var(--df-es-bg));
      --df-es-accent: var(--color-primary-button-background, #1f4bd8);
      --df-es-on-accent: var(--color-primary-button-text, #ffffff);
      --df-es-accent-soft: color-mix(in srgb, var(--df-es-accent) 8%, var(--df-es-bg));
      /* Significado fijo (ahorro y envío gratis = verde): success y success-soft del design system. */
      --df-es-positive: #12784a;
      --df-es-positive-soft: #e6f4ec;

      font-family: var(--df-ds-font, inherit);
    }

    #easysell .es-form-container {
      padding: 24px 20px 28px;
    }

    /* Campos: el borde y el radio de los inputs del tema, y el foco del design system. Borde y
       radio van con !important porque la hoja de la app (de otro origen) los declara así. */
    #easysell .es-input,
    #easysell .es-form-control,
    #easysell .es-select {
      min-height: 48px;
      padding: 12px 14px;
      border-color: var(--df-es-line) !important;
      border-radius: var(--df-es-field-radius) !important;
      background-color: var(--color-input-background, var(--df-es-bg));
      color: var(--df-es-ink);
      font-family: inherit;
      font-size: 16px;
      transition: border-color 120ms ease, box-shadow 120ms ease;
    }

    /* El prefijo y el campo son una sola pieza: el campo pierde las esquinas del lado del prefijo. */
    #easysell .es-input-group > .es-input,
    #easysell .es-input-group > .es-form-control,
    #easysell .es-input-group > .es-select {
      border-top-left-radius: 0 !important;
      border-bottom-left-radius: 0 !important;
    }

    #easysell .es-input-group-text {
      border-color: var(--df-es-line);
      border-radius: var(--df-es-field-radius) 0 0 var(--df-es-field-radius);
      background: var(--df-es-surface);
      color: var(--df-es-muted);
    }

    #easysell .es-input:focus,
    #easysell .es-form-control:focus,
    #easysell .es-select:focus {
      border-color: var(--df-es-ring) !important;
      box-shadow: 0 0 0 1px var(--df-es-ring);
      outline: none;
    }

    /* ---- Formulario de pedido: CodOrderForm, BundlePicker y OrderBump del design system ----
       Solo la vista. Ningún nodo de EasySell se mueve, se crea ni se borra, y ningún id, name,
       clase ni manejador cambia: EasySell mide impresiones y conversiones por esos selectores. Lo
       que la app escribe inline sin !important se gana aquí; lo que escribe con !important (textos
       de los packs, título, precio) lo repinta el script. */

    /* Orden del design system: agregados → resumen → botón. En la app los agregados van dentro del
       grupo del botón, después del resumen; display: contents y order cambian solo lo que se ve. */
    #easysell .es-form {
      display: flex;
      flex-direction: column;
    }

    /* Los grupos vacíos de la app (solo comentarios de Vue) dejaban 16px cada uno. Sin margen y no
       ocultos: la app fuerza display: block en todo lo vacío de #easysell. */
    #easysell .es-form > .es-group:empty {
      margin-bottom: 0;
    }

    #easysell .es-form > .es-cta-group {
      display: contents;
    }

    #easysell .es-form > .es-cta-group > * {
      order: 3;
    }

    #easysell .es-form > .es-cta-group > #es-bumps {
      order: 1;
    }

    #easysell .es-form > .es-order_summary-group {
      order: 2;
    }

    #easysell .es-form > .es-cta-group ~ * {
      order: 4;
    }

    /* Encabezado: título a la izquierda y la X con área táctil de 44px. */
    #easysell .es-form-header {
      align-items: center !important;
      gap: 8px;
      margin-bottom: 16px;
    }

    #easysell .es-form-header .mb-2,
    #easysell .es-form-header p {
      margin: 0 !important;
      text-align: inherit !important;
      line-height: 24px;
    }

    #easysell .es-form-header .close-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin: -10px -10px -10px 0;
      border-radius: var(--df-es-field-radius);
      color: var(--df-es-muted) !important;
      font-size: 18px;
    }

    #easysell .es-form-header .close-icon:hover {
      background: var(--df-es-surface);
      color: var(--df-es-ink) !important;
    }

    /* Títulos de sección de la app («Tus datos de envío»). */
    #easysell .es-group[class*=' es-title'] > .mb-2 {
      margin: 4px 0 12px !important;
      line-height: 22px;
    }

    /* Packs (BundlePicker): tarjeta con radio, la elegida en acento y el ahorro en verde. */
    #easysell .es-qo-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 72px;
      margin: 0 0 8px !important;
      padding: 10px 12px !important;
      border: 1px solid var(--df-es-border) !important;
      border-radius: var(--df-es-card-radius) !important;
      background: var(--df-es-bg) !important;
      transition: border-color 120ms ease, background-color 120ms ease;
    }

    #easysell .es-qo-container[offer-selected] {
      border-color: var(--df-es-accent) !important;
      background: var(--df-es-accent-soft) !important;
      box-shadow: inset 0 0 0 1px var(--df-es-accent);
    }

    #easysell .es-qo-container > .d-flex::before {
      content: '';
      flex: none;
      width: 18px;
      height: 18px;
      margin-right: 10px;
      border-radius: 50%;
      background: var(--df-es-bg);
      box-shadow: inset 0 0 0 1.5px var(--df-es-line);
    }

    #easysell .es-qo-container[offer-selected] > .d-flex::before {
      box-shadow: inset 0 0 0 5px var(--df-es-accent);
    }

    #easysell .es-qo-container .es-offer-image {
      min-width: 0 !important;
      margin-right: 10px !important;
    }

    #easysell .es-qo-container .offer-image {
      display: block;
      width: 48px !important;
      height: 48px;
      border-radius: var(--style-border-radius-sm, 6px);
      object-fit: cover;
    }

    #easysell .es-qo-container .flex-fill {
      gap: 4px;
      min-width: 0;
      margin: 0 !important;
    }

    #easysell .es-qo-container .flex-fill > .mb-1 {
      margin: 0 !important;
      line-height: 20px;
    }

    #easysell .es-qo-container .es-offer-badge {
      height: 22px;
      padding: 0 8px !important;
      border-radius: 999px !important;
      line-height: 22px;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    #easysell .es-qo-container .px-2 {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding: 0 0 0 8px !important;
    }

    #easysell .es-qo-container .es-o-cp {
      color: var(--df-es-muted);
      font-size: 13px;
      line-height: 18px;
      font-variant-numeric: tabular-nums;
    }

    #easysell .es-qo-container .es-o-p {
      line-height: 22px;
      font-variant-numeric: tabular-nums;
    }

    /* Agregados (OrderBump): tarjeta sobria con casilla de 22px; marcada, acento y fondo suave. */
    #easysell .es-bumps {
      margin-bottom: 16px;
    }

    #easysell .es-bumps .es-offer-container {
      margin: 0 0 8px !important;
      padding: 10px 12px !important;
      border: 1px solid var(--df-es-border) !important;
      border-radius: var(--df-es-card-radius) !important;
      background: var(--df-es-bg) !important;
      animation: none !important;
      transition: border-color 120ms ease, background-color 120ms ease;
    }

    #easysell .es-bumps .es-offer-container:has(.bump-checkbox-input:checked) {
      border-color: var(--df-es-accent) !important;
      background: var(--df-es-accent-soft) !important;
    }

    #easysell .es-bumps .es-offer-main {
      gap: 10px;
    }

    #easysell .es-bumps .bump-checkbox {
      margin: 0 !important;
      padding: 0 !important;
    }

    #easysell .es-bumps .bump-checkbox span:first-child {
      flex: 0 0 22px !important;
      width: 22px !important;
      height: 22px !important;
      border: 1.5px solid var(--df-es-line) !important;
      border-radius: var(--style-border-radius-sm, 6px) !important;
      background-color: var(--df-es-bg) !important;
    }

    #easysell .es-bumps .bump-checkbox-input:checked + .bump-checkbox span:first-child {
      border-color: var(--df-es-accent) !important;
      background-color: var(--df-es-accent) !important;
    }

    #easysell .es-bumps .bump-checkbox span:first-child svg {
      top: 4.5px !important;
      left: 3.5px !important;
      stroke: var(--df-es-on-accent) !important;
    }

    #easysell .es-bumps .es-offer-content .me-2 {
      min-width: 0 !important;
      margin-right: 10px !important;
    }

    #easysell .es-bumps .offer-image {
      display: block;
      width: 44px !important;
      height: 44px;
      border-radius: var(--style-border-radius-sm, 6px) !important;
      object-fit: cover;
    }

    #easysell .es-bumps .es-offer-text {
      flex: 1;
      color: var(--df-es-ink);
      font-size: 14px;
      line-height: 20px;
    }

    #easysell .es-bumps .es-offer-text :is(strong, b) {
      font-weight: 600;
    }

    /* Tamaños que el editor de EasySell deja inline en el texto del agregado. */
    #easysell .es-bumps .es-offer-text span[style*='font-size'] {
      font-size: inherit !important;
    }

    #easysell .es-bumps .es-offer-text .text-secondary {
      color: var(--df-es-muted) !important;
      font-size: 13px !important;
      line-height: 18px;
    }

    /* Texto del agregado con la forma «<strong>nombre</strong> <strong>+precio</strong>» (las
       variables title y price de EasySell): el nombre a la izquierda y el precio a la derecha, como
       OrderBump (el script lo reconoce). */
    #easysell .es-bumps [data-df-es-split] {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }

    #easysell .es-bumps [data-df-es-split] > :last-child {
      flex: none;
      font-size: 15px;
      font-variant-numeric: tabular-nums;
    }

    /* Resumen: fondo gris sin borde, ahorro y envío gratis en verde, y el total a pagar al final. */
    #easysell .total-container {
      margin: 0 !important;
      padding: 12px 14px !important;
      border: 0 !important;
      border-radius: var(--df-es-card-radius) !important;
      background-color: var(--df-es-muted-bg) !important;
      color: var(--df-es-ink) !important;
    }

    #easysell .total-container > .p-1 {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 0 !important;
    }

    #easysell .total-container :is(.es-subt-line, .es-discount-line, .es-shipping-line, .es-bump-line, .es-line-item) {
      padding: 0 !important;
      border: 0 !important;
      font-size: 14px;
      line-height: 20px;
    }

    #easysell .total-container .label-title {
      color: var(--df-es-muted);
      font-weight: 400 !important;
    }

    #easysell .total-container .label-value {
      color: var(--df-es-ink);
      font-size: 14px;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
    }

    #easysell .total-container .es-discount-mask {
      background-color: var(--df-es-muted) !important;
    }

    #easysell .total-container .es-d-price,
    #easysell .total-container .es-d-price .money,
    #easysell .total-container [data-df-es-free] .label-value {
      color: var(--df-es-positive) !important;
      font-weight: 600;
    }

    #easysell .total-container .es-d-price svg {
      stroke: var(--df-es-positive);
    }

    #easysell .total-container .es-total-line {
      margin: 4px 0 0 !important;
      padding: 8px 0 0 !important;
      border-top: 1px solid var(--df-es-border) !important;
      color: var(--df-es-ink);
      font-size: 16px;
      font-weight: 600 !important;
    }

    #easysell .total-container .es-total-line .total-value {
      font-size: 20px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    /* Botón de enviar: 56px, título y bajada; sin el rebote de la app mientras se llena el formulario. */
    #easysell .es-cta-btn {
      min-height: 56px;
      margin: 16px 0 0 !important;
      padding: 8px 16px !important;
    }

    #easysell .es-cta-btn .es-button-subtitle {
      margin-top: 0;
      font-size: 13px;
      line-height: 18px;
      font-weight: 400;
      opacity: 0.9;
    }

    #easysell .es-cta-btn.cart-shaker.es-animation-active {
      animation: none !important;
      transform: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .cart-shaker.es-animation-active {
        animation: none !important;
      }
    }

    /* Foco de teclado en las tarjetas y la X (el script las hace alcanzables con Tab). */
    #easysell :is(.es-qo-container, .es-offer-container, .close-icon):focus-visible {
      outline: 2px solid var(--df-es-ring);
      outline-offset: 2px;
    }

    @media screen and (max-width: 749px) {
      #easysell .es-qo-container .offer-image {
        width: 40px !important;
        height: 40px;
      }
    }

    #easysell .es-product-title {
      line-height: 1.35;
    }

    #easysell .es-image,
    #easysell .es-image-container img {
      border-radius: var(--gallery-media-border-radius, 12px);
    }

    #easysell .quantity-badge {
      background: var(--df-es-ink) !important;
      color: var(--df-es-bg) !important;
      font-variant-numeric: tabular-nums;
    }

    #easysell .es-errors {
      color: #b91c1c;
      font-size: 14px;
    }

    .es-modal .es-modal-content {
      border-radius: var(--df-es-card-radius);
      box-shadow: 0 16px 48px -8px color-mix(in srgb, #000000 22%, transparent);
    }

    .es-popup-button,
    .es-sticky-btn,
    .es-cta-btn,
    .es-animated-button {
      font-family: var(--df-ds-font, inherit);
      letter-spacing: -0.01em;
      transition: background-color 120ms ease;
    }

    /* El botón de EasySell ocupa todo el ancho de la ficha. EasySell oculta el «Agregar al carrito»
       del tema pero deja su contenedor, que en escritorio le quitaba media fila (el script marca ese
       contenedor vacío con data-df-es-empty). */
    .product-form-buttons > [data-df-es-empty] {
      display: none !important;
    }

    .product-form-buttons > .accelerated-checkout-block:has(.es-popup-button) {
      flex-basis: 100%;
    }

    .product-form-buttons .es-popup-button {
      box-sizing: border-box;
      width: 100%;
    }

    /* Brillo del botón que abre el formulario (ajuste df_easysell_motion): una franja de luz lo
       cruza con un leve pulso. El script pone data-df-es-shine al aparecer el botón en pantalla y lo
       quita al terminar; nada de clases ni ids de la app. */
    #es-popup-button[data-df-es-motion] {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    #es-popup-button[data-df-es-motion]::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.4) 50%, transparent 70%);
      transform: translateX(-120%);
    }

    #es-popup-button[data-df-es-shine] {
      animation: df-es-nudge 600ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    #es-popup-button[data-df-es-shine]::after {
      animation: df-es-shine 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes df-es-nudge {
      40% {
        transform: scale(1.03);
      }
    }

    @keyframes df-es-shine {
      to {
        transform: translateX(120%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #es-popup-button[data-df-es-shine],
      #es-popup-button[data-df-es-shine]::after {
        animation: none;
      }
    }

    /* Una sola barra fija de compra (html.df-es-cod, lo pone el script cuando EasySell está en la
       ficha): la del tema, con el texto del botón de EasySell y sin el ícono del carrito. La barra
       propia de EasySell se oculta; su display lo escribe la app inline con !important, por eso
       visibility. */
    .df-es-cod #es-sticky {
      visibility: hidden !important;
      pointer-events: none !important;
    }

    .df-es-cod .sticky-add-to-cart__button .svg-wrapper {
      display: none;
    }

    .df-es-cod .sticky-add-to-cart__button {
      font-family: var(--df-ds-font, inherit);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    @media screen and (max-width: 749px) {
      /* Móvil: foto, precio y el botón con su texto (el tema solo muestra el ícono). El nombre del
         producto sale de la barra para dejarle el ancho al botón. */
      .df-es-cod .sticky-add-to-cart__bar .add-to-cart-text__content {
        display: inline;
      }

      .df-es-cod .sticky-add-to-cart__title,
      .df-es-cod .sticky-add-to-cart__variant {
        display: none !important;
      }

      .df-es-cod .sticky-add-to-cart__info {
        flex: none;
        padding-inline-start: 0;
      }

      .df-es-cod .sticky-add-to-cart__button {
        flex: 1 1 auto;
        min-width: 0;
        padding: 8px 14px;
        font-size: 14px;
        line-height: 1.2;
        text-wrap: balance;
      }
    }
  {% endstyle %}

  <script>
    (function () {
      /* Los botones que la app pinta con su degradado, en el orden del comprador: el que abre el
         formulario, la barra fija de la app, el de enviar y los del downsell. El sello del downsell
         solo toma el fondo (su forma es un clip-path de la app). La tarjeta del formulario toma el
         radio y la tinta del tema, sin la sombra de la app. */
      var BUTTONS = '.es-popup-button, .es-sticky-btn, .es-cta-btn, .es-animated-button';
      /* Aceptar y rechazar del downsell (y del upsell posterior a la compra) son el mismo
         componente de la app, con la misma clase y un id aleatorio: el de rechazar es el que no es
         el primero de su grupo. */
      var DECLINE_GROUPS = '.es-downsell-buttons, #easysell-upsell';
      var BADGE = '.es-downsell-badge';
      var CARD = '.es-form-container';
      var HOVER = 'dfEsHover';
      var WATCHED = 'dfEsWatched';
      var tokens = null;

      /* Verde de ahorro (success y success-soft del design system), ya como rgb(): el navegador lo
         devuelve igual al leerlo, así la comparación de paint() cierra. */
      var POSITIVE = 'rgb(18, 120, 74)';
      var POSITIVE_SOFT = 'rgb(230, 244, 236)';

      /* Textos del formulario que la app escribe inline con !important: toman la escala del design
         system (tamaño, peso, color, alineación). El texto sigue siendo el de EasySell. null = quitar
         lo que se había escrito (el sello vacío del pack de 1 unidad se oculta; si vuelve a tener
         texto, se muestra). */
      var TEXTS = [
        ['#easysell .es-form-header .flex-fill > .mb-2', function () {
          return { color: tokens.ink, 'font-size': '18px', 'font-weight': '700', 'text-align': 'left' };
        }],
        ['#easysell .es-group[class*=" es-title"] > .mb-2', function () {
          return { color: tokens.ink, 'font-size': '16px', 'font-weight': '600', 'text-align': 'left' };
        }],
        ['#easysell .es-qo-container .flex-fill > .mb-1', function () {
          return { color: tokens.ink, 'font-size': '15px', 'font-weight': '600' };
        }],
        ['#easysell .es-qo-container .es-o-p', function () {
          return { color: tokens.ink, 'font-size': '17px', 'font-weight': '700' };
        }],
        ['#easysell .es-qo-container .es-offer-badge', function (el) {
          if (!el.textContent.trim()) return { display: 'none' };
          return { display: null, 'background-image': 'none', 'background-color': POSITIVE_SOFT, color: POSITIVE, 'font-size': '12px', 'font-weight': '600' };
        }],
      ];
      var TEXT_SELECTOR = TEXTS.map(function (rule) {
        return rule[0];
      }).join(', ');

      /* Los tokens del tema, resueltos una vez: el botón principal (que df-design-system ya tiñó
         con el acento del producto), su texto, su hover y su radio; la tinta, el fondo y el radio
         de las tarjetas. Se escriben ya resueltos para comparar texto con texto. */
      function readTokens() {
        var probe = document.createElement('span');
        probe.setAttribute('aria-hidden', 'true');
        probe.style.cssText =
          'position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;' +
          'background-color:var(--color-primary-button-background);' +
          'color:var(--color-primary-button-text);' +
          'border-top-color:var(--color-primary-button-hover-background);' +
          'border-bottom-color:var(--color-foreground);' +
          'outline-color:var(--color-background);' +
          'border-top-left-radius:var(--style-border-radius-buttons-primary,10px);' +
          'border-top-right-radius:var(--style-border-radius-lg,14px);';
        document.body.appendChild(probe);
        var cs = window.getComputedStyle(probe);
        var t = {
          accent: cs.backgroundColor,
          onAccent: cs.color,
          hover: cs.borderTopColor,
          ink: cs.borderBottomColor,
          bg: cs.outlineColor,
          buttonRadius: cs.borderTopLeftRadius,
          cardRadius: cs.borderTopRightRadius,
        };
        probe.remove();
        t.muted = mix(t.ink, t.bg, 0.68);
        /* Sin botón principal resuelto (otro tema, variables ausentes): la app queda como está. */
        return t.accent && t.accent !== 'rgba(0, 0, 0, 0)' ? t : null;
      }

      /* El gris de texto secundario del tema (68% de tinta sobre el fondo, como --df-muted), ya
         como rgb(): el navegador lo devuelve igual al leerlo, así la comparación de paint() cierra. */
      function mix(ink, bg, weight) {
        var a = (ink.match(/[\d.]+/g) || []).map(Number);
        var b = (bg.match(/[\d.]+/g) || []).map(Number);
        if (a.length < 3 || b.length !== 3) return ink;
        var c = [0, 1, 2].map(function (i) {
          return Math.round(a[i] * weight + b[i] * (1 - weight));
        });
        return 'rgb(' + c.join(', ') + ')';
      }

      function isDecline(el) {
        if (!el.matches('.es-animated-button')) return false;
        var group = el.closest(DECLINE_GROUPS);
        var first = group ? group.querySelector('.es-animated-button') : null;
        return Boolean(first) && first !== el;
      }

      function wanted(el) {
        for (var i = 0; i < TEXTS.length; i++) {
          if (el.matches(TEXTS[i][0])) return TEXTS[i][1](el);
        }
        if (el.matches(BADGE)) {
          return { 'background-image': 'none', 'background-color': tokens.accent };
        }
        if (el.matches(CARD)) {
          return { 'border-radius': tokens.cardRadius, 'box-shadow': 'none', color: tokens.ink, 'background-color': tokens.bg };
        }
        if (isDecline(el)) {
          return {
            'background-image': 'none',
            'background-color': 'transparent',
            'border-color': 'transparent',
            color: el.dataset[HOVER] ? tokens.ink : tokens.muted,
            'box-shadow': 'none',
            'text-decoration': 'underline',
            'text-underline-offset': '3px',
            'font-weight': '400',
          };
        }
        var primary = {
          'background-image': 'none',
          'background-color': el.dataset[HOVER] ? tokens.hover : tokens.accent,
          'border-color': tokens.accent,
          color: tokens.onAccent,
          'border-radius': tokens.buttonRadius,
          'box-shadow': 'none',
        };
        /* El de enviar el pedido: 17px/600 como el botón de CodOrderForm. */
        if (el.matches('#easysell .es-cta-btn')) {
          primary['font-size'] = '17px';
          primary['font-weight'] = '600';
        }
        return primary;
      }

      /* Los textos de los botones con color inline propio (el título es .es-button-title en un
         botón y un span suelto en otro; el downsell no tiene): se buscan por su estilo. */
      function labels(el) {
        if (!el.matches(BUTTONS)) return [];
        var out = [];
        var nodes = el.querySelectorAll('*');
        for (var i = 0; i < nodes.length; i++) {
          if (nodes[i].style && nodes[i].style.color) out.push(nodes[i]);
        }
        return out;
      }

      function paint(el) {
        watch(el);
        var want = wanted(el);
        for (var prop in want) {
          if (want[prop] === null) {
            if (el.style.getPropertyValue(prop)) el.style.removeProperty(prop);
          } else if (el.style.getPropertyValue(prop) !== want[prop] || el.style.getPropertyPriority(prop) !== 'important') {
            el.style.setProperty(prop, want[prop], 'important');
          }
        }
        var inner = labels(el);
        for (var i = 0; i < inner.length; i++) {
          if (inner[i].style.color !== want.color) inner[i].style.setProperty('color', want.color, 'important');
        }
      }

      /* Un observador por nodo: despierta cuando la app reescribe su propio style (o el de sus
         textos) y repinta en el mismo momento, sin mostrar un cuadro con el degradado de la app.
         No entra en bucle: nuestra escritura dispara una vuelta más que ya no escribe nada. */
      function watch(el) {
        if (el.dataset[WATCHED]) return;
        el.dataset[WATCHED] = '1';
        new MutationObserver(function () {
          paint(el);
        }).observe(el, { attributes: true, attributeFilter: ['style'], subtree: true });
        if (el.matches(BUTTONS)) {
          el.addEventListener('pointerenter', function () {
            el.dataset[HOVER] = '1';
            paint(el);
          });
          el.addEventListener('pointerleave', function () {
            delete el.dataset[HOVER];
            paint(el);
          });
        }
      }

      function paintAll() {
        var nodes = document.querySelectorAll(BUTTONS + ', ' + BADGE + ', ' + CARD + ', ' + TEXT_SELECTOR);
        for (var i = 0; i < nodes.length; i++) paint(nodes[i]);
        syncForm();
        watchShine();
        syncStickyBar();
      }

      /* ---- Formulario: accesibilidad y marcas para el CSS ----
         Los packs, los agregados y la X son <div>/<span> con clic y sin rol. Se anuncian como radio,
         casilla y botón, y se usan con el teclado: Espacio o Enter hacen clic en el MISMO nodo, así
         corre el código de EasySell tal cual (elige el pack, marca el agregado, cierra). Solo se
         agregan atributos de accesibilidad y data-df-*: ningún id, name ni clase cambia. */
      var PACKS = '#easysell .es-qo-container';
      var BUMPS = '#easysell .es-bumps .es-offer-container';
      var CLOSE = '#easysell .es-form-header .close-icon';

      function setAttr(el, name, value) {
        if (el.getAttribute(name) !== value) el.setAttribute(name, value);
      }

      function syncForm() {
        var packs = document.querySelectorAll(PACKS);
        if (packs.length) {
          setAttr(packs[0].parentElement, 'role', 'radiogroup');
          setAttr(packs[0].parentElement, 'aria-label', 'Elige tu pack');
        }
        for (var i = 0; i < packs.length; i++) {
          setAttr(packs[i], 'role', 'radio');
          setAttr(packs[i], 'tabindex', '0');
          setAttr(packs[i], 'aria-checked', String(packs[i].hasAttribute('offer-selected')));
        }
        var bumps = document.querySelectorAll(BUMPS);
        for (var j = 0; j < bumps.length; j++) {
          var input = bumps[j].querySelector('.bump-checkbox-input');
          setAttr(bumps[j], 'role', 'checkbox');
          setAttr(bumps[j], 'tabindex', '0');
          setAttr(bumps[j], 'aria-checked', String(Boolean(input && input.checked)));
          /* «<strong>nombre</strong> <strong>+precio</strong>»: el CSS pone el precio a la derecha. */
          var text = bumps[j].querySelector('.es-offer-text > div:first-child > span');
          if (text) text.toggleAttribute('data-df-es-split', isSplit(text));
        }
        var close = document.querySelector(CLOSE);
        if (close) {
          setAttr(close, 'role', 'button');
          setAttr(close, 'tabindex', '0');
          setAttr(close, 'aria-label', 'Cerrar');
        }
        /* Envío sin monto («Gratis»): en verde, como el ahorro. Con monto, en tinta. */
        var shipping = document.querySelectorAll('#easysell .es-shipping-line');
        for (var k = 0; k < shipping.length; k++) {
          var value = shipping[k].querySelector('.label-value');
          shipping[k].toggleAttribute('data-df-es-free', Boolean(value) && !/\d/.test(value.textContent));
        }
      }

      function isSplit(span) {
        var kids = span.children;
        if (kids.length !== 2) return false;
        for (var i = 0; i < kids.length; i++) {
          if (!/^(STRONG|B)$/.test(kids[i].tagName)) return false;
        }
        for (var node = span.firstChild; node; node = node.nextSibling) {
          if (node.nodeType === 3 && node.textContent.trim()) return false;
        }
        return true;
      }

      document.addEventListener('keydown', function (event) {
        if (event.key !== ' ' && event.key !== 'Enter') return;
        var el = event.target instanceof Element ? event.target : null;
        if (!el || !el.matches(PACKS + ', ' + BUMPS + ', ' + CLOSE)) return;
        event.preventDefault();
        el.click();
      });

      /* Elegir un pack o marcar un agregado no monta nodos (la app cambia un atributo o la propiedad
         checked): se vuelve a leer el estado después de que la app termina su vuelta. */
      document.addEventListener('click', function (event) {
        if (tokens && event.target instanceof Element && event.target.closest('#easysell')) setTimeout(syncForm, 0);
      });

      /* ---- Una sola barra fija: la del tema abre el formulario de EasySell ----
         En móvil se apilaban la barra del tema (agrega al carrito) y la de EasySell (abre el
         formulario). Queda la del tema, con el texto del botón de EasySell, y al tocarla hace clic
         en el PROPIO botón de EasySell: así corre su código tal cual (abre el formulario y manda
         InitiateCheckout al píxel de Meta y a los demás con su eventID), igual que si el comprador
         tocara el botón de la app. Nunca se llama a una función interna de la app ni se dispara un
         evento del píxel a mano. Sin EasySell (o con su botón desactivado) la barra agrega al
         carrito, como siempre. */
      var TRIGGERS = ['#es-popup-button', '.es-popup-button', '#es-sticky'];
      var STICKY_BUTTON = '.sticky-add-to-cart__button';
      var STICKY_LABEL = '.add-to-cart-text__content > span:first-child';

      function codTrigger() {
        for (var i = 0; i < TRIGGERS.length; i++) {
          var el = document.querySelector(TRIGGERS[i]);
          if (el && el.disabled !== true && el.getAttribute('aria-disabled') !== 'true') return el;
        }
        return null;
      }

      function codTitle(trigger) {
        var title = trigger.querySelector('.es-button-title') || document.querySelector('#es-popup-button .es-button-title');
        return title ? title.textContent.trim() : '';
      }

      /* El texto del botón del tema sigue al de EasySell (el tema lo reescribe al cambiar de
         variante: el observador global vuelve a pasar por aquí). */
      function syncStickyBar() {
        var trigger = codTrigger();
        document.documentElement.classList.toggle('df-es-cod', Boolean(trigger));
        /* El contenedor del «Agregar al carrito» que EasySell ocultó (por su hoja, no inline): se
           marca para que el CSS lo saque de la fila. Si el botón vuelve a verse, se desmarca. */
        var atc = document.querySelector('.product-form-buttons [ref="addToCartButton"]');
        var slot = atc ? atc.closest('.product-form-buttons > *') : null;
        if (slot) {
          var empty = Boolean(trigger) && window.getComputedStyle(atc).display === 'none';
          if (slot.hasAttribute('data-df-es-empty') !== empty) slot.toggleAttribute('data-df-es-empty', empty);
        }
        var label = document.querySelector(STICKY_BUTTON + ' ' + STICKY_LABEL);
        if (!label) return;
        var text = trigger ? codTitle(trigger) : '';
        if (text) {
          if (!('dfEsOriginal' in label.dataset)) label.dataset.dfEsOriginal = label.textContent;
          if (label.textContent !== text) label.textContent = text;
        } else if ('dfEsOriginal' in label.dataset && label.textContent !== label.dataset.dfEsOriginal) {
          label.textContent = label.dataset.dfEsOriginal;
        }
      }

      /* En captura sobre window: corre antes que el delegado del tema (on:click, captura en
         document), así la barra no agrega al carrito ni dispara el AddToCart de ese clic. */
      window.addEventListener(
        'click',
        function (event) {
          var button = event.target instanceof Element ? event.target.closest(STICKY_BUTTON) : null;
          if (!button || button.disabled) return;
          var trigger = codTrigger();
          if (!trigger) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          trigger.click();
        },
        true
      );

      /* ---- Brillo del botón que abre el formulario ----
         Cuando el botón entra en pantalla (60% visible), dos pasadas del brillo en ~3 s y se detiene:
         nada se mueve solo más de 5 s seguidos (WCAG 2.2.2). Vuelve si el botón sale y entra otra
         vez, hasta 3 veces por visita. Sin movimiento con prefers-reduced-motion, sin
         IntersectionObserver o si el comerciante ya activó la animación propia de EasySell
         (cart-shaker). Solo atributos data-: el botón, su id y su clic quedan como los deja la app. */
      var MOTION = {% if settings.df_easysell_motion == false %}false{% else %}true{% endif %};
      var SHINE = 'data-df-es-shine';
      var SHINE_TIMES = 3;
      var shineShown = 0;

      function shine(button) {
        if (button.hasAttribute(SHINE)) return;
        button.setAttribute(SHINE, '');
        setTimeout(function () {
          button.removeAttribute(SHINE);
        }, 1000);
      }

      function watchShine() {
        if (!MOTION || !('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var button = document.getElementById('es-popup-button');
        if (!button || button.hasAttribute('data-df-es-motion') || button.classList.contains('cart-shaker')) return;
        button.setAttribute('data-df-es-motion', '');
        var seen = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (!entries[i].isIntersecting || shineShown >= SHINE_TIMES) continue;
              shineShown++;
              setTimeout(shine, 400, button);
              setTimeout(shine, 2400, button);
            }
            if (shineShown >= SHINE_TIMES) seen.disconnect();
          },
          { threshold: 0.6 }
        );
        seen.observe(button);
      }

      function start() {
        tokens = readTokens();
        watchShine();
        syncStickyBar();
        if (!tokens) {
          new MutationObserver(syncStickyBar).observe(document.documentElement, { childList: true, subtree: true });
          return;
        }
        paintAll();
        /* La app monta sus nodos después y los vuelve a montar al actualizar el carrito. Solo
           childList: una clase que cambia (la animación) nunca cambia el color. */
        new MutationObserver(paintAll).observe(document.documentElement, { childList: true, subtree: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
{%- endif -%}
