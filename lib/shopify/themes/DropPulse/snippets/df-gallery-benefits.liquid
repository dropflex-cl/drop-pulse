{%- doc -%}
  Beneficios escritos por save_landing_content (listing.gallery_benefits).
  Selección por URL igual que título/bajada; los textos siempre llegan escapados.
  @param {object} product
{%- enddoc -%}
{%- assign df_variants = product.metafields.dropflex.landing_listing.value -%}
{%- if df_variants.first.key != blank -%}
  <df-landing-content class="df-gallery-benefits-host" data-df-component="df-gallery-benefits">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-gallery-benefits-content', product: product, content: df_default.content %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-gallery-benefits-content', product: product, content: df_variant.content %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  <div class="df-gallery-benefits-host">{% render 'df-gallery-benefits-content', product: product %}</div>
{%- endif -%}

{% stylesheet %}
  /* Serena: imagen y tres tarjetas laterales; miniaturas debajo.
     Medidas: space-1/2/3, type-caption/label/metric-lg de design-system/tokens.json.
     Proporción 3:1 derivada de las capturas de Serena. */
  .df-gallery-benefits-host:not(:has(.df-gallery-benefits)) { display: none; }

  .df-gallery-benefits-host,
  .df-gallery-benefits-host > [data-df-active] {
    min-width: 0;
    height: 100%;
  }

  .df-gallery-benefits {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 8px;
    height: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .df-gallery-benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px 4px;
    border-radius: var(--df-radius-media);
    background: var(--df-accent-soft);
    color: var(--df-fg);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    text-align: center;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .df-gallery-benefits__item .df-icon {
    width: 28px;
    height: 28px;
    color: var(--df-accent-ink);
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits),
  .df-gallery-preview__hero:has(.df-gallery-benefits) {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 12px;
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits) > slideshow-slides {
    min-width: 0;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits) slideshow-slide {
    --gallery-aspect-ratio: 3 / 4;
    max-height: none;
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits) .product-media-constraint-wrapper {
    max-width: 100%;
    width: 100%;
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits) .product-media__image {
    object-fit: contain;
  }

  .product-information media-gallery slideshow-container:has(.df-gallery-benefits) > slideshow-arrows {
    width: calc((100% - 12px) * 3 / 4);
  }

  .product-information media-gallery .slideshow-control[aria-selected="true"] {
    outline-color: var(--df-accent-ink);
  }

  .df-gallery-preview__image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  .df-gallery-preview__hero:has(.df-gallery-benefits) .df-gallery-preview__image { aspect-ratio: 3 / 4; }
  .df-gallery-preview__image img { width: 100%; height: 100%; object-fit: contain; }

  .df-gallery-preview { padding-inline: var(--df-gutter); }

  .df-gallery-preview__thumbnails {
    display: flex;
    gap: 8px;
    padding-block: 12px 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  .df-gallery-preview__thumbnail {
    /* 64 px: miniaturas del theme en df-design-system. 44 px: size-touch. */
    flex: 0 0 64px;
    min-height: 44px;
    aspect-ratio: 1;
    border: 0;
    padding: 4px;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
    cursor: pointer;
    scroll-snap-align: start;
  }

  .df-gallery-preview__thumbnail[aria-pressed="true"] { box-shadow: inset 0 0 0 2px var(--df-accent-ink); }
  .df-gallery-preview__thumbnail:focus-visible { outline: 2px solid var(--df-accent-ink); outline-offset: 2px; }
  .df-gallery-preview__thumbnail img { width: 100%; height: 100%; object-fit: contain; border-radius: var(--df-radius-sm); }

  @media (max-width: 749px) {
    .product-information media-gallery slideshow-container:has(.df-gallery-benefits) > slideshow-arrows {
      inset-inline-start: var(--df-gutter);
      width: calc((100% - var(--df-gutter) * 2 - 12px) * 3 / 4);
    }
  }

  @media (min-width: 750px) {
    .df-gallery-benefits__item { font-size: 13px; line-height: 18px; }
  }
{% endstylesheet %}
