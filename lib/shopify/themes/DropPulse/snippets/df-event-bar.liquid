{%- doc -%}
  DropFlex · Eventos: la barra del evento, arriba de todo (layout/theme.liquid, antes del header).
  Colores del evento, con contraste AA probado en DropFlex (lib/events/catalog.ts).

  Dos formas, según la intensidad (lib/events/catalog.ts › INTENSITY_LAYERS):
    sutil          El aviso del evento en una línea (con adorno si la intensidad es total).
    media o total  Título («CYBER MONDAY») + el ahorro REAL del producto a la izquierda y la cuenta
                   regresiva en cajas (días, horas, minutos, segundos) a la derecha. El aviso pasa
                   a la cinta de debajo (df-event-ticker).

  REGLAS:
  - El reloj cuenta hasta el término REAL del evento, el mismo para todos. Nunca se reinicia.
  - En la antesala el reloj también cuenta hasta el TÉRMINO (nunca hasta el inicio: eso le dice al
    comprador que espere). Es honesto porque el precio de la antesala es el mismo del evento y
    termina con él. Sin ahorro que mostrar, la antesala dice «Precio Cyber adelantado · ya
    disponible» bajo el título.
  - El ahorro sale de compare_at_price de las variantes; sin tachado no se dice nada.
  Liquid dibuja las cifras con la hora del servidor; df-event.js las corrige cada segundo (el HTML
  puede venir de la caché de Shopify).

  Movimiento (docs/spec-movimiento-tienda.md, el mismo patrón del brillo del botón de EasySell):
  al estar en pantalla, una franja de luz cruza la barra dos veces y se detiene; hasta 3 veces por
  visita. En las últimas 48 h las cajas laten 3 veces con la primera pasada y quedan con el borde
  marcado. Las cifras cambian sin animar. Nada con prefers-reduced-motion ni con data-df-motion="off".
{%- enddoc -%}
{%- if request.page_type == 'product' and product != blank -%}
  {%- capture df_i -%}{% render 'df-event-pick', product: product %}{%- endcapture -%}
  {%- if df_i != blank -%}
    {%- liquid
      assign df_i = df_i | plus: 0
      assign ev = product.metafields.dropflex.event.value.events[df_i]
    -%}
    {{ 'df-components.css' | asset_url | stylesheet_tag }}
    {%- if ev.countdown_during != blank -%}
      {%- liquid
        assign df_now = 'now' | date: '%s' | plus: 0
        assign df_start = ev.start | plus: 0
        assign df_end = ev.to | plus: 0
        assign df_early_fallback = 'Precio ' | append: ev.name | append: ' ya disponible'
        assign df_early = ev.early_label | default: df_early_fallback
        assign df_headline = ev.headline | default: ev.name

        comment
          Ahorro real: el mayor % entre las variantes con tachado. Si no todas ahorran lo mismo, «hasta».
        endcomment
        assign df_pc_max = 0
        assign df_pc_min = 100
        for v in product.variants
          assign v_pc = 0
          if v.compare_at_price > v.price
            assign v_pc = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
          endif
          if v_pc > df_pc_max
            assign df_pc_max = v_pc
          endif
          if v_pc < df_pc_min
            assign df_pc_min = v_pc
          endif
        endfor

        assign df_left = df_end | minus: df_now
        if df_left < 0
          assign df_left = 0
        endif
        assign df_d = df_left | divided_by: 86400
        assign df_h = df_left | modulo: 86400 | divided_by: 3600
        assign df_m = df_left | modulo: 3600 | divided_by: 60
        assign df_s = df_left | modulo: 60
        assign df_early_phase = false
        assign df_urgent = false
        if df_now < df_start
          assign df_early_phase = true
        endif
        if df_left <= 172800
          assign df_urgent = true
        endif
      -%}
      <aside
        class="df df-event-bar df-event-bar--clock{% if df_urgent %} df-event-bar--urgent{% endif %} df-ev-only"
        aria-label="{{ ev.name | escape }}"
        data-df-event-clock
        data-start="{{ df_start }}"
        data-end="{{ df_end }}"
        data-during="{{ ev.countdown_during | escape }}"
      >
        <div class="df-event-bar__inner">
          <div class="df-event-bar__lead">
            <p class="df-event-bar__headline">
              <span>{{ df_headline | escape }}</span>
              {%- if ev.decor != blank -%}
                {% render 'df-event-decor', name: ev.decor %}
              {%- endif -%}
            </p>
            {%- if df_pc_max > 0 -%}
              <p class="df-event-bar__sub">
                {%- if df_pc_min < df_pc_max -%}Ahorra hasta {{ df_pc_max }} %{%- else -%}Ahorra {{ df_pc_max }} %{%- endif -%}
              </p>
            {%- else -%}
              <p class="df-event-bar__sub" data-df-clock-early{% unless df_early_phase %} hidden{% endunless %}>{{ df_early | escape }}</p>
            {%- endif -%}
          </div>
          <div class="df-event-bar__clock">
            <p class="df-visually-hidden" data-df-clock-sr>
              {{- ev.countdown_during | escape }} {{ df_d }} días, {{ df_h }} horas y {{ df_m }} minutos
            </p>
            <div class="df-event-bar__boxes" aria-hidden="true">
              <span class="df-event-bar__box"><span class="df-event-bar__num" data-unit="d">{% if df_d < 10 %}0{% endif %}{{ df_d }}</span><span class="df-event-bar__unit">Días</span></span>
              <span class="df-event-bar__sep">:</span>
              <span class="df-event-bar__box"><span class="df-event-bar__num" data-unit="h">{{ df_h | prepend: '0' | slice: -2, 2 }}</span><span class="df-event-bar__unit">Hrs</span></span>
              <span class="df-event-bar__sep">:</span>
              <span class="df-event-bar__box"><span class="df-event-bar__num" data-unit="m">{{ df_m | prepend: '0' | slice: -2, 2 }}</span><span class="df-event-bar__unit">Min</span></span>
              <span class="df-event-bar__sep">:</span>
              <span class="df-event-bar__box"><span class="df-event-bar__num" data-unit="s">{{ df_s | prepend: '0' | slice: -2, 2 }}</span><span class="df-event-bar__unit">Seg</span></span>
            </div>
          </div>
        </div>
      </aside>
    {%- else -%}
      <aside class="df df-event-bar df-ev-only" aria-label="{{ ev.name | escape }}">
        {%- if ev.decor != blank -%}
          {% render 'df-event-decor', name: ev.decor %}
        {%- endif -%}
        <p class="df-event-bar__text">{{ ev.announcement | escape }}</p>
        {%- if ev.decor != blank -%}
          {% render 'df-event-decor', name: ev.decor %}
        {%- endif -%}
      </aside>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* .df.df-event-bar: df-components.css (que pone el color de .df) se carga después y le ganaría. */
  .df.df-event-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px var(--df-gutter);
    background: var(--df-event-surface, var(--df-fg));
    color: var(--df-event-on-surface, var(--df-bg));
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
  }

  .df-event-bar__text {
    margin: 0;
    text-wrap: balance;
  }

  .df-event-bar .df-event-decor {
    flex: none;
    width: 18px;
    height: 18px;
  }

  /* Con cuenta regresiva: título y ahorro a la izquierda, reloj en cajas a la derecha. */
  .df.df-event-bar--clock {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 10px;
    text-align: start;
  }

  .df-event-bar__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    max-width: 40rem;
  }

  .df-event-bar__lead {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .df-event-bar__headline {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* El adorno sigue a la última palabra aunque el título use dos líneas. */
  .df-event-bar__headline .df-event-decor {
    display: inline-block;
    margin-inline-start: 6px;
    vertical-align: -3px;
  }

  .df-event-bar__sub {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .df-event-bar__sub[hidden] {
    display: none;
  }

  /* Teléfono: junto a las cajas solo cabe una línea corta. El texto de la antesala sigue bajo el
     precio (df-event-countdown) y el adorno sale para que el título no se parta por él. */
  @media (max-width: 749px) {
    .df-event-bar__sub[data-df-clock-early],
    .df-event-bar--clock .df-event-bar__headline .df-event-decor {
      display: none;
    }

    /* Un título de una sola palabra larga («CYBERMONDAY») cabe junto a las cajas en 375 px; si
       igual no cabe, se parte antes que montarse sobre el reloj. */
    .df-event-bar__headline {
      font-size: 14px;
      letter-spacing: 0.02em;
      overflow-wrap: anywhere;
    }

    /* Sin los «:» en el teléfono: las cajas ya separan las cifras y el título gana ~30 px. */
    .df-event-bar__sep {
      display: none;
    }

    .df-event-bar__boxes {
      gap: 5px;
    }

    .df-event-bar__box {
      min-width: 42px;
    }
  }

  .df-event-bar__boxes {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .df-event-bar__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    padding: 5px 4px 4px;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  /* Últimas 48 h: el borde de las cajas, marcado (sin movimiento). */
  .df-event-bar--urgent .df-event-bar__box {
    border-color: currentColor;
  }

  .df-event-bar__num {
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .df-event-bar__unit {
    margin-top: 3px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .df-event-bar__sep {
    font-weight: 800;
    opacity: 0.6;
  }

  /* Brillo: df-event.js pone data-df-shine (y data-df-beat en la primera pasada de las últimas 48 h).
     La franja va detrás del texto (z-index 0) y es del color del texto, así sirve en fondo claro u
     oscuro sin tocar el contraste de las cifras. */
  .df-event-bar--clock::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 30%, color-mix(in srgb, currentColor 22%, transparent) 50%, transparent 70%);
    transform: translateX(-120%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-df-motion='off']) .df-event-bar--clock[data-df-shine]::after {
      /* La curva del brillo de EasySell: pareja, para que se vea cruzar (ease-standard frena tanto
         que la franja recorre casi todo el ancho en 200 ms y parece un destello). */
      animation: df-event-bar-shine 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    :root:not([data-df-motion='off']) .df-event-bar--urgent[data-df-beat] .df-event-bar__box {
      animation: df-event-bar-beat 900ms var(--df-ease, cubic-bezier(0.22, 1, 0.36, 1)) 3;
    }
  }

  @keyframes df-event-bar-shine {
    to {
      transform: translateX(120%);
    }
  }

  @keyframes df-event-bar-beat {
    50% {
      transform: scale(1.06);
    }
  }

  @media (min-width: 750px) {
    .df-event-bar__headline {
      font-size: 17px;
    }

    .df-event-bar__box {
      min-width: 52px;
    }

    .df-event-bar__num {
      font-size: 24px;
    }

    .df-event-bar__boxes {
      gap: 6px;
    }
  }
{% endstylesheet %}
