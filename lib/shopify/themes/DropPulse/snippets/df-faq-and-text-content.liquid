{%- doc -%}
  Render de contenido aprobado; los datos reales siguen saliendo de Shopify.
  @param {object} product
  @param {object} section
  @param {object} [block]
  @param {object} [content]
  @param {object} [df_variant]
{%- enddoc -%}
{%- comment -%}
  DropFlex · Preguntas frecuentes con texto (faq-and-text). Sección del tercio inferior de la
  landing, antes del último llamado: a la izquierda un texto (antetítulo, título con una palabra
  en acento, bajada, prueba social real y botón opcional); a la derecha un acordeón de preguntas
  con <details>/<summary> nativos.

  Dos ejes de diseño (las 3 variantes de la referencia): tarjeta alrededor de la sección sí/no y
  estilo de ítem divisores/tarjetas.

  REGLA: los datos de política dentro de las respuestas son tokens que se llenan con datos reales:
  {min} {max} días hábiles (logística) · {return_days} · {warranty_months} (políticas). Una
  pregunta con un token sin dato NO se muestra. La prueba social usa {count} y {rating} del
  resumen real de reseñas; sin resumen, se oculta.

  Contenido: metafield `dropflex.faq_and_text` (json) → si falta, los ajustes y bloques «Pregunta».
    { eyebrow?, heading, heading_highlight?, body?, cta_label?, social_proof_text?,
      items[{ question, answer, topic }] }
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  if product == blank
    assign product = s.product
  endif
  # content llega de la variante seleccionada (o del objeto legacy).
  assign logistics = shop.metafields.dropflex.logistics.value
  assign policies = shop.metafields.dropflex.policies.value
  assign summary = product.metafields.dropflex.review_summary.value

  # Datos reales para los tokens.
  assign days_min = nil
  assign days_max = nil
  if logistics.transit_days_min != blank
    assign handling = logistics.handling_days | default: 0 | plus: 0
    assign days_min = logistics.transit_days_min | plus: handling
    assign days_max = logistics.transit_days_max | default: logistics.transit_days_min | plus: handling
    if days_max < days_min
      assign days_max = days_min
    endif
  endif
  assign return_days = policies.return_days
  assign warranty_months = policies.warranty_months

  if content.items.size > 0
    assign items = content.items
    assign eyebrow = content.eyebrow
    assign heading = content.heading | default: s.heading
    assign highlight = content.heading_highlight
    assign body = content.body
    assign cta_label = content.cta_label
    assign social_text = content.social_proof_text
  else
    assign items = section.blocks
    assign eyebrow = s.eyebrow
    assign heading = s.heading
    assign highlight = s.heading_highlight
    assign body = s.body
    assign cta_label = s.cta_label
    assign social_text = s.social_proof_text
  endif

  # Título con la palabra en acento: se escapa primero y se envuelve solo la primera aparición.
  assign heading_html = heading | escape
  if highlight != blank and heading contains highlight
    assign highlight_esc = highlight | escape
    capture highlight_html
      echo '<span class="df-faq-and-text__highlight">'
      echo highlight_esc
      echo '</span>'
    endcapture
    assign heading_html = heading_html | replace_first: highlight_esc, highlight_html
  endif

  # Prueba social: solo con el resumen real de reseñas. Un token sin dato oculta el texto.
  assign social_html = nil
  if s.show_social_proof and social_text != blank
    if summary.count > 0
      assign rating_text = summary.rating | round: 1 | append: '' | replace: '.', ','
      assign social_text = social_text | replace: '{count}', summary.count | replace: '{rating}', rating_text
    endif
    unless social_text contains '{'
      assign social_html = social_text | escape
    endunless
  endif

  assign cta_href = s.cta_link
  if cta_href == blank and product != blank
    assign cta_href = product.url
  endif

  assign bg = s.background
  assign bg_hex = nil
  assign dark_bg = false
  if bg != blank and bg.alpha != 0
    assign bg_hex = bg | color_to_hex
    assign bg_brightness = bg | color_brightness
    if bg_brightness < 128
      assign dark_bg = true
    endif
  endif

  assign sep = '~|~'
  assign group_name = 'df-faq-' | append: section.id
  assign rendered = 0
  assign ld_items = ''
-%}

{%- capture items_html -%}
  {%- for item in items limit: 8 -%}
    {%- liquid
      # Un bloque del editor trae settings; un ítem del metafield trae las claves directas.
      if item.settings != blank
        assign question = item.settings.question
        assign answer = item.settings.answer
        assign item_attrs = item.shopify_attributes
      else
        assign question = item.question
        assign answer = item.answer
        assign item_attrs = ''
      endif
      if question == blank or answer == blank
        continue
      endif

      assign joined = question | append: sep | append: answer
      if days_min != blank
        assign joined = joined | replace: '{min}', days_min | replace: '{max}', days_max
      endif
      if return_days != blank
        assign joined = joined | replace: '{return_days}', return_days
      endif
      if warranty_months != blank
        assign joined = joined | replace: '{warranty_months}', warranty_months
      endif
      if joined contains '{'
        continue
      endif
      assign parts = joined | split: sep
      assign question = parts[0]
      assign answer = parts[1]

      assign rendered = rendered | plus: 1
      capture ld_item
        echo '{"@type":"Question","name":'
        echo question | json
        echo ',"acceptedAnswer":{"@type":"Answer","text":'
        echo answer | json
        echo '}}'
      endcapture
      if ld_items != ''
        assign ld_items = ld_items | append: ','
      endif
      assign ld_items = ld_items | append: ld_item
    -%}
    <details
      class="df-faq-and-text__item"
      data-df-reveal
      {% if s.exclusive %}name="{{ group_name }}"{% endif %}
      {% if s.open_first and rendered == 1 %}open{% endif %}
      {{ item_attrs }}
    >
      <summary class="df-faq-and-text__question">
        <span>{{ question | escape }}</span>
        <span class="df-faq-and-text__sign" aria-hidden="true"></span>
      </summary>
      <div class="df-faq-and-text__answer">
        <p class="df-text">{{ answer | escape | newline_to_br }}</p>
      </div>
    </details>
  {%- endfor -%}
{%- endcapture -%}

{%- if rendered > 0 or request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}

  {%- if s.exclusive -%}

  {%- endif -%}

  <df-faq-and-text
    class="df df-faq-and-text df-faq-and-text--{{ s.item_style }}{% if s.card %} df-faq-and-text--card{% endif %}"
    style="{% render 'df-accent-vars', product: product, background: bg_hex %} padding-block: calc({{ s.padding_top }}px * var(--df-space, 1)) calc({{ s.padding_bottom }}px * var(--df-space, 1)); --df-faq-left: {{ s.left_width }}%;{% if bg_hex != blank %} --df-bg: {{ bg_hex }}; background: {{ bg_hex }};{% endif %}{% if dark_bg %} --df-fg: #ffffff;{% endif %}"
    {% if s.exclusive %}data-exclusive{% endif %}
  >
    <div class="df-faq-and-text__inner">
      {%- if rendered == 0 -%}
        <p class="df-placeholder">
          Preguntas frecuentes: agrega preguntas o publica el contenido desde DropFlex. Las respuestas con un dato de política que falta ({return_days}, {min}, {max}) no se muestran.
        </p>
      {%- else -%}
        <div class="df-faq-and-text__intro" data-df-reveal>
          {%- if eyebrow != blank -%}
            <p class="df-eyebrow">{{ eyebrow | escape }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="df-heading df-faq-and-text__heading">{{ heading_html }}</h2>
          {%- endif -%}
          {%- if body != blank -%}
            <p class="df-text df-faq-and-text__body">{{ body | escape | newline_to_br }}</p>
          {%- endif -%}

          {%- liquid
            assign avatar_count = 0
            if s.show_social_proof
              if s.avatar_1 != blank
                assign avatar_count = avatar_count | plus: 1
              endif
              if s.avatar_2 != blank
                assign avatar_count = avatar_count | plus: 1
              endif
              if s.avatar_3 != blank
                assign avatar_count = avatar_count | plus: 1
              endif
            endif
          -%}
          {%- if social_html != blank or avatar_count > 0 -%}
            <div class="df-faq-and-text__proof">
              {%- if avatar_count > 0 -%}
                <ul class="df-faq-and-text__avatars" role="list">
                  {%- for n in (1..3) -%}
                    {%- assign key = 'avatar_' | append: n -%}
                    {%- if s[key] != blank -%}
                      <li>
                        {{
                          s[key]
                          | image_url: width: 132, height: 132, crop: 'center'
                          | image_tag: widths: '44, 88, 132', sizes: '44px', alt: '', loading: 'lazy', class: 'df-faq-and-text__avatar'
                        }}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if social_html != blank -%}
                <div class="df-faq-and-text__proof-text">
                  {%- if summary.count > 0 -%}
                    {% render 'df-stars', rating: summary.rating, size: '0.875rem' %}
                  {%- endif -%}
                  <p class="df-faq-and-text__proof-line">{{ social_html }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if cta_label != blank and cta_href != blank -%}
            <a class="df-faq-and-text__cta df-press" href="{{ cta_href }}">{{ cta_label | escape }}</a>
          {%- endif -%}
        </div>

        <div class="df-faq-and-text__list">
          {{ items_html }}
        </div>
      {%- endif -%}
    </div>

    {%- if s.emit_schema and rendered > 0 -%}
      <script type="application/ld+json">
        {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ ld_items }}]}
      </script>
    {%- endif -%}
  </df-faq-and-text>

{%- endif -%}
