{%- doc -%}
  DropFlex · íconos de línea (24×24, trazo 1.75, currentColor).

  Las claves son un contrato con la app: la IA elige de esta lista (ICON_KEYS en
  lib/shopify/components/catalog.ts) y nunca escribe SVG. Una clave desconocida no dibuja nada.
  Agregar un ícono = agregarlo aquí Y en ICON_KEYS; el test de catálogo exige que coincidan.

  @param {string} name - Clave del ícono (check, truck, shield…)
  @param {string} [class] - Clases extra

  @example
  {% render 'df-icon', name: 'truck' %}
{%- enddoc -%}
{%- liquid
  case name
    when 'check'
      assign d = '<path d="M5 12.5l4.5 4.5L19 7.5"/>'
    when 'check-circle'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.8 2.8L16.2 9.6"/>'
    when 'x-circle'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>'
    when 'truck'
      assign d = '<path d="M3 6.5h11v9H3zM14 9.5h4l3 3.2v2.8h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>'
    when 'package'
      assign d = '<path d="M12 3l8 4.2v9.6L12 21l-8-4.2V7.2z"/><path d="M4 7.2l8 4.3 8-4.3M12 11.5V21"/>'
    when 'home'
      assign d = '<path d="M4 11l8-6.5 8 6.5M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/>'
    when 'cart'
      assign d = '<path d="M3 4h2.5l2.2 11h10.6L20 7.5H6.4"/><circle cx="9" cy="19.2" r="1.3"/><circle cx="17" cy="19.2" r="1.3"/>'
    when 'cash'
      assign d = '<rect x="3" y="6.5" width="18" height="11" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6.5 9.5v.01M17.5 14.5v.01"/>'
    when 'shield'
      assign d = '<path d="M12 3l7 3v5.5c0 4.4-3 8.1-7 9.5-4-1.4-7-5.1-7-9.5V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>'
    when 'lock'
      assign d = '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 018 0v2.5"/>'
    when 'return'
      assign d = '<path d="M9 7H15.5a4.5 4.5 0 010 9H8"/><path d="M11.5 4L8.5 7l3 3"/>'
    when 'clock'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>'
    when 'calendar'
      assign d = '<rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>'
    when 'star'
      assign d = '<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9l-5.2 2.8 1-5.9-4.3-4.1 5.9-.8z"/>'
    when 'heart'
      assign d = '<path d="M12 19.5s-7.5-4.4-7.5-10A4.2 4.2 0 0112 7a4.2 4.2 0 017.5 2.5c0 5.6-7.5 10-7.5 10z"/>'
    when 'sparkles'
      assign d = '<path d="M11 4l1.6 4.4L17 10l-4.4 1.6L11 16l-1.6-4.4L5 10l4.4-1.6zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/>'
    when 'bolt'
      assign d = '<path d="M13 3L5 13.5h6L10.5 21 19 10h-6z"/>'
    when 'leaf'
      assign d = '<path d="M5 19c0-8.5 5.5-14 15-14 0 9.5-5.5 15-14 15"/><path d="M5 19l7-7"/>'
    when 'droplet'
      assign d = '<path d="M12 3.5s6 6.4 6 10.5a6 6 0 01-12 0c0-4.1 6-10.5 6-10.5z"/>'
    when 'sun'
      assign d = '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>'
    when 'moon'
      assign d = '<path d="M19.5 14.5A8 8 0 019.5 4.5a8 8 0 1010 10z"/>'
    when 'battery'
      assign d = '<rect x="3" y="7.5" width="16" height="9" rx="2"/><path d="M21 10.5v3M6.5 10.5v3M9.5 10.5v3"/>'
    when 'feather'
      assign d = '<path d="M19 5c-6 0-11 5-11 11v3h3c6 0 11-5 11-11V5z"/><path d="M5 20l9-9"/>'
    when 'ruler'
      assign d = '<path d="M3.5 16.5L16.5 3.5l4 4-13 13z"/><path d="M8 12l2 2M11 9l2 2M14 6l2 2"/>'
    when 'target'
      assign d = '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".6"/>'
    when 'thumbs-up'
      assign d = '<path d="M7.5 10.5V20H4.5v-9.5zM7.5 10.5L11.5 3a2 2 0 012.3 2.3L13 9.5h5.3a2 2 0 012 2.4l-1.4 6.5a2 2 0 01-2 1.6H7.5"/>'
    when 'users'
      assign d = '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5a5.5 5.5 0 0111 0"/><path d="M15.5 5.6a3.2 3.2 0 010 5.8M17.5 14.4a5.5 5.5 0 013 5.1"/>'
    when 'chat'
      assign d = '<path d="M20 12a7.5 7.5 0 01-11 6.6L4.5 20l1.4-4A7.5 7.5 0 1120 12z"/>'
    when 'gift'
      assign d = '<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11M12 9S10.5 4 8 4.8C6 5.5 7.5 9 12 9zM12 9s1.5-5 4-4.2C18 5.5 16.5 9 12 9z"/>'
    when 'fire'
      assign d = '<path d="M12 21c-3.6 0-6.5-2.6-6.5-6.2 0-3.9 3.2-5.8 4-10.3 2.7 1.6 4.4 4 4.8 6.6.8-.7 1.3-1.8 1.4-2.9 1.7 1.6 2.8 4 2.8 6.6 0 3.6-2.9 6.2-6.5 6.2z"/>'
    when 'eye'
      assign d = '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>'
    when 'hand'
      assign d = '<path d="M8 12V5.5a1.5 1.5 0 013 0V11M11 10V4a1.5 1.5 0 013 0v6.5M14 10.5V6a1.5 1.5 0 013 0v7.5c0 4-2.5 7-6.5 7-2.6 0-4-1.3-5.6-3.6L3.5 14a1.5 1.5 0 012.3-1.9L8 14"/>'
    when 'globe'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"/>'
    when 'award'
      assign d = '<circle cx="12" cy="9" r="5.5"/><path d="M8.7 13.4L7.5 21l4.5-2.5 4.5 2.5-1.2-7.6"/>'
    when 'phone'
      assign d = '<path d="M6.5 3.5h3l1.5 4.5-2 1.3a11 11 0 005.7 5.7l1.3-2 4.5 1.5v3a2 2 0 01-2 2A16.5 16.5 0 014.5 5.5a2 2 0 012-2z"/>'
    when 'headset'
      assign d = '<path d="M4.5 14v-2a7.5 7.5 0 0115 0v2"/><rect x="3.5" y="13.5" width="4" height="6" rx="1.5"/><rect x="16.5" y="13.5" width="4" height="6" rx="1.5"/><path d="M18.5 19.5c0 1.2-1.5 2-3.5 2h-2"/>'
    when 'flag'
      assign d = '<path d="M5 21V4M5 4.5c4-2 7 2 14 0v9c-7 2-10-2-14 0"/>'
    when 'chevron-left'
      assign d = '<path d="M15 5l-7 7 7 7"/>'
    when 'chevron-right'
      assign d = '<path d="M9 5l7 7-7 7"/>'
    when 'arrow-right'
      assign d = '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>'
    when 'x'
      assign d = '<path d="M6 6l12 12M18 6L6 18"/>'
    when 'minus'
      assign d = '<path d="M5.5 12h13"/>'
    when 'play'
      assign d = '<path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/>'
    when 'pause'
      assign d = '<path d="M8.5 5.5v13M15.5 5.5v13" stroke-width="2.5"/>'
    when 'volume'
      assign d = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4 4 0 010 6M18 6.5a7.5 7.5 0 010 11"/>'
    when 'volume-off'
      assign d = '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M16 9.5l5 5M21 9.5l-5 5"/>'
    else
      assign d = ''
  endcase
-%}
{%- if d != '' -%}
  <svg
    class="df-icon{% if class != blank %} {{ class }}{% endif %}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {{- d -}}
  </svg>
{%- endif -%}
