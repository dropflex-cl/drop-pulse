{%- doc -%}
 Estado vacío para clientes: visible sin datos, sin cifras ni prueba inventadas.
 @param {string} component
 @param {object} [product]
{%- enddoc -%}
{%- liquid
 case component
 when 'product-includes'
 assign heading = 'Qué incluye tu compra'
 assign body = 'Confirma aquí el contenido del paquete antes de comprar.'
 assign icon = 'package'
 when 'usage-steps'
 assign heading = 'Cómo se usa'
 assign body = 'Las instrucciones de uso estarán disponibles aquí.'
 assign icon = 'hand'
 when 'use-cases'
 assign heading = 'Elige cómo lo usarías'
 assign body = 'Consulta si este producto se adapta al uso que buscas.'
 assign icon = 'target'
 when 'before-after'
 assign heading = 'Mira la diferencia'
 assign body = 'Todavía no hay una comparación documentada para este producto.'
 assign icon = 'eye'
 when 'results-timeline'
 assign heading = 'Qué puedes esperar'
 assign body = 'Todavía no hay plazos de resultados documentados para este producto.'
 assign icon = 'calendar'
 when 'customer-stories'
 assign heading = 'Experiencias de compradores'
 assign body = 'Todavía no hay experiencias de compradores publicadas.'
 assign icon = 'users'
 when 'expert-endorsement'
 assign heading = 'Una opinión con respaldo'
 assign body = 'Todavía no hay una opinión profesional documentada para este producto.'
 assign icon = 'award'
 when 'mechanism'
 assign heading = 'Así funciona'
 assign body = 'Consulta las características de este producto antes de elegirlo.'
 assign icon = 'bolt'
 when 'guarantee'
 assign heading = 'Compra con confianza'
 assign body = 'Consulta las condiciones de cambios y garantía antes de comprar.'
 assign icon = 'shield'
 when 'offer-summary'
 assign heading = 'Elige tu pack'
 assign body = 'Consulta el precio y las opciones de compra en la ficha del producto.'
 assign icon = 'cart'
 when 'review-stars'
 assign heading = 'Opiniones de compradores'
 assign body = 'Todavía no hay suficientes reseñas publicadas.'
 assign icon = 'star'
 when 'benefit-usps'
 assign heading = 'Conoce el producto'
 assign body = 'Consulta sus características antes de comprar.'
 assign icon = 'check'
 when 'inventory'
 assign heading = 'Disponibilidad'
 assign body = 'La disponibilidad se confirma al elegir tu opción de compra.'
 assign icon = 'package'
 when 'shipping-timeline'
 assign heading = 'Entrega de tu pedido'
 assign body = 'El plazo de entrega se confirma al ingresar tu dirección.'
 assign icon = 'truck'
 when 'benefit-double-box'
 assign heading = 'Compra con confianza'
 assign body = 'Consulta las condiciones de compra disponibles.'
 assign icon = 'shield'
 when 'gif-strip'
 assign heading = 'El producto en acción'
 assign body = 'Todavía no hay una demostración publicada.'
 assign icon = 'play'
 when 'review-slider'
 assign heading = 'Experiencias de compradores'
 assign body = 'Todavía no hay suficientes reseñas publicadas.'
 assign icon = 'users'
 when 'ugc-slider'
 assign heading = 'Mira cómo se usa'
 assign body = 'Todavía no hay videos publicados.'
 assign icon = 'play'
 when 'pain-block'
 assign heading = 'Una solución para tu rutina'
 assign body = 'Consulta los usos y características de este producto.'
 assign icon = 'target'
 when 'stats-with-image'
 assign heading = 'Datos para elegir'
 assign body = 'Todavía no hay datos documentados publicados.'
 assign icon = 'award'
 when 'scrolling-benefits'
 assign heading = 'Razones para elegir'
 assign body = 'Consulta las características y condiciones disponibles.'
 assign icon = 'check'
 when 'image-with-benefits'
 assign heading = 'Conoce sus características'
 assign body = 'Todavía no hay características detalladas publicadas.'
 assign icon = 'eye'
 when 'insta-story'
 assign heading = 'Descubre el producto'
 assign body = 'Todavía no hay imágenes de uso publicadas.'
 assign icon = 'eye'
 when 'review-wall'
 assign heading = 'Opiniones de compradores'
 assign body = 'Todavía no hay suficientes reseñas publicadas.'
 assign icon = 'star'
 when 'comparison-table'
 assign heading = 'Compara antes de elegir'
 assign body = 'Todavía no hay una comparación documentada publicada.'
 assign icon = 'target'
 when 'faq-and-text'
 assign heading = 'Preguntas frecuentes'
 assign body = 'Consulta tus dudas antes de comprar.'
 assign icon = 'chat'
 endcase
-%}
{{ 'df-components.css' | asset_url | stylesheet_tag }}
<div class="df df-pdp-empty" data-df-empty="{{ component | escape }}" style="{% render 'df-accent-vars', product: product %}">
 {% render 'df-icon', name: icon %}
 <div><h2 class="df-heading">{{ heading | escape }}</h2><p class="df-text">{{ body | escape }}</p></div>
</div>
