<script>
// Solo selecciona HTML escapado y aprobado por DropFlex. Sin red, IA ni contenido de la URL.
(() => {
  if (window.DropFlexLanding) return;
  const valid = (value) => /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/.test(value || '');
  const selection = () => {
    const params = new URLSearchParams(location.search);
    const read = (name, legacy) => {
      const a = params.getAll(name), b = params.getAll(legacy);
      if (a.length > 1 || b.length > 1 || (a.length && b.length && a[0] !== b[0])) return '';
      const value = a[0] || b[0]; return valid(value) ? value : '';
    };
    const angle = read('angle', 'df_angle');
    return { angle, hook: angle ? read('hook', 'df_hook') : '' };
  };
  const mount = (host) => {
    if (!host?.matches('df-landing-content')) return;
    const active = host.querySelector(':scope > [data-df-active]');
    const templates = [...host.querySelectorAll(':scope > template[data-df-variant]')];
    if (!active || !templates.length) return;
    const { angle, hook } = selection();
    const component = ['df-title', 'df-subtitle', 'df-pack-offers'].includes(host.dataset.dfComponent)
      ? 'listing' : host.dataset.dfComponent?.replace(/^df-/, '');
    const binding = window.DropFlexPdp?.current?.sections.find((s) => s.component === component);
    const chosen = (binding ? templates.find((t) => t.dataset.dfVariant === binding.content_variant_key) : null)
      || (angle && hook ? templates.find((t) => t.dataset.angle === angle && t.dataset.hook === hook) : null)
      || (angle ? templates.find((t) => t.dataset.angle === angle && !t.dataset.hook) : null)
      || templates.find((t) => t.dataset.dfVariant === 'default');
    if (!chosen || host.dataset.dfSelected === chosen.dataset.dfVariant) return;
    // La versión default ya llegó del servidor. No remontarla evita reiniciar controles.
    if (chosen.dataset.dfVariant !== 'default' || host.dataset.dfSelected) {
      active.replaceChildren(chosen.content.cloneNode(true));
    }
    host.dataset.dfSelected = chosen.dataset.dfVariant;
    host.dispatchEvent(new CustomEvent('df:landing-selected', { bubbles: true, detail: {
      component: host.dataset.dfComponent, key: chosen.dataset.dfVariant, angle_id: chosen.dataset.angle || null, hook_id: chosen.dataset.hook || null,
    } }));
  };
  const scan = (root = document) => {
    if (root.matches?.('df-landing-content')) mount(root);
    root.querySelectorAll?.('df-landing-content').forEach(mount);
  };
  window.DropFlexLanding = { mount, scan, selection };
  document.addEventListener('DOMContentLoaded', () => scan());
  document.addEventListener('shopify:section:load', (event) => scan(event.target));
  window.addEventListener('popstate', () => scan());
})();

</script>
