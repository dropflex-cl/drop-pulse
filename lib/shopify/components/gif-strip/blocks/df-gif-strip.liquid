{%- assign df_conversion_product = closest.product | default: product | default: section.settings.product -%}
{%- unless df_conversion_product.metafields.dropflex.conversion_supports.value.disabled_components contains 'gif-strip' -%}
<div data-df-pdp-component="gif-strip">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.gif_strip.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
<script src="{{ 'df-gif-strip.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-gif-strip">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% if df_default.content.state == 'empty' %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% else %}{% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% if df_variant.content.state == 'empty' %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% else %}{% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% if df_variants.state == 'empty' %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% else %}{% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_variants %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'gif-strip', product: df_product %}{% endif %}
{%- endif -%}

</div>

{%- endunless -%}

{% stylesheet %}
  .df-gif-strip { display: block; }
  .df-gif-strip__header { margin-bottom: var(--df-gap); }
  .df-gif-strip__heading { margin: 8px 0 0; font-size: 1.25rem; }
  .df-gif-strip__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--df-gap); margin: 0; padding: 0; list-style: none; }
  .df-gif-strip__item { overflow: hidden; border-radius: var(--df-gif-radius, var(--df-radius)); background: var(--df-bg); }
  .df-gif-strip__figure { display: flex; flex-direction: column; margin: 0; }
  .df-gif-strip__intro { padding: 20px; background: var(--df-accent-soft); }
  .df-gif-strip__number { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 12px; color: var(--df-accent-ink); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .df-gif-strip__lead { margin: 0; font-family: var(--df-font-heading); font-weight: var(--df-font-heading-weight); font-size: clamp(1.375rem, 1.125rem + 1vw, 1.75rem); line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; }
  .df-gif-strip__frame { position: relative; display: grid; place-items: center; width: calc(100% - var(--df-gap) * 2); margin: var(--df-gap); aspect-ratio: 1; overflow: hidden; border-radius: var(--df-radius-media); background: var(--df-surface); }
  .df-gif-strip__frame img, .df-gif-strip__frame canvas { width: auto; height: auto; max-width: 100%; max-height: 100%; position: absolute; inset: 0; margin: auto; object-fit: contain; border-radius: var(--df-radius-media); }
  .df-gif-strip__frame[data-paused] img { visibility: hidden; }
  .df-gif-strip__playback { position: absolute; right: 12px; bottom: 12px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--df-hairline); border-radius: var(--df-radius-pill); background: var(--df-bg); color: var(--df-fg); font: inherit; font-size: 0.8125rem; cursor: pointer; }
  .df-gif-strip__playback span { display: flex; align-items: center; gap: 8px; }
  .df-gif-strip [hidden] { display: none; }
  .df-gif-strip__caption { flex: 1; padding: 0 20px 20px; font-size: 0.9375rem; line-height: 1.55; color: var(--df-muted); text-wrap: pretty; }
  .df-gif-strip__bullets { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .df-gif-strip__bullet { display: flex; align-items: flex-start; gap: 12px; color: var(--df-fg); }
  .df-gif-strip__bullet .df-icon { width: 20px; height: 20px; flex: none; margin-top: 2px; color: var(--df-accent-ink); }
{% endstylesheet %}

