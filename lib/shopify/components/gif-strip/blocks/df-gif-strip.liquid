<div data-df-pdp-component="gif-strip">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.gif_strip.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-gif-strip">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-gif-strip-content', product: df_product, section: section, block: block, content: df_variants %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-gif-strip {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .df-gif-strip__heading {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .df-gif-strip__list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-gif-strip__figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .df-gif-strip__lead {
    margin: 0;
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.0625rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .df-gif-strip__frame {
    display: block;
    overflow: hidden;
    border-radius: var(--df-gif-radius, 12px);
    background: var(--df-surface);
  }

  .df-gif-strip__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .df-gif-strip__caption {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--df-muted);
    text-wrap: pretty;
  }

  .df-gif-strip__bullets {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-gif-strip__bullet {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--df-fg);
  }

  .df-gif-strip__bullet .df-icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--df-accent-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · GIFs",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los GIF y sus textos vienen de DropFlex (dropflex.gif_strip_media y dropflex.gif_strip). Cada GIF lleva el texto de su misma posición. Sin GIF, el bloque no se muestra."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título del bloque",
      "info": "Opcional. Cada GIF ya trae su propio texto arriba y abajo."
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radio de los GIF",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "DropFlex · GIFs"
    }
  ]
}
{% endschema %}
