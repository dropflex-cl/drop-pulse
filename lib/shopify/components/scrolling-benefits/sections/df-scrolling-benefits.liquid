            { "value": "returns", "label": "Cambios o devolución" },
            { "value": "warranty", "label": "Garantía" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "delivery", "label": "Plazo de entrega" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Cinta ventajas",
      "blocks": [
        { "type": "item", "settings": { "icon": "cash", "text": "Pagas al recibir", "requires": "cod" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Llega en {min} a {max} días hábiles", "requires": "delivery" } },
