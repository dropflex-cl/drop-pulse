{%- comment -%}
  DropFlex · Cinta de beneficios (scrolling-benefits). Sección de ancho completo: una franja
  delgada con beneficios de servicio (ícono + texto corto) que se desplaza sin fin.

  REGLA: los beneficios son promesas de la tienda. Cada ítem puede atarse a una política real
  (`requires`) y sus números son tokens que llena la tienda; si la política o el dato falta, el
  ítem no se publica (lo decide snippets/df-scrolling-benefits-item.liquid).

  Contenido: metafield `dropflex.scrolling_benefits` (json) → si falta, los bloques «Beneficio».
    { heading?, items: [{ icon, text, requires? }] }
  Tokens: {min} {max} días hábiles (logística) · {return_days} · {warranty_months} · {threshold}.
  Datos: shop.metafields.dropflex.policies y shop.metafields.dropflex.logistics (json).

  Movimiento: <df-scrolling-benefits> (assets/df-scrolling-benefits.js) mide un set, clona los
  que falten para cubrir la pantalla y fija la duración según la velocidad en px/s. Sin JS, el CSS
  anima dos sets con una duración estimada. Con menos de 3 ítems o prefers-reduced-motion, la
  franja queda quieta y centrada.
{%- endcomment -%}
{%- liquid
  if product == blank
    assign product = section.settings.product
  endif
  assign s = section.settings
  assign content = product.metafields.dropflex.scrolling_benefits.value
  assign policies = shop.metafields.dropflex.policies.value
  assign logistics = shop.metafields.dropflex.logistics.value

  assign days_min = blank
  assign days_max = blank
  if logistics != blank
    assign handling = logistics.handling_days | plus: 0
    assign tmin = logistics.transit_days_min | plus: 0
    assign tmax = logistics.transit_days_max | plus: 0
    if tmax < tmin
      assign tmax = tmin
    endif
    assign days_min = handling | plus: tmin
    assign days_max = handling | plus: tmax
  endif

  assign heading = content.heading | default: s.heading
  if s.show_heading == false
    assign heading = blank
  endif
-%}

{%- liquid
  # Un set con los atributos del editor (el original) y otro sin ellos (las copias del loop).
  assign items_html = ''
  assign copy_html = ''
  if content.items.size > 0
    for item in content.items limit: 8
      capture one
        render 'df-scrolling-benefits-item', icon: item.icon, text: item.text, requires: item.requires, policies: policies, days_min: days_min, days_max: days_max
      endcapture
      assign items_html = items_html | append: one
    endfor
    assign copy_html = items_html
  else
    for block in section.blocks
      capture one
        render 'df-scrolling-benefits-item', icon: block.settings.icon, text: block.settings.text, requires: block.settings.requires, policies: policies, days_min: days_min, days_max: days_max
      endcapture
      assign copy_html = copy_html | append: one
      capture one
        render 'df-scrolling-benefits-item', icon: block.settings.icon, text: block.settings.text, requires: block.settings.requires, policies: policies, days_min: days_min, days_max: days_max, attributes: block.shopify_attributes
      endcapture
      assign items_html = items_html | append: one
    endfor
  endif
-%}

{%- liquid
  assign count = items_html | split: '<li ' | size | minus: 1
  assign is_static = false
  if count < 3
    assign is_static = true
  endif
  # Duración estimada sin JS (~220 px por ítem); el JS la corrige con el ancho real.
  assign estimate = count | times: 220 | divided_by: s.speed
  if estimate < 8
    assign estimate = 8
  endif
-%}

{%- if count > 0 -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  {%- unless is_static -%}
    <script src="{{ 'df-scrolling-benefits.js' | asset_url }}" defer></script>
  {%- endunless -%}

  {%- capture bg_style -%}
    {%- if s.background_color != blank -%}--df-bg: {{ s.background_color }}; --df-sb-bg: {{ s.background_color }};{%- endif -%}
    {%- if s.text_color != blank -%} --df-fg: {{ s.text_color }};{%- endif -%}
  {%- endcapture -%}

  <df-scrolling-benefits
    class="df df-scrolling-benefits{% if is_static %} df-scrolling-benefits--static{% endif %}{% if s.pause_on_hover %} df-scrolling-benefits--hover-pause{% endif %}{% if s.fade_edges %} df-scrolling-benefits--fade{% endif %}{% if s.direction == 'right' %} df-scrolling-benefits--right{% endif %}"
    style="{% render 'df-accent-vars', product: product, background: s.background_color %} {{ bg_style }} --df-sb-pt: {{ s.padding_top }}px; --df-sb-pb: {{ s.padding_bottom }}px; --df-sb-gap: {{ s.item_gap }}px; --df-sb-text: {{ s.text_size }}px; --df-sb-icon: {{ s.icon_size }}px; --df-marquee-duration: {{ estimate }}s;"
    data-speed="{{ s.speed }}"
    {% if is_static %}data-static{% endif %}
  >
    {%- if heading != blank -%}
      {%- liquid
        assign parts = heading | escape | split: '**'
        capture heading_html
          for part in parts
            if forloop.index0 == 1 or forloop.index0 == 3
              echo '<span class="df-scrolling-benefits__hl">' | append: part | append: '</span>'
            else
              echo part
            endif
          endfor
        endcapture
      -%}
      <h2 class="df-heading df-scrolling-benefits__heading">{{ heading_html }}</h2>
    {%- endif -%}

    <div class="df-scrolling-benefits__bar">
      <div class="df-scrolling-benefits__viewport">
        <div class="df-scrolling-benefits__track" data-df-track>
          <ul class="df-scrolling-benefits__set" role="list" data-df-set>
            {{ items_html }}
          </ul>
          {%- unless is_static -%}
            <ul class="df-scrolling-benefits__set" role="list" aria-hidden="true" inert>
              {{ copy_html }}
            </ul>
          {%- endunless -%}
        </div>
      </div>

    </div>
  </df-scrolling-benefits>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-scrolling-benefits" style="--df-sb-pt: {{ s.padding_top }}px; --df-sb-pb: {{ s.padding_bottom }}px;">
    <p class="df-placeholder">
      Cinta de beneficios: agrega bloques «Beneficio» o genera el contenido desde DropFlex. Los ítems atados a una política que la tienda no tiene no se muestran.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .df-scrolling-benefits {
    display: block;
    padding-block: var(--df-sb-pt, 16px) var(--df-sb-pb, 16px);
    background: var(--df-sb-bg, var(--df-surface));
    overflow: hidden;
  }

  .df-scrolling-benefits__heading {
    max-width: 40rem;
    margin: 0 auto 12px;
    padding-inline: 16px;
    font-size: var(--df-title-size);
    text-align: center;
  }

  .df-scrolling-benefits__hl {
    color: var(--df-accent-ink);
  }

  .df-scrolling-benefits__bar {
    display: flex;
    align-items: center;
  }

  .df-scrolling-benefits__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .df-scrolling-benefits--fade .df-scrolling-benefits__viewport {
    --df-sb-fade: 40px;
    mask-image: linear-gradient(90deg, transparent, #000 var(--df-sb-fade), #000 calc(100% - var(--df-sb-fade)), transparent);
  }

  .df-scrolling-benefits__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: df-scrolling-benefits-move var(--df-marquee-duration, 30s) linear infinite;
  }

  .df-scrolling-benefits--right .df-scrolling-benefits__track {
    animation-direction: reverse;
  }

  @keyframes df-scrolling-benefits-move {
    from { transform: translateX(0); }
    to { transform: translateX(var(--df-marquee-shift, -50%)); }
  }

  /* Pausa: botón, puntero encima, foco dentro, fuera de pantalla o pestaña oculta. */
  .df-scrolling-benefits[data-paused] .df-scrolling-benefits__track,
  .df-scrolling-benefits[data-offscreen] .df-scrolling-benefits__track,
  .df-scrolling-benefits[data-tab-hidden] .df-scrolling-benefits__track,
  .df-scrolling-benefits:focus-within .df-scrolling-benefits__track,
  .df-scrolling-benefits--hover-pause:hover .df-scrolling-benefits__track {
    animation-play-state: paused;
  }

  .df-scrolling-benefits__set {
    display: flex;
    align-items: center;
    gap: var(--df-sb-gap, 48px);
    margin: 0;
    padding: 0 var(--df-sb-gap, 48px) 0 0;
    list-style: none;
  }

  .df-scrolling-benefits__item {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: max(12px, calc(var(--df-sb-text, 14px) - 1px));
    line-height: 1.3;
  }

  .df-scrolling-benefits__icon {
    display: inline-flex;
    color: var(--df-accent-ink);
    font-size: calc(var(--df-sb-icon, 28px) - 4px);
  }

  .df-scrolling-benefits__icon .df-icon {
    width: 1em;
    height: 1em;
  }


  @media (min-width: 750px) {
    .df-scrolling-benefits--fade .df-scrolling-benefits__viewport {
      --df-sb-fade: 80px;
    }

    .df-scrolling-benefits__item {
      font-size: var(--df-sb-text, 14px);
    }

    .df-scrolling-benefits__icon {
      font-size: var(--df-sb-icon, 28px);
    }
  }

  /* Quieta: pocos ítems o movimiento reducido. Una fila centrada que se envuelve. */
  .df-scrolling-benefits--static .df-scrolling-benefits__viewport {
    mask-image: none;
  }

  .df-scrolling-benefits--static .df-scrolling-benefits__track {
    width: auto;
    animation: none;
  }

  .df-scrolling-benefits--static .df-scrolling-benefits__set {
    flex: 1;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 12px;
    padding-inline: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .df-scrolling-benefits__viewport {
      mask-image: none;
    }

    .df-scrolling-benefits__track {
      width: auto;
      animation: none;
    }

    .df-scrolling-benefits__set {
      flex: 1;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 12px;
      padding-inline: 16px;
    }

    .df-scrolling-benefits__set[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Cinta ventajas",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.scrolling_benefits; los bloques son el respaldo. Un beneficio atado a una política que la tienda no tiene no se muestra."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Mostrar título",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Encierra una palabra entre ** para destacarla: Compra **sin riesgo**."
    },
    {
      "type": "header",
      "content": "Movimiento"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidad",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "info": "Píxeles por segundo, igual sin importar el largo de los textos.",
      "default": 50
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Dirección",
      "options": [
        { "value": "left", "label": "Hacia la izquierda" },
        { "value": "right", "label": "Hacia la derecha" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar con el puntero",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Desvanecer los bordes",
      "default": true
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "info": "Vacío: un gris suave derivado del tema (sirve en claro y oscuro)."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "info": "Vacío: el color de texto del tema."
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño del ícono",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Separación",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "cash", "label": "Efectivo" },
            { "value": "truck", "label": "Camión" },
            { "value": "package", "label": "Paquete" },
            { "value": "home", "label": "Casa" },
            { "value": "shield", "label": "Escudo" },
            { "value": "lock", "label": "Candado" },
            { "value": "return", "label": "Devolución" },
            { "value": "clock", "label": "Reloj" },
            { "value": "calendar", "label": "Calendario" },
            { "value": "headset", "label": "Audífonos" },
            { "value": "chat", "label": "Chat" },
            { "value": "phone", "label": "Teléfono" },
            { "value": "gift", "label": "Regalo" },
            { "value": "award", "label": "Medalla" },
            { "value": "star", "label": "Estrella" },
            { "value": "heart", "label": "Corazón" },
            { "value": "check-circle", "label": "Visto" },
            { "value": "flag", "label": "Bandera" },
            { "value": "globe", "label": "Mundo" },
            { "value": "leaf", "label": "Hoja" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "info": "2 a 5 palabras. Tokens: {min} {max} (días hábiles), {return_days}, {warranty_months}, {threshold}.",
          "default": "Envío a todo el país"
        },
        {
          "type": "select",
          "id": "requires",
          "label": "Solo si la tienda tiene",
          "options": [
            { "value": "none", "label": "Siempre visible" },
            { "value": "cod", "label": "Pago contra entrega" },
            { "value": "free_shipping", "label": "Envío gratis" },
            { "value": "returns", "label": "Cambios o devolución" },
            { "value": "warranty", "label": "Garantía" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "delivery", "label": "Plazo de entrega" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Cinta ventajas",
      "blocks": [
        { "type": "item", "settings": { "icon": "cash", "text": "Pagas al recibir", "requires": "cod" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Llega en {min} a {max} días hábiles", "requires": "delivery" } },
        { "type": "item", "settings": { "icon": "return", "text": "Cambio sin costo en {return_days} días", "requires": "returns" } },
        { "type": "item", "settings": { "icon": "headset", "text": "Atención por WhatsApp", "requires": "whatsapp" } },
        { "type": "item", "settings": { "icon": "lock", "text": "Tus datos protegidos" } }
      ]
    }
  ]
}
{% endschema %}
