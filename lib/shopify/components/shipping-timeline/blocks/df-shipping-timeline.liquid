<div data-df-pdp-component="shipping-timeline">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.shipping_timeline.value -%}
<script src="{{ 'df-shipping-timeline.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-shipping-timeline">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-shipping-timeline-content', product: df_product, section: section, block: block, content: df_variants %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-shipping-timeline {
    --df-st-circle: 56px;
    --df-st-time: var(--df-accent-ink);
    display: grid;
    gap: 16px;
  }

  .df-shipping-timeline--time-positive {
    --df-st-time: var(--df-positive);
  }

  .df-shipping-timeline__title {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }

  .df-shipping-timeline__title[data-pending] {
    visibility: hidden;
  }

  .df-shipping-timeline__title[hidden] {
    display: none;
  }

  .df-shipping-timeline__time {
    color: var(--df-st-time);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .df-shipping-timeline__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Conector punteado entre el centro del primer y del último círculo, detrás de ellos. */
  .df-shipping-timeline__steps::before {
    content: '';
    position: absolute;
    top: calc(var(--df-st-circle) / 2 - 1px);
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 2px;
    background: linear-gradient(90deg, var(--df-muted) 50%, transparent 0) 0 0 / 12px 2px repeat-x;
    opacity: 0.6;
  }

  /* «Línea animada»: el tramo Pedido → Despachado va en el acento, sólido (lo que ya está en marcha)
     y el resto punteado (lo que falta). df-shipping-timeline.js lo dibuja una sola vez al entrar en
     pantalla y el hito 2 hace un pequeño pop; después todo queda quieto (nunca un bucle). Sin JS o
     con movimiento reducido se ve el estado final. */
  .df-shipping-timeline--animate .df-shipping-timeline__steps::after {
    content: '';
    position: absolute;
    top: calc(var(--df-st-circle) / 2 - 1px);
    left: calc(100% / 6);
    width: calc(100% / 3);
    height: 2px;
    border-radius: 1px;
    background: var(--df-accent);
    transform-origin: left center;
  }

  .df-shipping-timeline--animate.is-armed .df-shipping-timeline__steps::after {
    transform: scaleX(0);
  }

  .df-shipping-timeline--animate.is-run .df-shipping-timeline__steps::after {
    transform: scaleX(1);
    transition: transform 600ms var(--df-ease-standard, cubic-bezier(0.2, 0, 0, 1));
  }

  .df-shipping-timeline--animate.is-run .df-shipping-timeline__step:nth-child(2) .df-shipping-timeline__circle {
    animation: df-shipping-timeline-pop 240ms var(--df-ease-enter, cubic-bezier(0, 0, 0, 1)) 560ms backwards;
  }

  @keyframes df-shipping-timeline-pop {
    from { transform: scale(0.88); }
  }

  .df-shipping-timeline__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 0;
    text-align: center;
  }

  .df-shipping-timeline__circle {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--df-st-circle);
    height: var(--df-st-circle);
    margin-bottom: 6px;
    border-radius: 50%;
    background: var(--df-surface);
    color: var(--df-fg);
  }

  .df-shipping-timeline--icons-accent .df-shipping-timeline__circle {
    background: var(--df-accent-soft);
    color: var(--df-accent-ink);
  }

  .df-shipping-timeline__circle .df-icon {
    width: 26px;
    height: 26px;
  }

  .df-shipping-timeline__img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .df-shipping-timeline__label {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .df-shipping-timeline__sub {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--df-muted);
    text-wrap: balance;
  }

  .df-shipping-timeline__suffix {
    color: var(--df-fg);
    font-weight: 500;
  }

  @media (min-width: 750px) {
    .df-shipping-timeline {
      --df-st-circle: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .df-shipping-timeline--animate.is-armed .df-shipping-timeline__steps::after {
      transform: none;
    }

    .df-shipping-timeline--animate.is-run .df-shipping-timeline__step:nth-child(2) .df-shipping-timeline__circle {
      animation: none;
    }
  }
{% endstylesheet %}

