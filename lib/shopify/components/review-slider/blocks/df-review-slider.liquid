<div data-df-pdp-component="review-slider" data-df-fixed>
<script src="{{ 'df-slider.js' | asset_url }}" defer></script>
<script src="{{ 'df-review-slider.js' | asset_url }}" defer></script>
{% assign df_product = closest.product | default: product %}
{% render 'df-review-slider-content', product: df_product, section: section, block: block %}
</div>



{% schema %}
{
  "name": "DropFlex · Reseñas",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra reseñas aprobadas en DropFlex. La selección y los extractos vienen del metafield dropflex.review_slider; sin él, se eligen con estos ajustes."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Opcional. Puedes usar {count} y {rating} (datos reales)."
    },
    {
      "type": "header",
      "content": "Selección"
    },
    {
      "type": "range",
      "id": "min_reviews",
      "label": "Mínimo de reseñas",
      "info": "Con menos reseñas aprobadas, el bloque no se muestra.",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Reseñas a mostrar",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Calificación mínima",
      "info": "Solo sin metafield. La nota y la cantidad totales se muestran igual en las estrellas.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "only_with_photo",
      "label": "Solo reseñas con foto",
      "info": "Solo sin metafield.",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancla",
      "info": "Id del bloque (sin #). Las estrellas llevan aquí si usan la misma. Usa uno solo por página.",
      "default": "resenas"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "photo", "label": "Con foto y flechas" },
        { "value": "compact", "label": "Compacto con puntos" }
      ],
      "default": "photo"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Tiempo por reseña",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "text_lines",
      "label": "Líneas del texto",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Mostrar fecha",
      "default": false
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Reseñas"
    }
  ]
}
{% endschema %}
