{%- doc -%}
  Render del contenido vigente; valoración compartida editable y datos operativos de Shopify.
  @param {object} product
  @param {object} section
  @param {object} [block]
  @param {object} [content]
  @param {object} [df_variant]
{%- enddoc -%}
{%- comment -%}
  Textos propios del componente o reseñas reutilizadas por review_id.
  Nombre, cuerpo y calificación propios son editables; la procedencia es opcional.
{%- endcomment -%}
{%- liquid
  # closest.product: el producto de la ficha. Sin ajuste «product» propio: si el bloque tuviera uno
  # vacío, closest.product lo tomaría a él primero y el bloque quedaría sin producto.
  assign product = closest.product | default: product
  assign s = block.settings
  # content llega de la variante seleccionada (o del objeto legacy).
  capture pdp_rating
    render 'df-pdp-rating', product: product, df_variant: df_variant
  endcapture
  assign pdp_rating = pdp_rating | split: '|'
  assign pdp_score = pdp_rating[0] | plus: 0
  assign pdp_count = pdp_rating[1] | plus: 0
  assign reviews = product.metafields.dropflex.reviews.value.items
  assign images = product.metafields.dropflex.reviews_images.value

  assign count = pdp_count

  assign total = 0
  for pick in content.items
    assign matched = reviews | where: 'id', pick.review_id | first
    assign authored_excerpt = false
    if pick.review_id == blank and pick.excerpt != blank
      assign authored_excerpt = true
    endif
    if matched != blank or pick.body != blank or authored_excerpt
      assign total = total | plus: 1
    endif
  endfor

  assign show = true
  if product == blank or total == 0
    assign show = false
  endif

  if show
    assign rating = pdp_score
    assign r10 = rating | times: 10 | round
    assign r_int = r10 | divided_by: 10
    assign r_dec = r10 | modulo: 10
    assign rating_text = r_int | append: ',' | append: r_dec
    assign count_text = count | append: ''
    if count >= 1000
      assign thousands = count | divided_by: 1000
      assign rest = count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign count_text = thousands | append: '.' | append: rest
    endif

    assign heading = content.heading | default: s.heading
    if heading contains '{rating}' and rating <= 0
      assign heading = s.heading
    endif
    assign heading = heading | replace: '{count}', count_text | replace: '{rating}', rating_text

    # Navegación manual con dots y deslizamiento; sin rotación automática ni botón de pausa.
    assign anchor = s.anchor_id | default: 'resenas' | remove: '#' | strip | handleize
  endif
-%}

{%- if show -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}



  <df-review-slider
    class="df df-review-slider df-review-slider--{{ s.style | default: 'photo' }}"
    {% if anchor != blank %}id="{{ anchor }}"{% endif %}
    style="{% render 'df-accent-vars', product: product %} --df-review-lines: {{ s.text_lines | default: 2 }}; margin-block: {{ s.margin_top | default: 0 }}px {{ s.margin_bottom | default: 0 }}px;"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <p class="df-heading df-review-slider__heading" data-df-rating-template="{{ content.heading | default: s.heading | escape }}">{{ heading | escape }}</p>
    {%- endif -%}

    <df-slider
      data-loop
      data-dot-label="Ir a la reseña"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Reseñas de compradores"
    >
      <div class="df-slider__track" data-df-track data-df-review-order>
        {%- assign shown = 0 -%}
        {%- for pick in content.items -%}
        {%- assign review = reviews | where: 'id', pick.review_id | first -%}
        {%- assign authored_excerpt = false -%}
        {%- if pick.review_id == blank and pick.excerpt != blank -%}{%- assign authored_excerpt = true -%}{%- endif -%}
        {%- if review != blank or pick.body != blank or authored_excerpt -%}
        {%- assign shown = shown | plus: 1 -%}
          {%- liquid
            assign author = pick.name | default: review.author | default: 'Comprador'
            assign body = pick.body | default: review.body | default: pick.excerpt
            assign excerpt = pick.excerpt | default: body
            assign mode = pick.excerpt_mode | default: 'verbatim'
            assign r_rating = pick.rating | default: review.rating | default: 0 | plus: 0
            assign r_from = review.image_from | plus: 0
            assign r_photos = review.image_count | plus: 0
            assign photo = nil
            if r_photos > 0
              assign photo = images[r_from]
            endif
            assign stars_label = r_rating | append: ' de 5 estrellas' | replace: '.', ','
          -%}
          <div
            class="df-review-slider__card" data-review-id="{% if review.id != blank %}{{ review.id | escape }}{% else %}authored-{{ forloop.index0 }}{% endif %}"
            role="group"
            aria-roledescription="reseña"
            aria-label="{{ shown }} de {{ total }}"
          >
            {%- if s.style != 'compact' -%}
              <div class="df-review-slider__avatar">
                {%- if photo != blank -%}
                  {%- assign photo_alt = 'Foto de la reseña de ' | append: author -%}
                  {{
                    photo
                    | image_url: width: 124, height: 124, crop: 'center'
                    | image_tag: width: 62, height: 62, loading: 'lazy', alt: photo_alt
                  }}
                {%- else -%}
                  <span aria-hidden="true">{{ author | slice: 0 | upcase | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="df-review-slider__body">
              <p class="df-review-slider__meta">
                <span class="df-review-slider__author">{{ author | escape }}</span>
                {%- if r_rating > 0 -%}{%- render 'df-stars', rating: r_rating, size: '0.875rem', label: stars_label -%}{%- endif -%}
              </p>
              <blockquote class="df-review-slider__text">
                <p>{{ excerpt | escape }}</p>
              </blockquote>
              {%- if mode != 'verbatim' or s.show_date -%}
                <div class="df-review-slider__foot">
                  {%- if mode != 'verbatim' and body != blank -%}
                    <details class="df-review-slider__full">
                      <summary>
                        {%- if mode == 'translated' -%}Traducida{%- else -%}Resumida{%- endif %}
                        · ver completa
                      </summary>
                      <p>{{ body | escape }}</p>
                    </details>
                  {%- endif -%}
                  {%- if s.show_date and review.date != blank -%}
                    <time datetime="{{ review.date | escape }}">{{ review.date | date: '%d/%m/%Y' | escape }}</time>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if total > 1 -%}
        <div class="df-slider__controls">
          <div class="df-slider__dots" data-df-dots>
            {%- for position in (1..total) -%}
              <button type="button" class="df-slider__dot" aria-label="Ir a la reseña {{ position }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </df-slider>
  </df-review-slider>

{%- elsif product != blank -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-placeholder" data-df-empty="review-slider" {{ block.shopify_attributes }}>
    Todavía no hay reseñas en este carrusel.
  </div>
{%- endif -%}
