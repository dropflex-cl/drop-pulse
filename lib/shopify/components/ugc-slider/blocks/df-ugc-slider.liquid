      "options": [
        { "value": "2", "label": "2" },
        { "value": "2.5", "label": "2,5" },
        { "value": "3", "label": "3" },
        { "value": "3.5", "label": "3,5" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "play_style",
      "label": "Botón de play",
      "options": [
        { "value": "glass", "label": "Translúcido" },
        { "value": "accent", "label": "Color de acento" }
      ],
      "default": "glass"
    },
    {
      "type": "checkbox",
      "id": "preview_motion",
      "label": "Vista previa en movimiento",
      "info": "Reproduce sin sonido solo los videos visibles. Gasta más datos móviles.",
      "default": false
