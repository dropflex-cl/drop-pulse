{%- assign df_conversion_product = closest.product | default: product | default: section.settings.product -%}
{%- unless df_conversion_product.metafields.dropflex.conversion_supports.value.disabled_components contains 'benefit-double-box' -%}
<div data-df-pdp-component="benefit-double-box">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.benefit_double_box.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-benefit-double-box">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-benefit-double-box-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-benefit-double-box-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-benefit-double-box-content', product: df_product, section: section, block: block, content: df_variants %}
{%- endif -%}

</div>

{%- endunless -%}

{% stylesheet %}
  .df-benefit-double-box {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 479px) {
    .df-benefit-double-box--stack {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .df-benefit-double-box__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: var(--df-dbox-padding, 16px);
    border-radius: var(--df-dbox-radius, 16px);
    background: var(--df-surface);
  }

  /* Una sola tarjeta válida: todo el ancho. */
  .df-benefit-double-box__card:only-child {
    grid-column: 1 / -1;
  }

  .df-benefit-double-box--border .df-benefit-double-box__card {
    border: 1px solid var(--df-hairline);
    background: transparent;
  }

  .df-benefit-double-box__media {
    display: flex;
    align-items: center;
    height: var(--df-dbox-icon, 24px);
    color: var(--df-accent-ink);
  }

  .df-benefit-double-box__media .df-icon {
    width: var(--df-dbox-icon, 24px);
    height: var(--df-dbox-icon, 24px);
  }

  /* Logos anchos (medios de pago): alto fijo, ancho libre, alineados a la izquierda. */
  .df-benefit-double-box__img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .df-benefit-double-box__title,
  .df-benefit-double-box__body {
    margin: 0;
    hyphens: auto;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  .df-benefit-double-box__title {
    font-size: var(--df-dbox-title, 14px);
    line-height: 1.3;
  }

  .df-benefit-double-box__body {
    font-size: max(12px, calc(var(--df-dbox-title, 14px) - 1.5px));
    line-height: 1.45;
    color: var(--df-muted);
  }
{% endstylesheet %}

