{%- doc -%}
  Render de contenido aprobado; los datos reales siguen saliendo de Shopify.
  @param {object} product
  @param {object} section
  @param {object} [block]
  @param {object} [content]
  @param {object} [df_variant]
{%- enddoc -%}
{%- doc -%}
  DropFlex · Doble tarjeta (benefit-double-box). Bloque de la columna del producto, bajo el botón:
  dos tarjetas gemelas que responden las dos objeciones del momento del clic: cómo pago y qué
  pasa si no me sirve.

  REGLA: el medio de pago y el plazo de cambio o garantía son políticas REALES de la tienda. Cada
  tarjeta del metafield declara qué política afirma (`policy`) y se oculta si no está activa en
  shop.metafields.dropflex.policies. Las cifras son tokens; si el dato falta, la tarjeta no se
  muestra. Con una sola tarjeta válida, ocupa todo el ancho.

  Contenido: metafield `dropflex.benefit_double_box` (json) → si falta, las 2 tarjetas del bloque.
    { cards: [{ icon (IconKey), title (≤ 24), body (≤ 64), policy }] (exactamente 2) }
  Tokens: {return_days} · {warranty_months} · {threshold} (políticas) · {min} {max} (logística).
{%- enddoc -%}
{%- liquid
  # closest.product: el producto de la ficha. Sin ajuste «product» propio: si el bloque tuviera uno
  # vacío, closest.product lo tomaría a él primero y el bloque quedaría sin producto.
  assign product = closest.product | default: product
  assign s = block.settings
  # content llega de la variante seleccionada (o del objeto legacy).
  assign policies = shop.metafields.dropflex.policies.value
  assign logistics = shop.metafields.dropflex.logistics.value
  assign known_icons = 'check,check-circle,x-circle,truck,package,home,cart,cash,shield,lock,return,clock,calendar,star,heart,sparkles,bolt,leaf,droplet,sun,moon,battery,feather,ruler,target,thumbs-up,users,chat,gift,fire,eye,hand,globe,award,phone,headset,flag' | split: ','

  assign use_content = false
  if content.cards != blank
    assign use_content = true
  endif

  # Datos reales para los tokens (0 = falta el dato → la tarjeta que lo usa no se muestra).
  assign days_min = 0
  assign days_max = 0
  if logistics != blank
    assign handling = logistics.handling_days | plus: 0
    assign days_min = logistics.transit_days_min | plus: handling
    assign days_max = logistics.transit_days_max | plus: handling
    if days_max < days_min
      assign days_max = days_min
    endif
  endif
  assign return_days = policies.return_days | plus: 0
  assign warranty_months = policies.warranty_months | plus: 0
  assign threshold_cents = policies.free_shipping_threshold | times: 100
  assign threshold = threshold_cents | money_without_trailing_zeros
-%}

{%- capture cards_html -%}
  {%- for i in (1..2) -%}
    {%- liquid
      assign idx = i | minus: 1
      assign image = nil
      if use_content
        assign card = content.cards[idx]
        assign title = card.title
        assign body = card.body
        assign icon = card.icon
        assign policy = card.policy
      else
        assign key = 'card_' | append: i
        assign k_title = key | append: '_title'
        assign k_body = key | append: '_body'
        assign k_icon = key | append: '_icon'
        assign k_image = key | append: '_image'
        assign title = s[k_title]
        assign body = s[k_body]
        assign icon = s[k_icon]
        assign image = s[k_image]
        assign policy = 'none'
      endif
      if title == blank
        continue
      endif

      # Filtro de verdad: una tarjeta del metafield que afirma una política ausente no se publica.
      assign ok = true
      case policy
        when 'cod'
          unless policies.cod == true
            assign ok = false
          endunless
        when 'free_shipping'
          unless policies.free_shipping == true
            assign ok = false
          endunless
        when 'returns'
          if return_days <= 0
            assign ok = false
          endif
        when 'warranty'
          if warranty_months <= 0
            assign ok = false
          endif
        when 'whatsapp'
          if policies.whatsapp == blank
            assign ok = false
          endif
        when 'shipping_time'
          if days_max <= 0
            assign ok = false
          endif
      endcase
      unless ok
        continue
      endunless

      assign text = title | append: '§' | append: body
      if days_max > 0
        assign text = text | replace: '{min}', days_min | replace: '{max}', days_max
      endif
      if return_days > 0
        assign text = text | replace: '{return_days}', return_days
      endif
      if warranty_months > 0
        assign text = text | replace: '{warranty_months}', warranty_months
      endif
      if threshold_cents > 0
        assign text = text | replace: '{threshold}', threshold
      endif
      if text contains '{'
        continue
      endif
      assign title = text | split: '§' | first
      assign body = text | split: '§' | last
      if body == title
        assign body = ''
      endif

      unless known_icons contains icon
        assign icon = 'check'
      endunless
      assign image_alt = ''
      if image != blank and image.alt != blank
        assign image_alt = image.alt
      endif
    -%}
    <li class="df-benefit-double-box__card" data-df-reveal>
      <span class="df-benefit-double-box__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 320 | image_tag: widths: '160, 320', sizes: '160px', alt: image_alt, class: 'df-benefit-double-box__img' }}
        {%- else -%}
          {% render 'df-icon', name: icon %}
        {%- endif -%}
      </span>
      <p class="df-benefit-double-box__title"><strong>{{ title | escape }}</strong></p>
      {%- if body != blank -%}
        <p class="df-benefit-double-box__body">{{ body | escape }}</p>
      {%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if cards_html != blank -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}

  <ul
    class="df df-benefit-double-box{% if s.border %} df-benefit-double-box--border{% endif %}{% if s.stack_on_mobile %} df-benefit-double-box--stack{% endif %}"
    style="{% render 'df-accent-vars', product: product %} --df-dbox-radius: {{ s.card_radius }}px; --df-dbox-padding: {{ s.card_padding }}px; --df-dbox-icon: {{ s.icon_height }}px; --df-dbox-title: {{ s.title_size }}px; margin-block: {{ s.margin_top }}px {{ s.margin_bottom }}px;"
    lang="{{ request.locale.iso_code | default: 'es' }}"
    role="list"
    {{ block.shopify_attributes }}
  >
    {{ cards_html }}
  </ul>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-placeholder" {{ block.shopify_attributes }}>
    Doble tarjeta: escribe el título de al menos una tarjeta o genera el contenido con DropFlex. Las tarjetas con datos que tu tienda no tiene cargados no se muestran.
  </div>
{%- endif -%}
