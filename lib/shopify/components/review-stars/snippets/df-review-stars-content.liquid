{%- doc -%}
  Render del contenido vigente; valoración compartida editable y datos operativos de Shopify.
  @param {object} product
  @param {object} section
  @param {object} [block]
  @param {object} [content]
  @param {object} [df_variant]
{%- enddoc -%}
{%- comment -%}
  Label, rating y count editables; review_summary es un respaldo opcional.
  Un label sin tokens puede mostrarse sin reseñas importadas.
{%- endcomment -%}
{%- liquid
  # closest.product: el producto de la ficha. Sin ajuste «product» propio: si el bloque tuviera uno
  # vacío, closest.product lo tomaría a él primero y el bloque quedaría sin producto.
  assign product = closest.product | default: product
  assign s = block.settings
  # content llega de la variante seleccionada (o del objeto legacy).
  capture pdp_rating
    render 'df-pdp-rating', product: product, df_variant: df_variant
  endcapture
  assign pdp_rating = pdp_rating | split: '|'
  assign pdp_score = pdp_rating[0] | plus: 0
  assign pdp_count = pdp_rating[1] | plus: 0

  assign rating = pdp_score
  assign count = pdp_count

  assign own_label = false
  if content.label != blank
    unless content.label contains '{count}' or content.label contains '{rating}'
      assign own_label = true
    endunless
  endif
  assign show = true
  if product == blank
    assign show = false
  elsif own_label == false and rating <= 0
    assign show = false
  endif

  if show
    # 4.6 → «4,6»; 5 → «5,0». Siempre un decimal, con coma.
    assign r10 = rating | times: 10 | round
    assign r_int = r10 | divided_by: 10
    assign r_dec = r10 | modulo: 10
    assign rating_text = r_int | append: ',' | append: r_dec

    # 1234 → «1.234».
    assign count_text = count | append: ''
    if count >= 1000
      assign thousands = count | divided_by: 1000
      assign rest = count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign count_text = thousands | append: '.' | append: rest
    endif

    assign label = content.label | default: s.label
    if own_label
      assign label = content.label
    elsif s.compact
      assign label = rating_text | append: ' · ' | append: count_text | append: ' reseñas'
    elsif label contains '{count}'
      assign label = label | replace: '{count}', count_text | replace: '{rating}', rating_text
    else
      # Una plantilla sin {count} escribiría la cantidad a mano: se descarta.
      assign label = rating_text | append: ' · ' | append: count_text | append: ' reseñas'
    endif

    assign aria = 'Calificación ' | append: rating_text | append: ' de 5, basada en ' | append: count_text | append: ' reseñas'
    if rating <= 0
      assign aria = label
    endif
    assign anchor = s.anchor | remove: '#' | strip | handleize
    if anchor != blank
      assign aria = aria | append: '. Ir a las reseñas'
    endif
    assign star_size = s.star_size | append: 'px'
  endif
-%}

{%- if show -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  {%- if anchor != blank -%}


  {%- endif -%}

  <df-review-stars data-df-rating-group {% if own_label %}data-df-rating-optional{% endif %}
    class="df df-review-stars df-review-stars--{{ s.alignment }}{% if s.compact %} df-review-stars--compact{% endif %}"
    style="{% render 'df-accent-vars', product: product %} --df-review-stars-text: {{ s.text_size }}px; --df-review-stars-offset: {{ s.scroll_offset }}px; margin-block: {{ s.margin_top }}px {{ s.margin_bottom }}px;"
    {{ block.shopify_attributes }}
  >
    {%- if anchor != blank -%}
      <a class="df-review-stars__row" href="#{{ anchor }}" aria-label="{{ aria | escape }}" data-df-review-stars-link>
    {%- else -%}
      <p class="df-review-stars__row" role="img" aria-label="{{ aria | escape }}">
    {%- endif -%}
      {%- if rating > 0 -%}<span aria-hidden="true" class="df-review-stars__stars" data-df-rating-stars>
        {%- render 'df-stars', rating: rating, size: star_size, label: aria -%}
      </span>{%- endif -%}
      {%- if s.show_text -%}
        <span class="df-review-stars__label" aria-hidden="true" data-df-rating-template="{% if own_label %}{{ content.label | escape }}{% elsif s.compact %}{rating} · {count} reseñas{% else %}{{ content.label | default: s.label | escape }}{% endif %}">{{ label | escape }}</span>
      {%- endif -%}
    {%- if anchor != blank -%}
      </a>
    {%- else -%}
      </p>
    {%- endif -%}
  </df-review-stars>

{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-placeholder" {{ block.shopify_attributes }}>
    Estrellas de reseñas: escribe el contenido del bloque o reutiliza un resumen disponible.
  </div>
{%- endif -%}
