{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.image_with_benefits.value -%}
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-image-with-benefits">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-image-with-benefits-content', product: df_product, section: section, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-image-with-benefits-content', product: df_product, section: section, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-image-with-benefits-content', product: df_product, section: section, content: df_variants %}
{%- endif -%}

{% stylesheet %}
  .df-image-with-benefits {
    padding-block: calc(var(--df-iwb-pt, 48px) * var(--df-space, 1)) calc(var(--df-iwb-pb, 48px) * var(--df-space, 1));
    background: var(--df-iwb-bg, transparent);
  }

  .df-image-with-benefits__inner {
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--df-gutter);
  }

  .df-image-with-benefits__heading {
    margin-bottom: var(--df-title-gap);
    font-size: min(var(--df-title-size), var(--df-iwb-heading, 40px));
    text-align: center;
  }

  /* Móvil: foto arriba y una sola lista, ícono a la izquierda (se lee mejor que 2 columnas de 160 px). */
  .df-image-with-benefits__grid {
    display: grid;
    gap: 20px;
  }

  .df-image-with-benefits__media {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .df-image-with-benefits--shape-circle .df-image-with-benefits__media::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: var(--df-accent-soft);
  }

  .df-image-with-benefits--shape-card .df-image-with-benefits__media {
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  /* La foto con su proporción (no un cuadrado con bandas), centrada en el cuadro: así el radio
     redondea las esquinas de la foto y no las del cuadro. */
  .df-image-with-benefits__img {
    position: absolute;
    inset: 0;
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    margin: auto;
    border-radius: var(--df-radius-media);
  }

  .df-image-with-benefits__list {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-image-with-benefits__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 14px;
  }

  .df-image-with-benefits__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--df-accent-soft);
    color: var(--df-accent-ink);
  }

  .df-image-with-benefits__icon .df-icon {
    width: 24px;
    height: 24px;
  }

  .df-image-with-benefits__title {
    margin: 0 0 4px;
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.0625rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .df-image-with-benefits__body {
    font-size: 0.9375rem;
  }

  /* Tablet: foto a lo ancho, las dos listas lado a lado debajo. */
  @media (min-width: 750px) {
    .df-image-with-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      row-gap: 32px;
    }

    .df-image-with-benefits__media {
      grid-column: 1 / -1;
    }

    .df-image-with-benefits__list {
      gap: 32px;
    }
  }

  /* Escritorio: la foto al centro y los beneficios a cada lado, apuntando al producto. */
  @media (min-width: 990px) {
    .df-image-with-benefits--image .df-image-with-benefits__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
      grid-template-areas: 'left media right';
      align-items: center;
      column-gap: 32px;
    }

    .df-image-with-benefits--image .df-image-with-benefits__media {
      grid-area: media;
      width: 100%;
      max-width: 640px;
    }

    .df-image-with-benefits--image .df-image-with-benefits__list--left {
      grid-area: left;
    }

    .df-image-with-benefits--image .df-image-with-benefits__list--right {
      grid-area: right;
    }

    .df-image-with-benefits__list {
      gap: 56px;
    }

    .df-image-with-benefits__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .df-image-with-benefits--align-center .df-image-with-benefits__item {
      justify-items: center;
      text-align: center;
    }

    .df-image-with-benefits__icon {
      width: calc(var(--df-iwb-icon, 44px) + 16px);
      height: calc(var(--df-iwb-icon, 44px) + 16px);
    }

    .df-image-with-benefits__icon .df-icon {
      width: var(--df-iwb-icon, 44px);
      height: var(--df-iwb-icon, 44px);
    }

    .df-image-with-benefits__title {
      font-size: 1.25rem;
    }

    .df-image-with-benefits__body {
      font-size: 1rem;
    }

    /* Revelado (df-motion.js): con la foto al centro, cada lado llega desde su costado hacia ella. */
    .df-image-with-benefits--image .df-image-with-benefits__list--left .df-reveal-pending {
      translate: -8px 0;
    }

    .df-image-with-benefits--image .df-image-with-benefits__list--right .df-reveal-pending {
      translate: 8px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Foto y razones",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.image_with_benefits; el título y los bloques son el respaldo. Usa 4 o 6 beneficios."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "{count} es la cantidad de beneficios.",
      "default": "¿Por qué elegirlo?"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto central",
      "info": "Ideal: producto sin fondo, cuadrada."
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Usar la foto del producto",
      "info": "Si no eliges una foto, usa la destacada del producto.",
      "default": true
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Fondo de la foto",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "circle", "label": "Círculo suave" },
        { "value": "card", "label": "Tarjeta" }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación en escritorio",
      "options": [
        { "value": "center", "label": "Centrada" },
        { "value": "left", "label": "A la izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño del ícono",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "info": "Vacío: el fondo de la página."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "info": "Vacío: el color de texto del tema."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "check-circle", "label": "Visto" },
            { "value": "target", "label": "Objetivo" },
            { "value": "ruler", "label": "Regla" },
            { "value": "feather", "label": "Pluma" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "droplet", "label": "Gota" },
            { "value": "sun", "label": "Sol" },
            { "value": "moon", "label": "Luna" },
            { "value": "clock", "label": "Reloj" },
            { "value": "hand", "label": "Mano" },
            { "value": "heart", "label": "Corazón" },
            { "value": "sparkles", "label": "Destellos" },
            { "value": "bolt", "label": "Rayo" },
            { "value": "battery", "label": "Batería" },
            { "value": "shield", "label": "Escudo" },
            { "value": "award", "label": "Medalla" },
            { "value": "eye", "label": "Ojo" },
            { "value": "home", "label": "Casa" },
            { "value": "globe", "label": "Mundo" },
            { "value": "cash", "label": "Efectivo" }
          ],
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "2 o 3 palabras.",
          "default": "Beneficio concreto"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texto",
          "info": "Una oración: característica real → beneficio en tu día.",
          "default": "Explica qué hace esta característica y cómo te ayuda en tu día a día."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Foto y razones",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "target", "title": "Función principal", "body": "Cuenta qué hace el producto y en qué momento del día lo vas a notar." } },
        { "type": "benefit", "settings": { "icon": "hand", "title": "Comodidad", "body": "Explica por qué se siente bien al usarlo, incluso varias horas seguidas." } },
        { "type": "benefit", "settings": { "icon": "feather", "title": "Material", "body": "Nombra el material real y lo que te aporta: liviano, suave o respirable." } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "Fácil de usar", "body": "Describe cómo se pone o se usa, sin pasos complicados ni ayuda." } }
      ]
    }
  ]
}
{% endschema %}
