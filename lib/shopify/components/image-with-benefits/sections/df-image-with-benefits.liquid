{%- comment -%}
  DropFlex · Foto y razones (image-with-benefits). Sección «¿Por qué este producto?»: la foto del
  producto al centro y 4 o 6 beneficios alrededor (mitad a cada lado en escritorio), como un
  diagrama que explica el producto.

  REGLA: la foto es real: la elegida en DropFlex (metafield `dropflex.image_with_benefits_image`,
  file_reference), el ajuste del editor o la foto destacada del producto. La IA escribe solo
  el título y los beneficios; los datos técnicos que mencione deben estar en la ficha.

  Contenido: metafield `dropflex.image_with_benefits` (json) → si falta, el título y los bloques
  «Beneficio» del editor.
    { heading ({count} = cantidad de beneficios), benefits: [{ icon, title, body }] }

  Orden de lectura: título → foto → beneficios 1..n (una lista por lado; en móvil se leen seguidas).
  Sin JS.
{%- endcomment -%}
{%- liquid
  if product == blank
    assign product = section.settings.product
  endif
  assign s = section.settings
  assign content = product.metafields.dropflex.image_with_benefits.value

  # La foto elegida en DropFlex (Publicar) → la del editor → la destacada del producto.
  assign image = product.metafields.dropflex.image_with_benefits_image.value | default: s.image
  if image == blank and s.use_product_image
    assign image = product.featured_image
  endif

  if content.benefits.size > 0
    assign source = 'metafield'
    assign total = content.benefits.size | at_most: 6
  else
    assign source = 'editor'
    assign total = section.blocks.size | at_most: 6
  endif
  # Mitad y mitad; con un número impar, la izquierda lleva uno más.
  assign left_count = total | plus: 1 | divided_by: 2

  assign heading = content.heading | default: s.heading | replace: '{count}', total
-%}

{%- capture left_html -%}
  {%- if source == 'metafield' -%}
    {%- for benefit in content.benefits limit: left_count -%}
      {%- render 'df-image-with-benefits-item', icon: benefit.icon, title: benefit.title, body: benefit.body -%}
    {%- endfor -%}
  {%- else -%}
    {%- for block in section.blocks limit: left_count -%}
      {%- render 'df-image-with-benefits-item', icon: block.settings.icon, title: block.settings.title, body: block.settings.body, attributes: block.shopify_attributes -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture right_html -%}
  {%- assign right_count = total | minus: left_count -%}
  {%- if right_count > 0 -%}
    {%- if source == 'metafield' -%}
      {%- for benefit in content.benefits offset: left_count limit: right_count -%}
        {%- render 'df-image-with-benefits-item', icon: benefit.icon, title: benefit.title, body: benefit.body -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks offset: left_count limit: right_count -%}
        {%- render 'df-image-with-benefits-item', icon: block.settings.icon, title: block.settings.title, body: block.settings.body, attributes: block.shopify_attributes -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- if left_html != blank -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}

  {%- capture color_style -%}
    {%- if s.background_color != blank -%}--df-bg: {{ s.background_color }}; --df-iwb-bg: {{ s.background_color }};{%- endif -%}
    {%- if s.text_color != blank -%} --df-fg: {{ s.text_color }};{%- endif -%}
  {%- endcapture -%}

  <div
    class="df df-image-with-benefits{% if image != blank %} df-image-with-benefits--image{% endif %} df-image-with-benefits--align-{{ s.text_align }} df-image-with-benefits--shape-{{ s.image_shape }}"
    style="{% render 'df-accent-vars', product: product, background: s.background_color %} {{ color_style }} --df-iwb-pt: {{ s.padding_top }}px; --df-iwb-pb: {{ s.padding_bottom }}px; --df-iwb-icon: {{ s.icon_size }}px; --df-iwb-heading: {{ s.heading_size }}px;"
  >
    <div class="df-image-with-benefits__inner">
      {%- if heading != blank -%}
        <h2 class="df-heading df-image-with-benefits__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      <div class="df-image-with-benefits__grid">
        {%- if image != blank -%}
          <div class="df-image-with-benefits__media">
            {{-
              image
              | image_url: width: 1200
              | image_tag:
                widths: '360, 480, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 44vw, (min-width: 750px) 60vw, 90vw',
                loading: 'lazy',
                class: 'df-image-with-benefits__img'
            -}}
          </div>
        {%- endif -%}

        <ul class="df-image-with-benefits__list df-image-with-benefits__list--left" role="list">
          {{ left_html }}
        </ul>
        {%- if right_html != blank -%}
          <ul class="df-image-with-benefits__list df-image-with-benefits__list--right" role="list">
            {{ right_html }}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-image-with-benefits" style="--df-iwb-pt: {{ s.padding_top }}px; --df-iwb-pb: {{ s.padding_bottom }}px;">
    <p class="df-placeholder">
      Foto y razones: agrega bloques «Beneficio» (4 o 6) o genera el contenido desde DropFlex.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .df-image-with-benefits {
    padding-block: var(--df-iwb-pt, 48px) var(--df-iwb-pb, 48px);
    background: var(--df-iwb-bg, transparent);
  }

  .df-image-with-benefits__inner {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .df-image-with-benefits__heading {
    margin-bottom: 24px;
    font-size: clamp(1.625rem, 7vw, var(--df-iwb-heading, 48px));
    text-align: center;
  }

  /* Móvil: foto arriba y una sola lista, ícono a la izquierda (se lee mejor que 2 columnas de 160 px). */
  .df-image-with-benefits__grid {
    display: grid;
    gap: 20px;
  }

  .df-image-with-benefits__media {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
  }

  .df-image-with-benefits--shape-circle .df-image-with-benefits__media::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: var(--df-accent-soft);
  }

  .df-image-with-benefits--shape-card .df-image-with-benefits__media {
    overflow: hidden;
    border-radius: var(--df-radius);
    background: var(--df-surface);
  }

  .df-image-with-benefits__img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .df-image-with-benefits__list {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-image-with-benefits__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 14px;
  }

  .df-image-with-benefits__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--df-accent-soft);
    color: var(--df-accent-ink);
  }

  .df-image-with-benefits__icon .df-icon {
    width: 24px;
    height: 24px;
  }

  .df-image-with-benefits__title {
    margin: 0 0 4px;
    font-family: var(--df-font-heading);
    font-weight: var(--df-font-heading-weight);
    font-size: 1.0625rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .df-image-with-benefits__body {
    font-size: 0.9375rem;
  }

  /* Tablet: foto a lo ancho, las dos listas lado a lado debajo. */
  @media (min-width: 750px) {
    .df-image-with-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      row-gap: 32px;
    }

    .df-image-with-benefits__media {
      grid-column: 1 / -1;
    }

    .df-image-with-benefits__list {
      gap: 32px;
    }
  }

  /* Escritorio: la foto al centro y los beneficios a cada lado, apuntando al producto. */
  @media (min-width: 990px) {
    .df-image-with-benefits--image .df-image-with-benefits__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
      grid-template-areas: 'left media right';
      align-items: center;
      column-gap: 32px;
    }

    .df-image-with-benefits--image .df-image-with-benefits__media {
      grid-area: media;
      width: 100%;
      max-width: 640px;
    }

    .df-image-with-benefits--image .df-image-with-benefits__list--left {
      grid-area: left;
    }

    .df-image-with-benefits--image .df-image-with-benefits__list--right {
      grid-area: right;
    }

    .df-image-with-benefits__list {
      gap: 56px;
    }

    .df-image-with-benefits__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .df-image-with-benefits--align-center .df-image-with-benefits__item {
      justify-items: center;
      text-align: center;
    }

    .df-image-with-benefits__icon {
      width: calc(var(--df-iwb-icon, 44px) + 16px);
      height: calc(var(--df-iwb-icon, 44px) + 16px);
    }

    .df-image-with-benefits__icon .df-icon {
      width: var(--df-iwb-icon, 44px);
      height: var(--df-iwb-icon, 44px);
    }

    .df-image-with-benefits__title {
      font-size: 1.25rem;
    }

    .df-image-with-benefits__body {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Foto y razones",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos vienen del metafield dropflex.image_with_benefits; el título y los bloques son el respaldo. Usa 4 o 6 beneficios."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "{count} es la cantidad de beneficios.",
      "default": "¿Por qué elegirlo?"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto central",
      "info": "Ideal: producto sin fondo, cuadrada."
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Usar la foto del producto",
      "info": "Si no eliges una foto, usa la destacada del producto.",
      "default": true
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Fondo de la foto",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "circle", "label": "Círculo suave" },
        { "value": "card", "label": "Tarjeta" }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación en escritorio",
      "options": [
        { "value": "center", "label": "Centrada" },
        { "value": "left", "label": "A la izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño del ícono",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "info": "Vacío: el fondo de la página."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "info": "Vacío: el color de texto del tema."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "check-circle", "label": "Visto" },
            { "value": "target", "label": "Objetivo" },
            { "value": "ruler", "label": "Regla" },
            { "value": "feather", "label": "Pluma" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "droplet", "label": "Gota" },
            { "value": "sun", "label": "Sol" },
            { "value": "moon", "label": "Luna" },
            { "value": "clock", "label": "Reloj" },
            { "value": "hand", "label": "Mano" },
            { "value": "heart", "label": "Corazón" },
            { "value": "sparkles", "label": "Destellos" },
            { "value": "bolt", "label": "Rayo" },
            { "value": "battery", "label": "Batería" },
            { "value": "shield", "label": "Escudo" },
            { "value": "award", "label": "Medalla" },
            { "value": "eye", "label": "Ojo" },
            { "value": "home", "label": "Casa" },
            { "value": "globe", "label": "Mundo" },
            { "value": "cash", "label": "Efectivo" }
          ],
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "2 o 3 palabras.",
          "default": "Beneficio concreto"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texto",
          "info": "Una oración: característica real → beneficio en tu día.",
          "default": "Explica qué hace esta característica y cómo te ayuda en tu día a día."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Foto y razones",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "target", "title": "Función principal", "body": "Cuenta qué hace el producto y en qué momento del día lo vas a notar." } },
        { "type": "benefit", "settings": { "icon": "hand", "title": "Comodidad", "body": "Explica por qué se siente bien al usarlo, incluso varias horas seguidas." } },
        { "type": "benefit", "settings": { "icon": "feather", "title": "Material", "body": "Nombra el material real y lo que te aporta: liviano, suave o respirable." } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "Fácil de usar", "body": "Describe cómo se pone o se usa, sin pasos complicados ni ayuda." } }
      ]
    }
  ]
}
{% endschema %}
