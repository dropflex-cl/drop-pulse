{%- comment -%}
  DropFlex · Testimonios (review-wall). El muro de reseñas reales dibujadas como publicaciones de
  Facebook, portado del `dropflex-reviews` de v1: avatar, nombre sobre la fecha, el texto, las fotos
  de borde a borde, la fila de reacciones y la barra Me gusta · Comentar · Compartir. Un comprador
  lee el pantallazo de una publicación como la palabra de otro comprador y una tarjeta de reseña
  como marketing de la tienda, aunque las palabras sean las mismas: por eso la tarjeta usa la
  paleta y la tipografía de Facebook y no las de la tienda.

  Distinto de v1: DOS publicaciones por fila en el teléfono (en v1 era una y el muro obligaba a
  mucho scroll), las primeras `initial_posts` a la vista y el resto tras «Ver más testimonios», el
  texto recortado a `text_lines` con su «Ver más», y las fotos en un cuadro de proporción fija
  (1, 2 o 3 fotos, como Facebook) para que las filas calcen.

  REGLA: la IA no escribe reseñas. Elige reseñas APROBADAS por id y el orden; el texto, la fecha y
  las fotos salen de `dropflex.reviews` / `dropflex.reviews_images`. Un id que ya no existe se omite.

  Contenido: metafield `dropflex.review_wall` (json) { heading, items: [{ review_id }] }. Sin él no
  se dibuja (en el editor, un aviso): el muro ocupa media página y usarlo lo decide el comerciante
  en DropFlex («Usar en la página»), no el hecho de tener reseñas publicadas.

  Lo que NO es dato real: el nombre al azar (ajuste author_names; las reseñas importadas traen
  «Cliente» o «M***a»), los contadores de reacciones y comentarios y la barra de acciones. Los dos
  últimos van aria-hidden y son spans, no botones: nada ahí es clicable. Nombres y contadores salen
  del id del producto y de la posición de la reseña: son los mismos para todos y en cada recarga,
  como los de una publicación de verdad (v1 sorteaba los contadores por visitante en localStorage).
  El nombre elige lista de mujer u hombre por el texto («encantada», «mi esposo»…) para que no
  firme «Juan» una reseña que dice «quedé encantada».
  Espejo en React: components/store-preview/review-wall.tsx + lib/store-preview/review-wall.ts.
{%- endcomment -%}
{%- liquid
  if product == blank
    assign product = section.settings.product
  endif
  assign s = section.settings
  assign content = product.metafields.dropflex.review_wall.value
  assign summary = product.metafields.dropflex.review_summary.value
  assign reviews = product.metafields.dropflex.reviews.value.items
  assign images = product.metafields.dropflex.reviews_images.value

  assign count = summary.count | default: reviews.size | default: 0 | plus: 0

  # Índices (en dropflex.reviews) de las reseñas elegidas, en el orden del muro. Un id que ya no
  # existe (la reseña se despublicó) se omite; una reseña sin texto ni fotos no es publicación.
  assign picked = ''
  assign total = 0
  for item in content.items
    if total >= 12
      break
    endif
    assign item_id = item.review_id | append: ''
    for review in reviews
      assign review_id = review.id | append: ''
      if review_id == item_id and item_id != blank
        assign r_photos = review.image_count | plus: 0
        if review.body != blank or r_photos > 0
          assign picked = picked | append: forloop.index0 | append: ','
          assign total = total | plus: 1
        endif
        break
      endif
    endfor
  endfor
  assign picks = picked | split: ','

  assign show = true
  if product == blank or total < 2 or count < s.min_reviews
    assign show = false
  endif

  if show
    assign rating = summary.rating | default: 0 | plus: 0
    assign r10 = rating | times: 10 | round
    assign r_int = r10 | divided_by: 10
    assign r_dec = r10 | modulo: 10
    assign rating_text = r_int | append: ',' | append: r_dec
    assign count_text = count | append: ''
    if count >= 1000
      assign thousands = count | divided_by: 1000
      assign rest = count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign count_text = thousands | append: '.' | append: rest
    endif

    assign heading = content.heading | default: s.heading
    if heading contains '{rating}' and rating <= 0
      assign heading = s.heading
    endif
    assign heading = heading | replace: '{count}', count_text | replace: '{rating}', rating_text

    assign cols_m = s.columns_mobile | default: 2
    assign cols_d = s.columns_desktop | default: 3
    assign cols_t = cols_d | at_most: 3
    assign initial = s.initial_posts | default: 6
    assign ratio = '1 / 1'
    if s.photo_ratio == 'portrait'
      assign ratio = '4 / 5'
    endif

    # sizes de las fotos: una foto ocupa la tarjeta; con 2 o 3, la mayor ocupa 2/3.
    assign vw_m = 100 | divided_by: cols_m
    assign vw_t = 100 | divided_by: cols_t
    assign px_d = 1200 | divided_by: cols_d
    assign sizes_one = '(min-width: 990px) ' | append: px_d | append: 'px, (min-width: 750px) ' | append: vw_t | append: 'vw, ' | append: vw_m | append: 'vw'
    assign vw_m2 = vw_m | times: 2 | divided_by: 3
    assign vw_t2 = vw_t | times: 2 | divided_by: 3
    assign px_d2 = px_d | times: 2 | divided_by: 3
    assign sizes_multi = '(min-width: 990px) ' | append: px_d2 | append: 'px, (min-width: 750px) ' | append: vw_t2 | append: 'vw, ' | append: vw_m2 | append: 'vw'

    # Semilla fija por producto: nombres y contadores iguales para todos y en cada recarga.
    assign seed = product.id | modulo: 9973
    assign women = 'María|Camila|Valentina|Daniela|Fernanda|Javiera|Catalina|Constanza|Francisca|Sofía|Isidora|Antonia|Paula|Carolina|Andrea|Natalia|Gabriela|Paola|Claudia|Lorena|Patricia|Verónica|Macarena|Bárbara|Karina|Pamela|Alejandra|Marcela|Carla|Tamara|Nicole|Josefa|Florencia|Martina|Agustina|Trinidad|Emilia|Ignacia|Rocío|Lucía|Elena|Sandra|Mónica|Cecilia|Soledad|Ximena|Viviana|Romina|Belén|Ana' | split: '|'
    assign men = 'Juan|José|Carlos|Luis|Jorge|Diego|Felipe|Sebastián|Matías|Nicolás|Tomás|Benjamín|Cristóbal|Ignacio|Francisco|Rodrigo|Gonzalo|Andrés|Pablo|Javier|Álvaro|Eduardo|Ricardo|Fernando|Manuel|Alejandro|Daniel|Marcelo|Mauricio|Claudio|Patricio|Cristián|Héctor|Raúl|Sergio|Víctor|Hernán|Óscar|Gustavo|Martín|Joaquín|Vicente|Agustín|Maximiliano|Esteban|Rafael|Samuel|Gabriel|Emilio|Pedro' | split: '|'
    assign initials = 'A|B|C|D|E|F|G|H|I|J|L|M|N|O|P|R|S|T|V|Z' | split: '|'
    assign fem_marks = ' encantada | contenta | satisfecha | enamorada | sorprendida | agradecida | cansada | embarazada | mi esposo | mi marido | mi novio ' | split: '|'
    assign masc_marks = ' encantado | contento | satisfecho | enamorado | sorprendido | agradecido | cansado | mi esposa | mi señora | mi mujer | mi novia ' | split: '|'
    assign months = 'enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre' | split: '|'
    assign short_months = 'ene|feb|mar|abr|may|jun|jul|ago|sep|oct|nov|dic' | split: '|'
    assign this_year = 'now' | date: '%Y'

    # Fondo contra el que df-accent-vars mide el acento (la tienda es siempre clara).
    assign bg = '#f0f2f5'
    if s.background == 'page'
      assign bg = '#ffffff'
    endif
  endif
-%}

{%- if show -%}
  {%- liquid
    capture avatar_svg
      echo '<svg viewBox="0 0 40 40" fill="currentColor" aria-hidden="true"><circle cx="20" cy="15" r="6.4"/><path d="M20 23.5c-6.4 0-11.6 3.9-11.6 8.7V40h23.2v-7.8c0-4.8-5.2-8.7-11.6-8.7z"/></svg>'
    endcapture
    capture dots_svg
      echo '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="19" cy="12" r="1.9"/></svg>'
    endcapture
    capture globe_svg
      echo '<svg class="df-review-wall__globe" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25"/><path d="M1.75 8h12.5M8 1.75c1.9 1.7 2.9 3.8 2.9 6.25s-1 4.55-2.9 6.25C6.1 12.55 5.1 10.45 5.1 8S6.1 3.45 8 1.75z"/></svg>'
    endcapture
    # Las reacciones, dibujadas: un emoji saldría con la cara que trae el sistema del visitante.
    capture reactions_svg
      echo '<svg viewBox="0 0 24 24" aria-hidden="true"><circle class="df-review-wall__react-bg df-review-wall__react-bg--like" cx="12" cy="12" r="12"/><path class="df-review-wall__react-fg" d="M10.6 5.6c1.1-.3 2 .5 2 1.6v3h3.6c1 0 1.7.9 1.5 1.9l-.9 4.3c-.2.8-.9 1.4-1.7 1.4h-5.2c-.6 0-1.1-.2-1.5-.6V10c.9-.6 1.6-1.5 1.9-2.6l.3-1.8z"/><rect class="df-review-wall__react-fg" x="5.2" y="10.2" width="2.9" height="8" rx="0.9"/></svg>'
      echo '<svg viewBox="0 0 24 24" aria-hidden="true"><circle class="df-review-wall__react-bg df-review-wall__react-bg--love" cx="12" cy="12" r="12"/><path class="df-review-wall__react-fg" d="M12 18.4s-5.6-3.4-5.6-7A3.2 3.2 0 0 1 12 9.2a3.2 3.2 0 0 1 5.6 2.2c0 3.6-5.6 7-5.6 7z"/></svg>'
    endcapture
    capture like_svg
      echo '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v10H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10H7z"/><path d="M7 10.5 11 3a2.2 2.2 0 0 1 2.2 2.2V9.5h5.1a1.9 1.9 0 0 1 1.85 2.35l-1.3 5.6A2.2 2.2 0 0 1 16.7 19H7"/></svg>'
    endcapture
    capture comment_svg
      echo '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.6c0 4.3-4 7.8-9 7.8-1 0-2-.15-2.9-.42L4 20.5l1.35-3.6C3.9 15.5 3 13.65 3 11.6 3 7.3 7 3.8 12 3.8s9 3.5 9 7.8z"/></svg>'
    endcapture
    capture share_svg
      echo '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5v6.2A1.3 1.3 0 0 0 5.3 20h13.4a1.3 1.3 0 0 0 1.3-1.3v-6.2"/><path d="M12 15.2V4.2M7.7 8.3 12 4l4.3 4.3"/></svg>'
    endcapture
  -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'df-review-wall.js' | asset_url }}" defer></script>

  <df-review-wall
    class="df df-review-wall df-review-wall--{{ s.background }}"
    style="{% render 'df-accent-vars', product: product, background: bg %} --df-rw-pt: {{ s.padding_top }}px; --df-rw-pb: {{ s.padding_bottom }}px; --df-rw-cols-m: {{ cols_m }}; --df-rw-cols-t: {{ cols_t }}; --df-rw-cols-d: {{ cols_d }}; --df-rw-lines: {{ s.text_lines }}; --df-rw-ratio: {{ ratio }};"
  >
    <div class="df-review-wall__inner">
      {%- if heading != blank or s.show_rating -%}
        <div class="df-review-wall__head">
          {%- if heading != blank -%}
            <h2 class="df-heading df-review-wall__heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if s.show_rating and rating > 0 -%}
            {%- capture proof -%}{%- render 'df-review-proof', summary: summary -%}{%- endcapture -%}
            <p class="df-review-wall__rating">
              {%- assign stars_label = rating_text | append: ' de 5 estrellas' -%}
              {%- render 'df-stars', rating: rating, size: '1.125rem', label: stars_label -%}
              <span class="df-review-wall__score" aria-hidden="true">{{ rating_text }}</span>
              <span>
                {%- if proof != blank -%}
                  {{ proof | strip | capitalize }}
                {%- else -%}
                  {{ count_text }} {% if count == 1 %}reseña{% else %}reseñas{% endif %}
                {%- endif -%}
              </span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="df-review-wall__grid" role="list">
        {%- for pick in picks -%}
          {%- liquid
            assign ri = pick | plus: 0
            assign review = reviews[ri]
            assign post_id = 'df-rw-' | append: section.id | append: '-' | append: forloop.index

            if s.author_names == 'original'
              assign author = review.author | default: 'Cliente'
            else
              assign t = review.body | downcase | replace: '.', ' ' | replace: ',', ' ' | replace: '!', ' ' | replace: '¡', ' ' | replace: '?', ' ' | replace: '¿', ' ' | replace: ';', ' ' | replace: ':', ' ' | replace: '(', ' ' | replace: ')', ' ' | replace: '"', ' ' | newline_to_br | replace: '<br />', ' ' | strip_newlines
              assign t = ' ' | append: t | append: ' '
              assign gender = ''
              for mark in fem_marks
                if t contains mark
                  assign gender = 'f'
                  break
                endif
              endfor
              if gender == ''
                for mark in masc_marks
                  if t contains mark
                    assign gender = 'm'
                    break
                  endif
                endfor
              endif
              if gender == ''
                assign parity = seed | plus: ri | modulo: 2
                if parity == 0
                  assign gender = 'f'
                else
                  assign gender = 'm'
                endif
              endif
              assign ni = ri | times: 37 | plus: seed | modulo: 50
              assign ii = ri | times: 7 | plus: seed | modulo: initials.size
              if gender == 'f'
                assign author = women[ni]
              else
                assign author = men[ni]
              endif
              assign author = author | append: ' ' | append: initials[ii] | append: '.'
            endif

            assign date_text = ''
            assign date_short = ''
            if s.show_date and review.date != blank
              assign d_year = review.date | slice: 0, 4
              assign d_month = review.date | slice: 5, 2 | plus: 0
              assign d_day = review.date | slice: 8, 2 | plus: 0
              if d_month >= 1 and d_month <= 12 and d_day >= 1
                assign mi = d_month | minus: 1
                assign date_text = d_day | append: ' de ' | append: months[mi]
                assign date_short = d_day | append: ' ' | append: short_months[mi]
                if d_year != this_year
                  assign date_text = date_text | append: ' de ' | append: d_year
                  assign date_short = date_short | append: ' ' | append: d_year
                endif
              endif
            endif

            assign r_from = review.image_from | plus: 0
            assign r_photos = review.image_count | plus: 0 | at_most: 3
            assign photo_sizes = sizes_one
            if r_photos > 1
              assign photo_sizes = sizes_multi
            endif

            # Contadores decorativos, fijos por producto y reseña (320 a 1.600 reacciones, 8 a 46
            # comentarios: más conversación que «me gusta» se lee como discusión, no como prueba).
            assign reactions = ri | times: 389 | plus: seed | modulo: 1281 | plus: 320
            assign comments = ri | times: 17 | plus: seed | modulo: 39 | plus: 8
            assign reactions_text = reactions | append: ''
            if reactions >= 1000
              assign tenths = reactions | divided_by: 100
              assign k_int = tenths | divided_by: 10
              assign k_dec = tenths | modulo: 10
              if k_dec == 0
                assign reactions_text = k_int | append: ' mil'
              else
                assign reactions_text = k_int | append: ',' | append: k_dec | append: ' mil'
              endif
            endif
          -%}
          <li class="df-review-wall__cell" data-df-rw-post {% if forloop.index > initial %}hidden{% endif %}>
            <article class="df-review-wall__post" id="{{ post_id }}" aria-labelledby="{{ post_id }}-name" tabindex="-1">
              <div class="df-review-wall__top">
                <span class="df-review-wall__avatar" aria-hidden="true">{{ avatar_svg }}</span>
                <div class="df-review-wall__who">
                  <p class="df-review-wall__name" id="{{ post_id }}-name">{{ author | escape }}</p>
                  {%- if date_text != blank -%}
                    <p class="df-review-wall__date">
                      <time datetime="{{ review.date | escape }}"><span class="df-review-wall__date-short">{{ date_short }}</span><span class="df-review-wall__date-long">{{ date_text }}</span></time>
                      <span aria-hidden="true"> · </span>
                      {{- globe_svg -}}
                    </p>
                  {%- endif -%}
                </div>
                <span class="df-review-wall__dots" aria-hidden="true">{{ dots_svg }}</span>
              </div>

              {%- if review.body != blank -%}
                <p class="df-review-wall__text" data-df-rw-text>{{ review.body | escape | newline_to_br }}</p>
                <button type="button" class="df-review-wall__expand" data-df-rw-expand hidden>Ver más</button>
              {%- endif -%}

              {%- if r_photos > 0 -%}
                <div class="df-review-wall__photos df-review-wall__photos--{{ r_photos }}">
                  {%- comment -%}
                    Se recorre la lista con offset/limit, como v1 (que la recorría entera): una
                    lista de referencias no es un array nativo y `slice` la degrada a texto.
                  {%- endcomment -%}
                  {%- for shot in images offset: r_from limit: r_photos -%}
                    {%- liquid
                      # Un file_reference de imagen es un MediaImage; image_url toma su .image.
                      assign src = shot.image | default: shot
                      assign photo_alt = 'Foto de ' | append: author
                    -%}
                    {%- if src != blank -%}
                      <div class="df-review-wall__photo">
                        {{
                          src
                          | image_url: width: 800
                          | image_tag: loading: 'lazy', widths: '160, 240, 320, 480, 640, 800', sizes: photo_sizes, alt: photo_alt
                        }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if s.show_engagement or s.show_actions -%}
                <div class="df-review-wall__foot" aria-hidden="true">
                  {%- if s.show_engagement -%}
                    <div class="df-review-wall__stats">
                      <span class="df-review-wall__reactions">
                        <span class="df-review-wall__emojis">{{ reactions_svg }}</span>
                        <span>{{ reactions_text }}</span>
                      </span>
                      <span class="df-review-wall__comments">
                        {{- comments -}}
                        <span class="df-review-wall__comments-label"> comentarios</span>
                        <span class="df-review-wall__comments-icon">{{ comment_svg }}</span>
                      </span>
                    </div>
                  {%- endif -%}
                  {%- if s.show_actions -%}
                    <div class="df-review-wall__actions">
                      <span class="df-review-wall__action">{{ like_svg }}<span class="df-review-wall__action-label">Me gusta</span></span>
                      <span class="df-review-wall__action">{{ comment_svg }}<span class="df-review-wall__action-label">Comentar</span></span>
                      <span class="df-review-wall__action">{{ share_svg }}<span class="df-review-wall__action-label">Compartir</span></span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if total > initial -%}
        <div class="df-review-wall__more">
          <button type="button" class="df-review-wall__more-button" data-df-rw-more data-step="{{ initial }}">
            {{- s.more_label | default: 'Ver más testimonios' | escape -}}
          </button>
        </div>
      {%- endif -%}
    </div>
  </df-review-wall>
{%- elsif request.design_mode -%}
  {{ 'df-components.css' | asset_url | stylesheet_tag }}
  <div class="df df-review-wall" style="--df-rw-pt: {{ s.padding_top }}px; --df-rw-pb: {{ s.padding_bottom }}px;">
    <div class="df-review-wall__inner">
      <p class="df-placeholder">
        Testimonios: se muestra cuando lo usas en la página desde DropFlex y el producto tiene al menos {{ s.min_reviews }} reseñas aprobadas.
      </p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* La paleta es la de Facebook, NO la del tema: una publicación teñida como el resto de la
     página deja de leerse como publicación. */
  .df-review-wall {
    --df-fb-card: #ffffff;
    --df-fb-ink: #050505;
    --df-fb-muted: #65676b;
    --df-fb-line: #ced0d4;
    --df-fb-edge: #dddfe2;
    --df-fb-avatar: #e4e6eb;
    --df-fb-avatar-ink: #bcc0c4;
    --df-fb-feed: #f0f2f5;
    --df-fb-like: #1877f2;
    --df-fb-love: #f33e58;
    --df-fb-font: system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    display: block;
    padding-block: calc(var(--df-rw-pt, 48px) * var(--df-space, 1)) calc(var(--df-rw-pb, 48px) * var(--df-space, 1));
  }

  .df-review-wall--feed {
    background: var(--df-fb-feed);
  }

  .df-review-wall__inner {
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--df-gutter);
  }

  .df-review-wall__head {
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 40rem;
    margin: 0 auto calc(var(--df-title-gap) * 0.75);
    text-align: center;
  }

  .df-review-wall__heading {
    margin: 0;
    font-size: var(--df-title-size);
    text-wrap: balance;
  }

  .df-review-wall__rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 8px;
    margin: 0;
    color: var(--df-muted);
    font-size: 0.9375rem;
  }

  .df-review-wall__score {
    color: var(--df-fg);
    font-weight: 600;
  }

  /* El muro: 2 por fila en el teléfono (ajuste columns_mobile), 3 en tableta y el ajuste en
     escritorio. Las tarjetas de una fila se estiran al mismo alto y el pie queda abajo. */
  .df-review-wall__grid {
    display: grid;
    grid-template-columns: repeat(var(--df-rw-cols-m, 2), minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-review-wall__cell {
    display: flex;
    min-width: 0;
  }

  .df-review-wall__cell[hidden],
  .df-review-wall__expand[hidden],
  .df-review-wall__more[hidden] {
    display: none;
  }

  .df-review-wall__post {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    container: df-rw-post / inline-size;
    border: 1px solid var(--df-fb-edge);
    border-radius: 8px;
    background: var(--df-fb-card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
    color: var(--df-fb-ink);
    font-family: var(--df-fb-font);
    text-align: start;
  }

  .df-review-wall__post:focus {
    outline: none;
  }

  .df-review-wall__post:focus-visible {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  /* Cabecera: avatar · nombre sobre la fecha · los tres puntos. Tamaños de tarjeta angosta
     (media pantalla de teléfono); desde 260 px de tarjeta, los de v1. */
  .df-review-wall__top {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 10px 6px;
  }

  .df-review-wall__avatar {
    flex: none;
    width: 28px;
    height: 28px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--df-fb-avatar);
    color: var(--df-fb-avatar-ink);
  }

  .df-review-wall__avatar svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .df-review-wall__who {
    flex: 1;
    min-width: 0;
  }

  .df-review-wall__name {
    margin: 0;
    overflow: hidden;
    color: var(--df-fb-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .df-review-wall .df-review-wall__date {
    display: flex;
    align-items: center;
    margin: 1px 0 0;
    overflow: hidden;
    color: var(--df-fb-muted);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  .df-review-wall__date time {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Fecha corta en la tarjeta angosta («1 dic 2025»), larga desde 260 px («1 de diciembre de 2025»). */
  .df-review-wall__date-long {
    display: none;
  }

  .df-review-wall__globe {
    flex: none;
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .df-review-wall__dots {
    flex: none;
    align-self: flex-start;
    color: var(--df-fb-muted);
  }

  .df-review-wall__dots svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  /* Margen y no relleno: bajo un line-clamp, el relleno deja asomar la línea cortada. Con
     .df-review-wall delante: el `p { margin: 0 }` del tema no se lo come. */
  .df-review-wall .df-review-wall__text {
    display: -webkit-box;
    margin: 0 10px 8px;
    padding: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--df-rw-lines, 4);
    line-clamp: var(--df-rw-lines, 4);
    color: var(--df-fb-ink);
    font-size: 0.8125rem;
    line-height: 1.34;
    overflow-wrap: anywhere;
  }

  .df-review-wall .df-review-wall__text.is-expanded {
    display: block;
    -webkit-line-clamp: none;
    line-clamp: none;
  }

  /* «Ver más» como el de Facebook: texto gris en negrita; el área táctil crece con ::after sin
     sumar alto a la tarjeta. Con .df-review-wall delante: los botones del tema no le pisan la fuente. */
  .df-review-wall .df-review-wall__expand {
    position: relative;
    align-self: flex-start;
    margin: -4px 10px 8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--df-fb-muted);
    font: 600 0.8125rem/1.34 var(--df-fb-font);
    cursor: pointer;
  }

  .df-review-wall__expand::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  .df-review-wall__expand:focus-visible {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Fotos: un cuadro de proporción fija (ajuste photo_ratio) para que las filas calcen. Una foto
     lo llena; dos van lado a lado; tres, una grande y dos apiladas, como Facebook. */
  .df-review-wall__photos {
    display: grid;
    gap: 2px;
    aspect-ratio: var(--df-rw-ratio, 1 / 1);
    background: var(--df-fb-edge);
  }

  .df-review-wall__photos--2 {
    grid-template-columns: 1fr 1fr;
  }

  .df-review-wall__photos--3 {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .df-review-wall__photos--3 .df-review-wall__photo:first-child {
    grid-row: span 2;
  }

  .df-review-wall__photo {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--df-fb-avatar);
  }

  .df-review-wall__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-review-wall__foot {
    margin-top: auto;
  }

  .df-review-wall__stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 7px 10px;
    color: var(--df-fb-muted);
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .df-review-wall__reactions,
  .df-review-wall__comments {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .df-review-wall__emojis {
    display: inline-flex;
  }

  .df-review-wall__emojis svg {
    display: block;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--df-fb-card);
    border-radius: 50%;
  }

  .df-review-wall__emojis svg + svg {
    margin-left: -5px;
  }

  .df-review-wall__react-bg--like {
    fill: var(--df-fb-like);
  }

  .df-review-wall__react-bg--love {
    fill: var(--df-fb-love);
  }

  .df-review-wall__react-fg {
    fill: var(--df-fb-card);
  }

  .df-review-wall__comments-label {
    display: none;
  }

  .df-review-wall__comments-icon svg {
    display: block;
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* La barra de acciones: solo íconos en la tarjeta angosta; con etiqueta desde 300 px. El filete
     va dentro del relleno, como bajo los contadores de una publicación. */
  .df-review-wall__actions {
    display: flex;
    margin: 0 10px;
    border-top: 1px solid var(--df-fb-line);
  }

  .df-review-wall__action {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 0 8px;
    color: var(--df-fb-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .df-review-wall__action svg {
    flex: none;
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .df-review-wall__action-label {
    display: none;
  }

  @container df-rw-post (min-width: 260px) {
    .df-review-wall__top {
      gap: 8px;
      padding: 12px 12px 8px;
    }

    .df-review-wall__avatar {
      width: 40px;
      height: 40px;
    }

    .df-review-wall__name {
      font-size: 0.9375rem;
    }

    .df-review-wall .df-review-wall__date {
      font-size: 0.8125rem;
    }

    .df-review-wall__date-short {
      display: none;
    }

    .df-review-wall__date-long {
      display: inline;
    }

    .df-review-wall__globe {
      width: 12px;
      height: 12px;
    }

    .df-review-wall__dots svg {
      width: 20px;
      height: 20px;
    }

    .df-review-wall .df-review-wall__text {
      margin: 0 12px 12px;
      font-size: 0.9375rem;
    }

    .df-review-wall .df-review-wall__expand {
      font-size: 0.9375rem;
    }

    .df-review-wall .df-review-wall__expand {
      margin: -8px 12px 12px;
    }

    .df-review-wall__stats {
      padding: 9px 12px;
      font-size: 0.875rem;
    }

    .df-review-wall__emojis svg {
      width: 18px;
      height: 18px;
    }

    .df-review-wall__comments-label {
      display: inline;
    }

    .df-review-wall__comments-icon {
      display: none;
    }

    .df-review-wall__actions {
      margin: 0 12px;
    }
  }

  @container df-rw-post (min-width: 300px) {
    .df-review-wall__action {
      padding: 9px 0;
    }

    .df-review-wall__action svg {
      width: 18px;
      height: 18px;
    }

    .df-review-wall__action-label {
      display: inline;
    }
  }

  @container df-rw-post (min-width: 360px) {
    .df-review-wall__action {
      font-size: 0.875rem;
    }
  }

  .df-review-wall__more {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  .df-review-wall .df-review-wall__more-button {
    min-height: 44px;
    padding: 0 24px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius-pill);
    background: var(--df-bg);
    color: var(--df-fg);
    font: 600 0.9375rem/1.2 var(--df-font-body);
    cursor: pointer;
  }

  .df-review-wall--feed .df-review-wall__more-button.df-review-wall__more-button {
    background: var(--df-fb-card);
  }

  .df-review-wall__more-button:hover {
    border-color: color-mix(in srgb, var(--df-fg) 30%, transparent);
  }

  .df-review-wall__more-button:focus-visible {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  @media (min-width: 750px) {
    .df-review-wall__grid {
      grid-template-columns: repeat(var(--df-rw-cols-t, 3), minmax(0, 1fr));
      gap: 16px;
    }

    .df-review-wall__more {
      margin-top: 28px;
    }
  }

  @media (min-width: 990px) {
    .df-review-wall__grid {
      grid-template-columns: repeat(var(--df-rw-cols-d, 3), minmax(0, 1fr));
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Testimonios",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Reseñas aprobadas en DropFlex dibujadas como publicaciones de Facebook. La selección y el título vienen del metafield dropflex.review_wall; sin él, la sección no se muestra."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de respaldo",
      "info": "Se usa si el título de DropFlex pide una calificación que todavía no hay. Puedes usar {count} y {rating}.",
      "default": "Lo que dicen quienes ya lo tienen"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Botón para ver más",
      "default": "Ver más testimonios"
    },
    {
      "type": "header",
      "content": "Reseñas"
    },
    {
      "type": "range",
      "id": "min_reviews",
      "label": "Mínimo de reseñas",
      "info": "Con menos reseñas aprobadas, la sección no se muestra.",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "initial_posts",
      "label": "Publicaciones a la vista",
      "info": "El resto aparece con el botón para ver más.",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 6
    },
    {
      "type": "select",
      "id": "author_names",
      "label": "Nombres",
      "info": "Las reseñas importadas traen autores como «Cliente» o «M***a», que en una publicación se leen como un error. Al azar: un nombre y una inicial, siempre los mismos para cada reseña.",
      "options": [
        { "value": "random", "label": "Nombre al azar" },
        { "value": "original", "label": "El autor de la reseña" }
      ],
      "default": "random"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar la calificación promedio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Mostrar la fecha",
      "default": true
    },
    {
      "type": "header",
      "content": "Apariencia de publicación"
    },
    {
      "type": "checkbox",
      "id": "show_engagement",
      "label": "Reacciones y comentarios",
      "info": "Los números son decorativos: acompañan el formato de publicación, no vienen de las reseñas.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_actions",
      "label": "Barra Me gusta · Comentar",
      "default": true
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columnas en teléfono",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "text_lines",
      "label": "Líneas del texto",
      "info": "Más largo se recorta con «Ver más».",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "photo_ratio",
      "label": "Fotos",
      "options": [
        { "value": "square", "label": "Cuadradas" },
        { "value": "portrait", "label": "Verticales (4:5)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "feed", "label": "Gris de Facebook" },
        { "value": "page", "label": "El de la página" }
      ],
      "default": "feed"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Testimonios"
    }
  ]
}
{% endschema %}
