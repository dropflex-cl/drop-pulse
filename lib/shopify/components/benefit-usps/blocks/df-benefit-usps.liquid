{%- assign df_conversion_product = closest.product | default: product | default: section.settings.product -%}
{%- unless df_conversion_product.metafields.dropflex.conversion_supports.value.disabled_components contains 'benefit-usps' -%}
<div data-df-pdp-component="benefit-usps">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.benefit_usps.value -%}

{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-benefit-usps">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-benefit-usps-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-benefit-usps-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-benefit-usps-content', product: df_product, section: section, block: block, content: df_variants %}
{%- endif -%}

</div>

{%- endunless -%}

{% stylesheet %}
  .df-benefit-usps {
    display: flex;
    flex-direction: column;
    gap: var(--df-usps-gap, 8px);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--df-usps-text, 15px);
    line-height: 1.35;
    --df-usps-icon-color: var(--df-accent-ink);
  }

  .df-benefit-usps--icon-text {
    --df-usps-icon-color: var(--df-fg);
  }

  .df-benefit-usps--row {
    flex-flow: row wrap;
    column-gap: calc(var(--df-usps-gap, 8px) * 2);
  }

  .df-benefit-usps--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .df-benefit-usps--card {
    padding: 16px;
    border-radius: var(--df-radius-sm);
    background: var(--df-surface);
  }

  .df-benefit-usps__item {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .df-benefit-usps__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    min-width: var(--df-usps-icon, 20px);
    height: var(--df-usps-icon, 20px);
    color: var(--df-usps-icon-color);
  }

  .df-benefit-usps__icon .df-icon {
    width: var(--df-usps-icon, 20px);
    height: var(--df-usps-icon, 20px);
  }

  /* Imagen propia: alto fijo, ancho libre hasta el doble (banderas, logos rectangulares). */
  .df-benefit-usps__img {
    width: auto;
    max-width: calc(var(--df-usps-icon, 20px) * 2);
    height: var(--df-usps-icon, 20px);
    object-fit: contain;
  }

  .df-benefit-usps__text {
    min-width: 0;
    text-wrap: pretty;
  }

  .df-benefit-usps__text strong {
    font-weight: 700;
  }
{% endstylesheet %}

