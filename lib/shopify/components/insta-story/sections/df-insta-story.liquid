{%- assign df_conversion_product = closest.product | default: product -%}
{%- unless df_conversion_product.metafields.dropflex.conversion_supports.value.disabled_components contains 'insta-story' -%}
<div data-df-pdp-component="insta-story">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.insta_story.value -%}
<script src="{{ 'df-insta-story.js' | asset_url }}" defer></script>
<script src="{{ 'df-motion.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-insta-story">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% capture df_rendered %}{% if df_default.content.state == 'empty' %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% else %}{% render 'df-insta-story-content', product: df_product, section: section, content: df_default.content, df_variant: df_default %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% endif %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% capture df_rendered %}{% if df_variant.content.state == 'empty' %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% else %}{% render 'df-insta-story-content', product: df_product, section: section, content: df_variant.content, df_variant: df_variant %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% endif %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% capture df_rendered %}{% if df_variants.state == 'empty' %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% else %}{% render 'df-insta-story-content', product: df_product, section: section, content: df_variants %}{% endif %}{% endcapture %}{% if df_rendered contains 'class="df' %}{{ df_rendered }}{% else %}{% render 'df-component-empty', component: 'insta-story', product: df_product %}{% endif %}
{%- endif -%}

</div>

{%- endunless -%}
{% stylesheet %}
  df-insta-story {
    display: block;
  }

  .df-insta-story {
    --df-story-size: 80px;
    --df-story-ring: linear-gradient(210deg, var(--df-accent), color-mix(in srgb, var(--df-accent) 35%, var(--df-star)));
    /* El visor es un lienzo oscuro sobre fotos y videos (como Instagram): blanco y negro fijos
       a propósito, no colores de marca. */
    --df-story-ink: #ffffff;
    --df-story-canvas: #000000;
    --df-story-scrim: rgb(0 0 0 / 0.88);
  }

  .df-insta-story--ring-solid {
    --df-story-ring: var(--df-accent);
  }

  .df-insta-story--ring-none {
    --df-story-ring: transparent;
  }

  .df-insta-story__inner {
    max-width: calc(var(--df-container) + var(--df-gutter) * 2);
    margin-inline: auto;
  }

  .df-insta-story--card .df-insta-story__inner {
    width: calc(100% - var(--df-gutter) * 2);
    max-width: var(--df-container);
    margin-inline: auto;
    padding-block: 24px;
    border-radius: var(--df-radius-lg);
    background: var(--df-surface);
  }

  .df-insta-story__header {
    display: grid;
    gap: 8px;
    margin-bottom: var(--df-title-gap);
    padding-inline: var(--df-gutter);
    text-align: center;
  }

  .df-insta-story__heading {
    font-size: var(--df-title-size);
  }

  .df-insta-story__row {
    display: flex;
    justify-content: safe center;
    gap: 16px;
    margin: 0;
    padding: 4px 16px 8px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .df-insta-story__row::-webkit-scrollbar {
    display: none;
  }

  .df-insta-story__item {
    flex: none;
    scroll-snap-align: start;
  }

  .df-insta-story__circle {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: calc(var(--df-story-size) + 8px);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .df-insta-story__ring {
    display: block;
    width: var(--df-story-size);
    height: var(--df-story-size);
    padding: 3px;
    border-radius: 50%;
    background: var(--df-story-ring);
    transition: transform 0.2s var(--df-ease);
  }

  .df-insta-story__circle:hover .df-insta-story__ring {
    transform: scale(1.04);
  }

  .df-insta-story__circle:focus-visible {
    outline: none;
  }

  .df-insta-story__circle:focus-visible .df-insta-story__ring {
    outline: 2px solid var(--df-fg);
    outline-offset: 3px;
  }

  .df-insta-story__item.is-seen .df-insta-story__ring {
    background: color-mix(in srgb, var(--df-fg) 18%, transparent);
  }

  .df-insta-story--ring-none .df-insta-story__item.is-seen .df-insta-story__ring {
    background: transparent;
  }

  .df-insta-story__thumb {
    display: block;
    width: 100%;
    height: 100%;
    border: 3px solid var(--df-bg);
    border-radius: 50%;
    object-fit: cover;
    background: var(--df-surface);
  }

  .df-insta-story--card .df-insta-story__thumb {
    border-color: var(--df-surface);
  }

  .df-insta-story__label {
    display: -webkit-box;
    max-width: 100%;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    color: var(--df-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Visor */
  .df-insta-story__viewer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--df-story-ink);
    overflow: hidden;
  }

  .df-insta-story__viewer[open] {
    display: grid;
    place-items: center;
  }

  .df-insta-story__viewer::backdrop {
    background: var(--df-story-scrim);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .df-insta-story__stage {
    position: relative;
    width: 100%;
    height: 100%;
    margin-inline: auto;
    overflow: hidden;
    background: var(--df-story-canvas);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .df-insta-story__slides {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .df-insta-story__slide {
    position: relative;
    height: 100%;
  }

  .df-insta-story__slide[hidden] {
    display: none;
  }

  .df-insta-story__slide::before,
  .df-insta-story__slide::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    pointer-events: none;
  }

  .df-insta-story__slide::before {
    top: 0;
    height: 120px;
    background: linear-gradient(rgb(0 0 0 / 0.5), transparent);
  }

  .df-insta-story__slide::after {
    bottom: 0;
    height: 50%;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
  }

  .df-insta-story__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .df-insta-story__bars {
    position: absolute;
    inset: 10px 10px auto;
    z-index: 3;
    display: flex;
    gap: 4px;
  }

  .df-insta-story__bar {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.35);
  }

  .df-insta-story__fill {
    display: block;
    height: 100%;
    background: var(--df-story-ink);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .df-insta-story__controls {
    position: absolute;
    top: 18px;
    right: 4px;
    z-index: 3;
    display: flex;
    transition: opacity 0.2s var(--df-ease);
  }

  .df-insta-story__control,
  .df-insta-story__nav {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--df-story-ink);
    cursor: pointer;
  }

  .df-insta-story__control svg {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }

  .df-insta-story__control[hidden] {
    display: none;
  }

  .df-insta-story__control:focus-visible,
  .df-insta-story__nav:focus-visible,
  .df-insta-story__cta:focus-visible {
    outline: 2px solid var(--df-story-ink);
    outline-offset: 2px;
  }

  [data-df-pause][aria-pressed='true'] .df-insta-story__icon-pause,
  [data-df-pause][aria-pressed='false'] .df-insta-story__icon-play,
  [data-df-mute][aria-pressed='true'] .df-insta-story__icon-sound,
  [data-df-mute][aria-pressed='false'] .df-insta-story__icon-muted {
    display: none;
  }

  .df-insta-story__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    background: rgb(0 0 0 / 0.35);
    transform: translateY(-50%);
    transition: opacity 0.2s var(--df-ease);
  }

  .df-insta-story__nav svg {
    width: 24px;
    height: 24px;
  }

  .df-insta-story__nav--prev {
    left: 6px;
  }

  .df-insta-story__nav--next {
    right: 6px;
  }

  .df-insta-story__nav[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  .df-insta-story__viewer.is-holding .df-insta-story__controls,
  .df-insta-story__viewer.is-holding .df-insta-story__nav {
    opacity: 0;
  }

  .df-insta-story__caption {
    position: absolute;
    inset: auto 16px max(24px, env(safe-area-inset-bottom));
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
  }

  .df-insta-story__line-1 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .df-insta-story__line-2 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  .df-insta-story__line-2 span {
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--df-accent);
    color: var(--df-on-accent);
    text-shadow: none;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .df-insta-story__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 10px;
    padding: 12px 28px;
    border-radius: var(--df-radius-pill);
    background: var(--df-story-ink);
    color: var(--df-story-canvas);
    font-weight: 700;
    text-decoration: none;
    text-shadow: none;
  }

  @media (min-width: 750px) {
    .df-insta-story__row {
      gap: 24px;
    }

    .df-insta-story--card .df-insta-story__inner {
      margin-inline: auto;
      padding-block: 32px;
    }

    .df-insta-story__stage {
      width: auto;
      height: min(92dvh, 960px);
      aspect-ratio: 9 / 16;
      border-radius: var(--df-radius-media);
    }

    .df-insta-story__nav--prev {
      left: 10px;
    }

    .df-insta-story__nav--next {
      right: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Historias",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Los medios vienen del metafield dropflex.insta_story_media o de los bloques; los textos, de dropflex.insta_story o de cada bloque. Usa solo fotos y videos reales: una persona generada con IA no puede presentarse como cliente."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (fuera de la ficha)"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Míralo en acción"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Bajada",
      "default": "Toca una historia para verla"
    },
    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Destino del botón",
      "info": "Un #ancla de esta página (ej.: #comprar). Vacío = página del producto. El enlace de cada historia tiene prioridad."
    },
    {
      "type": "header",
      "content": "Visor"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duración de imágenes",
      "info": "Los videos duran lo que dura el video.",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "start_muted",
      "label": "Videos sin sonido",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "close_at_end",
      "label": "Cerrar al terminar",
      "default": true
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Tamaño del círculo",
      "min": 60,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "ring_style",
      "label": "Aro",
      "options": [
        { "value": "gradient", "label": "Degradado" },
        { "value": "solid", "label": "Sólido" },
        { "value": "none", "label": "Sin aro" }
      ],
      "default": "gradient"
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "Tarjeta de fondo",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Historia",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Vertical 9:16, 1080 × 1920 px. Sin textos horneados."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical 9:16, idealmente menos de 30 s. Si hay video, se usa en vez de la imagen."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Miniatura del círculo",
          "info": "Opcional. Vacío = recorte del medio."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Etiqueta",
          "info": "1 o 2 palabras bajo el círculo.",
          "default": "Cómo se usa"
        },
        {
          "type": "text",
          "id": "caption_line_1",
          "label": "Texto, línea 1"
        },
        {
          "type": "text",
          "id": "caption_line_2",
          "label": "Texto, línea 2 (acento)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Historias",
      "blocks": [
        { "type": "story", "settings": { "title": "Cómo se usa" } },
        { "type": "story", "settings": { "title": "Detalle" } },
        { "type": "story", "settings": { "title": "En el día" } },
        { "type": "story", "settings": { "title": "Pídelo", "cta_label": "Pedir ahora" } }
      ]
    }
  ]
}
{% endschema %}
