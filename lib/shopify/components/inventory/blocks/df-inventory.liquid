<div data-df-pdp-component="inventory">
{%- comment -%} Contenido por df_angle/df_hook; fuente editable: lib/shopify/components/. {%- endcomment -%}
{%- assign df_product = closest.product | default: product | default: section.settings.product -%}
{%- assign df_variants = df_product.metafields.dropflex.inventory.value -%}
<script src="{{ 'df-inventory.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-inventory">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-inventory-content', product: df_product, section: section, block: block, content: df_variants %}
{%- endif -%}

</div>

{% stylesheet %}
  .df-inventory {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--df-inventory-size, 14px);
    line-height: 1.35;
    --df-inventory-color: var(--df-positive);
  }

  .df-inventory[hidden] {
    display: none;
  }

  .df-inventory--limited { --df-inventory-color: var(--df-warning); }
  .df-inventory--sold_out { --df-inventory-color: var(--df-negative); }
  .df-inventory--preorder { --df-inventory-color: var(--df-info); }

  .df-inventory__text {
    color: var(--df-inventory-color);
    font-weight: 500;
  }

  .df-inventory__dot {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--df-inventory-color);
  }

  /* Tres latidos y se detiene (WCAG 2.2.2: nada se mueve solo más de 5 s). df-inventory.js agrega
     `is-ping` al entrar en pantalla y lo repite al cambiar de variante. Sin JS, el punto queda quieto. */
  .df-inventory--pulse .df-inventory__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    opacity: 0;
  }

  .df-inventory--pulse.is-ping .df-inventory__dot::after {
    animation: df-inventory-ping 1.4s var(--df-ease) 3;
  }

  @keyframes df-inventory-ping {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(2.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .df-inventory--pulse.is-ping .df-inventory__dot::after { animation: none; }
  }
{% endstylesheet %}

