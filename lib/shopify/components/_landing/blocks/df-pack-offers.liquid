{%- assign df_product = closest.product | default: product -%}
{%- assign df_variants = df_product.metafields.dropflex.landing_listing.value -%}
<script src="{{ 'df-pack-offers.js' | asset_url }}" defer></script>
{%- if df_variants.first.key != blank -%}
  <df-landing-content data-df-component="df-pack-offers">
    {%- assign df_default = df_variants | where: 'key', 'default' | first -%}
    <div data-df-active>{% render 'df-pack-offers-content', product: df_product, section: section, block: block, content: df_default.content, df_variant: df_default %}</div>
    {%- for df_variant in df_variants -%}
      <template data-df-variant="{{ df_variant.key | escape }}" data-angle="{{ df_variant.angle_id | escape }}" data-hook="{{ df_variant.hook_id | escape }}">
        {% render 'df-pack-offers-content', product: df_product, section: section, block: block, content: df_variant.content, df_variant: df_variant %}
      </template>
    {%- endfor -%}
    <script>window.DropFlexLanding?.mount(document.currentScript.parentElement);</script>
  </df-landing-content>
{%- else -%}
  {% render 'df-pack-offers-content', product: df_product, section: section, block: block %}
{%- endif -%}

{% stylesheet %}
  /* Con packs, la cantidad la elige la tarjeta: el selector de cantidad del tema sobra. */
  .product-details:has(df-pack-offers) .quantity-selector-wrapper {
    display: none;
  }

  .df-pack-offers[hidden],
  .df-pack-offers__set[hidden],
  .df-pack-offers__card[hidden],
  .df-pack-offers__notice[hidden] {
    display: none;
  }

  .df-pack-offers__notice {
    margin-top: 10px;
    padding: 10px 12px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-surface);
    color: var(--df-fg);
    font-size: 13px;
    line-height: 1.4;
  }

  .df-pack-offers__notice ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  .df-pack-offers__set {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* La oferta entre dos líneas: ── 2 por $39.990 · Paga al recibir ── */
  .df-pack-offers__heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--df-fg);
  }

  .df-pack-offers__heading::before,
  .df-pack-offers__heading::after {
    content: '';
    flex: 1 0 24px;
    height: 1px;
    background: var(--df-hairline);
  }

  .df-pack-offers__heading span {
    flex: 0 1 auto;
    text-wrap: balance;
  }

  .df-pack-offers__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding: 12px 16px 12px 14px;
    border: 1px solid var(--df-hairline);
    border-radius: var(--df-radius);
    background: var(--df-bg);
    cursor: pointer;
    --df-press-scale: 0.985;
    transition:
      border-color var(--df-dur-base) var(--df-ease-standard),
      background-color var(--df-dur-base) var(--df-ease-standard),
      box-shadow var(--df-dur-base) var(--df-ease-standard),
      scale var(--df-dur-fast) var(--df-ease-standard);
  }

  /* La marca de la tarjeta elegida: un círculo que se llena con el acento y un check que entra. */
  .df-pack-offers__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid color-mix(in srgb, var(--df-fg) 35%, transparent);
    border-radius: 50%;
    color: var(--df-on-accent);
    transition:
      background-color var(--df-dur-base) var(--df-ease-standard),
      border-color var(--df-dur-base) var(--df-ease-standard);
  }

  .df-pack-offers__mark .df-icon {
    width: 14px;
    height: 14px;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity var(--df-dur-base) var(--df-ease-enter),
      scale var(--df-dur-base) var(--df-ease-enter);
  }

  .df-pack-offers__card:has(:checked) .df-pack-offers__mark {
    border-color: var(--df-accent);
    background: var(--df-accent);
  }

  .df-pack-offers__card:has(:checked) .df-pack-offers__mark .df-icon {
    opacity: 1;
    scale: 1;
  }

  .df-pack-offers__card:has(:disabled) .df-pack-offers__mark {
    border-color: var(--df-hairline);
  }

  .df-pack-offers__card--badge {
    margin-top: 8px;
  }

  .df-pack-offers__card:hover {
    border-color: color-mix(in srgb, var(--df-fg) 30%, transparent);
  }

  .df-pack-offers__card:has(:checked) {
    border-color: var(--df-accent);
    box-shadow: inset 0 0 0 1px var(--df-accent);
    background: var(--df-accent-soft);
  }

  .df-pack-offers__card:has(:focus-visible) {
    outline: 2px solid var(--df-accent);
    outline-offset: 2px;
  }

  .df-pack-offers__card:has(:disabled) {
    cursor: not-allowed;
    background: var(--df-surface);
    color: var(--df-muted);
  }

  /* El radio real queda accesible y encima de la tarjeta; lo que se ve es la tarjeta. */
  .df-pack-offers__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .df-pack-offers__badge {
    position: absolute;
    top: 0;
    right: 12px;
    transform: translateY(-50%);
    padding: 3px 10px;
    border-radius: var(--df-radius-pill);
    background: var(--df-accent);
    color: var(--df-on-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .df-pack-offers__media {
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: var(--df-radius-media);
    background: var(--df-surface);
  }

  .df-pack-offers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .df-pack-offers__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .df-pack-offers__label {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .df-pack-offers__support {
    font-size: 13px;
    line-height: 1.35;
    color: var(--df-muted);
  }

  .df-pack-offers__prices {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: right;
  }

  .df-pack-offers__price {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .df-pack-offers__was {
    font-size: 13px;
    color: var(--df-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .df-pack-offers__card,
    .df-pack-offers__mark,
    .df-pack-offers__mark .df-icon {
      transition: none;
    }
  }

  [data-df-motion='off'] .df-pack-offers__card,
  [data-df-motion='off'] .df-pack-offers__mark,
  [data-df-motion='off'] .df-pack-offers__mark .df-icon {
    transition: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropFlex · Packs",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Una tarjeta por pack (1, 2 y 3 unidades) del metafield dropflex.offer. Cada pack es la variante de 1 unidad × N y lo cobra la oferta por cantidad de EasySell: crea una opción por pack, con el mismo precio y sin preseleccionar. Un pack que EasySell no cobra igual no se muestra."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de respaldo",
      "default": "Elige tu pack"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar la foto de cada pack",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Mostrar el ahorro si no hay texto",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Texto del ahorro",
      "info": "{amount} es lo que ahorra frente al precio tachado.",
      "default": "Ahorras {amount}"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DropFlex · Packs"
    }
  ]
}
{% endschema %}
