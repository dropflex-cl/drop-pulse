{%- doc -%}
  Valoración real guardada por la tienda. Sin datos, no se muestra.
  @param {object} product
{%- enddoc -%}
{%- liquid
  assign google = shop.metafields.dropflex.google_rating.value
  assign google_score = google.rating | plus: 0
  assign google_count = google.count | default: 0 | plus: 0
  assign google_url_prefix = google.url | slice: 0, 8
-%}
{%- if google_score > 0 and google_score <= 5 and google_count > 0 -%}
{{ 'df-components.css' | asset_url | stylesheet_tag }}
<div class="df df-google-rating" style="{% render 'df-accent-vars', product: product %}" data-df-google-rating data-product-id="{{ product.id }}" aria-label="Reseñas de la tienda en Google">
  {{ 'df-google-logo.svg' | inline_asset_content }}
  {% render 'df-stars', rating: google_score, size: '1rem' %}
  {%- capture google_label -%}
    Calificado <span data-df-google-score>{{ google_score | replace: '.', ',' }}</span>/5 en Google
    {%- if google_count > 0 %} <span class="df-google-rating__count">({{ google_count }} reseñas)</span>{% endif -%}
  {%- endcapture -%}
  {%- if google_url_prefix == 'https://' -%}
    <a href="{{ google.url | escape }}" target="_blank" rel="noopener noreferrer">{{ google_label }}</a>
  {%- else -%}
    <span>{{ google_label }}</span>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  /* space-1/2/6, type-label/caption y size-touch de design-system/tokens.json. */
  .df-google-rating { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; border: 1px dashed var(--df-hairline); border-radius: var(--df-radius-sm); padding: 4px 8px; font-size: 14px; line-height: 20px; }
  .df-google-rating > svg, .df-google-rating > img { width: 24px; height: 24px; flex: none; }
  .df-google-rating a { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; min-height: 44px; color: inherit; text-decoration: none; }
  .df-google-rating__count { color: var(--df-muted); font-size: 12px; }
{% endstylesheet %}
