{%- doc -%}
  Valoración compartida de la PDP. No exige configuración ni reseñas importadas de Google.
  @param {object} product
{%- enddoc -%}
{%- liquid
  assign google = shop.metafields.dropflex.google_rating.value
  capture pdp_rating
    render 'df-pdp-rating', product: product
  endcapture
  assign pdp_rating = pdp_rating | split: '|'
  assign google_score = pdp_rating[0] | plus: 0
  assign google_count = pdp_rating[1] | plus: 0
  assign r10 = google_score | times: 10 | round
  assign r_int = r10 | divided_by: 10
  assign r_dec = r10 | modulo: 10
  assign rating_text = r_int | append: ',' | append: r_dec
  assign count_text = google_count | append: ''
  if google_count >= 1000
    assign thousands = google_count | divided_by: 1000
    assign rest = google_count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
    assign count_text = thousands | append: '.' | append: rest
  endif
  assign google_url_prefix = google.url | slice: 0, 8
-%}
{%- if product != blank -%}
{{ 'df-components.css' | asset_url | stylesheet_tag }}
<div class="df df-google-rating" style="{% render 'df-accent-vars', product: product %}" data-df-google-rating data-df-rating-group data-df-rating-stars {% if google_score <= 0 %}hidden{% endif %} data-product-id="{{ product.id }}" aria-label="Valoración del producto">
  {{ 'df-google-logo.svg' | inline_asset_content }}
  {% render 'df-stars', rating: google_score, size: '1rem' %}
  {%- capture google_label -%}
    Calificado <span data-df-google-score data-df-rating-template="{rating}">{{ rating_text }}</span>/5 en Google
    <span class="df-google-rating__count" data-df-rating-template="({count} reseñas)">({{ count_text }} reseñas)</span>
  {%- endcapture -%}
  {%- if google_url_prefix == 'https://' -%}
    <a href="{{ google.url | escape }}" target="_blank" rel="noopener noreferrer">{{ google_label }}</a>
  {%- else -%}
    <span>{{ google_label }}</span>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  /* space-1/2/6, type-label/caption y size-touch de design-system/tokens.json. */
  .df-google-rating { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; border: 1px dashed var(--df-hairline); border-radius: var(--df-radius-sm); padding: 4px 8px; font-size: 14px; line-height: 20px; }
  .df-google-rating > svg, .df-google-rating > img { width: 24px; height: 24px; flex: none; }
  .df-google-rating a { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; min-height: 44px; color: inherit; text-decoration: none; }
  .df-google-rating__count { color: var(--df-muted); font-size: 12px; }
{% endstylesheet %}
