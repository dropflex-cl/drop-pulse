{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "product_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "data": {
          "type": "object",
          "properties": {
            "applied": {
              "type": "boolean"
            },
            "dry_run": {
              "type": "boolean"
            },
            "no_op": {
              "type": "boolean"
            },
            "base_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "id_map": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "format": "uuid"
              }
            },
            "diff": {
              "minItems": 0,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "diff_truncated": {
              "type": "boolean"
            },
            "pricing": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "currency_scale": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "pricing_stamp": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "unit_cost_minor": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "avg_shipping_cost_minor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "purchase_cost_limit_minor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "confirmation_rate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "delivery_rate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "extra_unit_discount": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 95
                    },
                    "sale_price_minor": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "compare_at_price_minor": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "minimum_price_minor": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "recommended_price_minor": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "margin": {
                      "type": "number"
                    },
                    "beroas": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "packs": {
                      "minItems": 3,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema2"
                      }
                    },
                    "profit_decimal": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                    },
                    "max_cpa_decimal": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 80,
                          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "currency",
                    "currency_scale",
                    "pricing_stamp",
                    "unit_cost_minor",
                    "avg_shipping_cost_minor",
                    "purchase_cost_limit_minor",
                    "confirmation_rate",
                    "delivery_rate",
                    "extra_unit_discount",
                    "sale_price_minor",
                    "compare_at_price_minor",
                    "minimum_price_minor",
                    "recommended_price_minor",
                    "margin",
                    "beroas",
                    "packs",
                    "profit_decimal",
                    "max_cpa_decimal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "applied",
            "dry_run",
            "no_op",
            "base_revision",
            "id_map",
            "diff",
            "diff_truncated",
            "pricing"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "minItems": 0,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "ok",
        "product_id",
        "revision",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "NOT_FOUND",
                "FORBIDDEN",
                "INVALID_REFERENCE",
                "DEPENDENCY_IN_USE",
                "REVISION_CONFLICT",
                "ARTIFACT_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "PAYLOAD_TOO_LARGE",
                "RESPONSE_TOO_LARGE",
                "SCHEMA_VERSION_UNSUPPORTED",
                "RATE_LIMITED",
                "CURSOR_EXPIRED",
                "CURSOR_INVALID",
                "EXECUTION_NOT_READY",
                "INTEGRATION_NOT_CONNECTED",
                "GENERATION_IN_PROGRESS",
                "PROVIDER_RECONCILIATION_REQUIRED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expected_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "missing_fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema4"
                  }
                },
                "fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "retry_after_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "format": "uuid"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "next_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "context",
            "pricing",
            "source",
            "fact",
            "evidence_link",
            "persona",
            "jtbd",
            "pain",
            "desire",
            "objection",
            "angle",
            "customer_language",
            "offer",
            "strategy"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "archive",
            "restore",
            "reprioritize",
            "select"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed_fields": {
          "minItems": 0,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "entity",
        "action",
        "id",
        "client_ref",
        "changed_fields"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "price_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "savings_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recommended": {
          "type": "boolean"
        },
        "approved_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "profit_decimal": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "per_unit_price_decimal": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "required": [
        "units",
        "price_minor",
        "savings_minor",
        "recommended",
        "approved_label",
        "profit_decimal",
        "per_unit_price_decimal"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "field"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "type": "object"
}
