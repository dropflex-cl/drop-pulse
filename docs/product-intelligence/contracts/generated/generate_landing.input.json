{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "stage": {
          "type": "string",
          "const": "content"
        },
        "strategy_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "all"
                  ]
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "only"
                },
                "component_ids": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "mode",
                "component_ids"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "product_id",
        "schema_version",
        "expected_revision",
        "idempotency_key",
        "stage",
        "strategy_id",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "stage": {
          "type": "string",
          "const": "images"
        },
        "strategy_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "higgsfield",
            "gemini"
          ]
        },
        "plans": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "product_id",
        "schema_version",
        "expected_revision",
        "idempotency_key",
        "stage",
        "strategy_id",
        "provider",
        "plans"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "enum": [
            "cover",
            "gallery",
            "benefit-1",
            "benefit-2",
            "benefit-3"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "fact_ids": {
          "minItems": 0,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "slot",
        "position",
        "prompt",
        "fact_ids"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    }
  },
  "type": "object"
}
