{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "script_id",
    "expected_artifact_etag"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "script_id": {
      "$ref": "#/$defs/__schema0"
    },
    "expected_artifact_etag": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
