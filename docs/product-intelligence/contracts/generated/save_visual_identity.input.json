{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_etag",
    "expected_dependency_stamp",
    "idempotency_key",
    "identity"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "__schema3": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_etag": {
      "$ref": "#/$defs/__schema1"
    },
    "expected_dependency_stamp": {
      "$ref": "#/$defs/__schema1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "identity_id": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "canonical_reference_image_id": {
          "$ref": "#/$defs/__schema0"
        },
        "reference_content_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "reference_mode": {
          "type": "string",
          "enum": [
            "strict_product_identity",
            "guided_reference"
          ]
        },
        "identity_description": {
          "$ref": "#/$defs/__schema2"
        },
        "preserve": {
          "minItems": 1,
          "$ref": "#/$defs/__schema3"
        },
        "allowed_variations": {
          "$ref": "#/$defs/__schema3"
        },
        "forbidden_variations": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "canonical_reference_image_id",
        "reference_content_hash",
        "reference_mode",
        "identity_description",
        "preserve",
        "allowed_variations",
        "forbidden_variations"
      ],
      "additionalProperties": false
    }
  }
}
