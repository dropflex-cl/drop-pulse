{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "NOT_FOUND",
                "FORBIDDEN",
                "INVALID_REFERENCE",
                "DEPENDENCY_IN_USE",
                "REVISION_CONFLICT",
                "ARTIFACT_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "PAYLOAD_TOO_LARGE",
                "RESPONSE_TOO_LARGE",
                "SCHEMA_VERSION_UNSUPPORTED",
                "RATE_LIMITED",
                "CURSOR_EXPIRED",
                "CURSOR_INVALID",
                "EXECUTION_NOT_READY",
                "INTEGRATION_NOT_CONNECTED",
                "GENERATION_IN_PROGRESS",
                "PROVIDER_RECONCILIATION_REQUIRED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expected_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "missing_fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "retry_after_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "format": "uuid"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "next_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "product_id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "data": {
          "type": "object",
          "properties": {
            "landing_etag": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contract_version": {
              "type": "string",
              "enum": [
                "1.1",
                "1.2"
              ]
            },
            "context_stale": {
              "type": "boolean"
            },
            "catalog": {
              "maxItems": 17,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "contract": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "placement": {
                  "type": "string"
                },
                "objection": {
                  "type": "string"
                },
                "schema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "forbidden": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "real_data": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "image_slots": {
                  "type": "array",
                  "items": {}
                },
                "examples": {
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema4"
                  }
                }
              },
              "required": [
                "component",
                "name",
                "placement",
                "objection",
                "schema",
                "rules",
                "forbidden",
                "real_data",
                "image_slots",
                "examples"
              ],
              "additionalProperties": false
            },
            "current": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "metadata": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "persuasion_plan_id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "experience_id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "angle_id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "landing_angle_id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                            },
                            "landing_hook_id": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "section_key": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "belief_keys": {
                              "minItems": 1,
                              "maxItems": 7,
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema5"
                              }
                            },
                            "persuasion_job": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "fact_ids": {
                              "maxItems": 50,
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema6"
                              }
                            },
                            "claim_keys": {
                              "maxItems": 40,
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema7"
                              }
                            }
                          },
                          "required": [
                            "persuasion_plan_id",
                            "angle_id",
                            "landing_angle_id",
                            "section_key",
                            "belief_keys",
                            "persuasion_job",
                            "fact_ids",
                            "claim_keys"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "id": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "content": {},
                    "enabled": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string"
                    },
                    "images": {
                      "type": "array",
                      "items": {}
                    }
                  },
                  "required": [
                    "id",
                    "content",
                    "enabled",
                    "status",
                    "images"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "image_catalog": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "approved_reviews": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "review_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pricing": {},
            "policies": {},
            "next_action": {
              "type": "string"
            }
          },
          "required": [
            "landing_etag",
            "contract_version",
            "context_stale",
            "catalog",
            "contract",
            "current",
            "image_catalog",
            "approved_reviews",
            "review_count",
            "pricing",
            "policies",
            "next_action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "product_id",
        "revision",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "min_reviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "name",
        "kind",
        "min_reviews",
        "available"
      ],
      "additionalProperties": false
    },
    "__schema4": {},
    "__schema5": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema6": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema7": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "reference",
            "page_image"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "body": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "body",
        "rating"
      ],
      "additionalProperties": false
    }
  },
  "type": "object"
}
