{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "maxLength": 120,
      "$ref": "#/$defs/__schema3"
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "1:1",
        "4:5"
      ]
    },
    "__schema5": {
      "type": "string",
      "maxLength": 500
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "SHOP_NOW",
        "ORDER_NOW",
        "BUY_NOW",
        "LEARN_MORE"
      ]
    },
    "__schema7": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "__schema11": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "palette": {
          "$ref": "#/$defs/__schema3"
        },
        "typography": {
          "$ref": "#/$defs/__schema3"
        },
        "lighting": {
          "$ref": "#/$defs/__schema3"
        },
        "photography_style": {
          "$ref": "#/$defs/__schema3"
        },
        "consistency_notes": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "palette",
        "typography",
        "lighting",
        "photography_style",
        "consistency_notes"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "boolean"
    },
    "__schema14": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/__schema16"
        },
        "headline": {
          "$ref": "#/$defs/__schema17"
        },
        "description": {
          "$ref": "#/$defs/__schema18"
        },
        "link": {
          "$ref": "#/$defs/__schema19"
        },
        "scene": {
          "$ref": "#/$defs/__schema20"
        },
        "image_texts": {
          "$ref": "#/$defs/__schema21"
        },
        "asset_id": {
          "$ref": "#/$defs/__schema23"
        },
        "media_id": {
          "$ref": "#/$defs/__schema24"
        },
        "enabled": {
          "$ref": "#/$defs/__schema25"
        }
      },
      "required": [
        "key",
        "headline",
        "scene",
        "image_texts"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema17": {
      "type": "string",
      "maxLength": 40
    },
    "__schema18": {
      "default": "",
      "type": "string",
      "maxLength": 30
    },
    "__schema19": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "$ref": "#/$defs/__schema3"
    },
    "__schema21": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema22"
      }
    },
    "__schema22": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema3"
        },
        "placement": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "text",
        "placement"
      ],
      "additionalProperties": false
    },
    "__schema23": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema24": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema25": {
      "type": "boolean"
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "default": 9007199254740991,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_etag": {
      "default": "",
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "expected_dependency_stamp": {
      "default": "",
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "carousel_id": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema2"
        },
        "ratio": {
          "$ref": "#/$defs/__schema4"
        },
        "primary_text": {
          "$ref": "#/$defs/__schema5"
        },
        "cta": {
          "$ref": "#/$defs/__schema6"
        },
        "strategy_id": {
          "$ref": "#/$defs/__schema7"
        },
        "angle_id": {
          "$ref": "#/$defs/__schema8"
        },
        "landing_angle_id": {
          "$ref": "#/$defs/__schema9"
        },
        "landing_hook_id": {
          "$ref": "#/$defs/__schema11"
        },
        "art": {
          "$ref": "#/$defs/__schema12"
        },
        "enabled": {
          "$ref": "#/$defs/__schema13"
        },
        "cards": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "name",
        "ratio",
        "primary_text",
        "cta",
        "art",
        "cards"
      ],
      "additionalProperties": false
    }
  }
}
