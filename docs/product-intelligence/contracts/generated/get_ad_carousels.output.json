{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "NOT_FOUND",
                "FORBIDDEN",
                "INVALID_REFERENCE",
                "DEPENDENCY_IN_USE",
                "REVISION_CONFLICT",
                "ARTIFACT_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "PAYLOAD_TOO_LARGE",
                "RESPONSE_TOO_LARGE",
                "SCHEMA_VERSION_UNSUPPORTED",
                "RATE_LIMITED",
                "CURSOR_EXPIRED",
                "CURSOR_INVALID",
                "EXECUTION_NOT_READY",
                "INTEGRATION_NOT_CONNECTED",
                "GENERATION_IN_PROGRESS",
                "PROVIDER_RECONCILIATION_REQUIRED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expected_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "missing_fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "retry_after_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "format": "uuid"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "next_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "product_id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "data": {
          "type": "object",
          "properties": {
            "carousels": {
              "maxItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "next_offset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 29
                },
                {
                  "type": "null"
                }
              ]
            },
            "contract": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "carousels",
            "next_offset",
            "contract",
            "rules"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "product_id",
        "revision",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "content": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/__schema4"
            },
            "ratio": {
              "$ref": "#/$defs/__schema6"
            },
            "primary_text": {
              "$ref": "#/$defs/__schema7"
            },
            "cta": {
              "$ref": "#/$defs/__schema8"
            },
            "strategy_id": {
              "$ref": "#/$defs/__schema9"
            },
            "angle_id": {
              "$ref": "#/$defs/__schema10"
            },
            "landing_angle_id": {
              "$ref": "#/$defs/__schema11"
            },
            "landing_hook_id": {
              "$ref": "#/$defs/__schema13"
            },
            "art": {
              "$ref": "#/$defs/__schema14"
            },
            "enabled": {
              "$ref": "#/$defs/__schema15"
            },
            "cards": {
              "$ref": "#/$defs/__schema16"
            }
          },
          "required": [
            "name",
            "ratio",
            "primary_text",
            "cta",
            "strategy_id",
            "angle_id",
            "landing_angle_id",
            "landing_hook_id",
            "art",
            "cards"
          ],
          "additionalProperties": false
        },
        "etag": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "content",
        "etag"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "maxLength": 120,
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "1:1",
        "4:5"
      ]
    },
    "__schema7": {
      "type": "string",
      "maxLength": 500
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "SHOP_NOW",
        "ORDER_NOW",
        "BUY_NOW",
        "LEARN_MORE"
      ]
    },
    "__schema9": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema12"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "__schema13": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema12"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "palette": {
          "$ref": "#/$defs/__schema5"
        },
        "typography": {
          "$ref": "#/$defs/__schema5"
        },
        "lighting": {
          "$ref": "#/$defs/__schema5"
        },
        "photography_style": {
          "$ref": "#/$defs/__schema5"
        },
        "consistency_notes": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "palette",
        "typography",
        "lighting",
        "photography_style",
        "consistency_notes"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema17"
      }
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/__schema18"
        },
        "headline": {
          "$ref": "#/$defs/__schema19"
        },
        "description": {
          "$ref": "#/$defs/__schema20"
        },
        "link": {
          "$ref": "#/$defs/__schema21"
        },
        "scene": {
          "$ref": "#/$defs/__schema22"
        },
        "image_texts": {
          "$ref": "#/$defs/__schema23"
        },
        "asset_id": {
          "$ref": "#/$defs/__schema25"
        },
        "media_id": {
          "$ref": "#/$defs/__schema26"
        },
        "enabled": {
          "$ref": "#/$defs/__schema27"
        }
      },
      "required": [
        "key",
        "headline",
        "description",
        "link",
        "scene",
        "image_texts"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema19": {
      "type": "string",
      "maxLength": 40
    },
    "__schema20": {
      "default": "",
      "type": "string",
      "maxLength": 30
    },
    "__schema21": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema22": {
      "$ref": "#/$defs/__schema5"
    },
    "__schema23": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema24"
      }
    },
    "__schema24": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema5"
        },
        "placement": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "text",
        "placement"
      ],
      "additionalProperties": false
    },
    "__schema25": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema26": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema27": {
      "type": "boolean"
    }
  },
  "type": "object"
}
