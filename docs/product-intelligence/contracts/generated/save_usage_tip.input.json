{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_content_etag",
    "idempotency_key",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "__schema2": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_content_etag": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "content": {
      "type": "object",
      "properties": {
        "text": {
          "maxLength": 140,
          "$ref": "#/$defs/__schema1"
        },
        "basis": {
          "maxLength": 1000,
          "$ref": "#/$defs/__schema1"
        },
        "fact_ids": {
          "default": [],
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "additionalProperties": false
    }
  }
}
