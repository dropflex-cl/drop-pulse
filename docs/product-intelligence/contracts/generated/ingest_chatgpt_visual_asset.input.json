{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "iteration_id",
    "file"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "default": 9007199254740991,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_etag": {
      "default": "",
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "expected_dependency_stamp": {
      "default": "",
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "idempotency_key": {
      "default": "f82be29c-9d5a-4529-975a-5e7d27d6b860",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "iteration_id": {
      "$ref": "#/$defs/__schema0"
    },
    "file": {
      "type": "object",
      "properties": {
        "download_url": {
          "type": "string",
          "maxLength": 8000,
          "format": "uri"
        },
        "file_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mime_type": {
          "type": "string",
          "maxLength": 200
        },
        "file_name": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "download_url",
        "file_id"
      ],
      "additionalProperties": false
    },
    "generated_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
