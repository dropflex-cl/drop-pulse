{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "NOT_FOUND",
                "FORBIDDEN",
                "INVALID_REFERENCE",
                "DEPENDENCY_IN_USE",
                "REVISION_CONFLICT",
                "ARTIFACT_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "PAYLOAD_TOO_LARGE",
                "RESPONSE_TOO_LARGE",
                "SCHEMA_VERSION_UNSUPPORTED",
                "RATE_LIMITED",
                "CURSOR_EXPIRED",
                "CURSOR_INVALID",
                "EXECUTION_NOT_READY",
                "INTEGRATION_NOT_CONNECTED",
                "GENERATION_IN_PROGRESS",
                "PROVIDER_RECONCILIATION_REQUIRED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expected_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "missing_fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "retry_after_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "format": "uuid"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "next_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "product_id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "data": {
          "type": "object",
          "properties": {
            "current": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "etag": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "schema_version": {
                          "type": "string",
                          "const": "1.0"
                        },
                        "strategy_id": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "angle_id": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "persuasion_plan_id": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "plan_revision": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "landing_angle_id": {
                          "$ref": "#/$defs/__schema3"
                        },
                        "landing_hook_id": {
                          "default": null,
                          "anyOf": [
                            {
                              "$ref": "#/$defs/__schema3"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "experience_key": {
                          "$ref": "#/$defs/__schema3"
                        },
                        "architecture_variant": {
                          "$ref": "#/$defs/__schema3"
                        },
                        "is_default": {
                          "default": false,
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "draft",
                            "review",
                            "active",
                            "archived"
                          ]
                        },
                        "sections": {
                          "minItems": 1,
                          "maxItems": 9,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema4"
                          }
                        }
                      },
                      "required": [
                        "schema_version",
                        "strategy_id",
                        "angle_id",
                        "persuasion_plan_id",
                        "plan_revision",
                        "landing_angle_id",
                        "landing_hook_id",
                        "experience_key",
                        "architecture_variant",
                        "is_default",
                        "status",
                        "sections"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "revision",
                    "etag",
                    "payload"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "items": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "etag": {
              "type": "string"
            },
            "planning_stamp": {
              "type": "string"
            }
          },
          "required": [
            "current",
            "items",
            "etag",
            "planning_stamp"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "product_id",
        "revision",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "section_key": {
          "$ref": "#/$defs/__schema5"
        },
        "component": {
          "type": "string",
          "enum": [
            "listing",
            "review-stars",
            "benefit-usps",
            "inventory",
            "shipping-timeline",
            "benefit-double-box",
            "gif-strip",
            "review-slider",
            "ugc-slider",
            "pain-block",
            "stats-with-image",
            "scrolling-benefits",
            "image-with-benefits",
            "insta-story",
            "review-wall",
            "comparison-table",
            "faq-and-text"
          ]
        },
        "content_variant_key": {
          "$ref": "#/$defs/__schema3"
        },
        "persuasion_job": {
          "type": "string",
          "enum": [
            "recognition",
            "desire_activation",
            "problem_visualization",
            "agitation",
            "reframe",
            "solution_logic",
            "product_fit",
            "differentiation",
            "mechanism",
            "demonstration",
            "ease",
            "social_proof",
            "similarity_proof",
            "authority_proof",
            "objection_resolution",
            "value",
            "risk_reversal",
            "urgency",
            "close"
          ]
        },
        "belief_keys": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "images": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "asset_refs": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "manual_overrides": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "section_key",
        "component",
        "content_variant_key",
        "persuasion_job",
        "belief_keys",
        "enabled",
        "images",
        "asset_refs",
        "manual_overrides"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "reference",
            "page_image"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "slot",
        "source",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "reference",
            "page_image",
            "ugc"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "role": {
          "type": "string",
          "enum": [
            "hero",
            "proof",
            "demo",
            "explanation",
            "comparison"
          ]
        },
        "slot": {
          "$ref": "#/$defs/__schema5"
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "order",
        "enabled",
        "component",
        "content",
        "assets"
      ]
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "etag": {
          "type": "string"
        },
        "strategy_id": {
          "$ref": "#/$defs/__schema0"
        },
        "angle_id": {
          "$ref": "#/$defs/__schema0"
        },
        "landing_angle_id": {
          "$ref": "#/$defs/__schema3"
        },
        "persuasion_plan_id": {
          "$ref": "#/$defs/__schema0"
        },
        "plan_revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "landing_hook_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "experience_key": {
          "$ref": "#/$defs/__schema3"
        },
        "architecture_variant": {
          "$ref": "#/$defs/__schema3"
        },
        "is_default": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "active",
            "archived"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "etag",
        "strategy_id",
        "angle_id",
        "landing_angle_id",
        "persuasion_plan_id",
        "plan_revision",
        "landing_hook_id",
        "experience_key",
        "architecture_variant",
        "is_default",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "type": "object"
}
