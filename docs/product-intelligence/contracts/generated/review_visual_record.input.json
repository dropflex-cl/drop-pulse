{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_etag",
    "expected_dependency_stamp",
    "idempotency_key",
    "record_id",
    "decision"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "wrong_product_shape",
        "wrong_color",
        "too_fake",
        "too_dirty",
        "bad_composition",
        "bad_text",
        "bad_reference_fidelity",
        "good_product_fidelity",
        "good_demo",
        "good_composition"
      ]
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_etag": {
      "$ref": "#/$defs/__schema1"
    },
    "expected_dependency_stamp": {
      "$ref": "#/$defs/__schema1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "record_id": {
      "$ref": "#/$defs/__schema0"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "reopen",
        "archive",
        "select",
        "unselect"
      ]
    },
    "reason": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "tags": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  }
}
