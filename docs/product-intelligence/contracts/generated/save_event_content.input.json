{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_content_etag",
    "idempotency_key",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_content_etag": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "content": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "#/$defs/__schema0"
        },
        "content": {
          "type": "object",
          "properties": {
            "announcement": {
              "description": "Barra de aviso arriba de la tienda: el evento + por qué comprar ahora este producto. Una frase.",
              "$ref": "#/$defs/__schema1"
            },
            "subtitle": {
              "description": "Bajada bajo el título durante el evento: la descripción corta aprobada con el enfoque del evento. Mismo resultado y mismo dato que la sostiene.",
              "$ref": "#/$defs/__schema2"
            },
            "badge_label": {
              "description": "Etiqueta junto al precio, en MAYÚSCULAS, sin porcentaje ni montos (la tienda agrega el % real). Ej.: «BLACK», «REGALO».",
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "announcement",
            "subtitle",
            "badge_label"
          ]
        },
        "fact_ids": {
          "default": [],
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "event_id",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
