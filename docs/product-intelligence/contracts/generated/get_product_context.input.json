{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "facts",
        "research",
        "personas",
        "jtbd",
        "pains",
        "desires",
        "objections",
        "angles",
        "customer_language",
        "offer",
        "strategy",
        "pdp",
        "assets",
        "performance"
      ]
    }
  },
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "include": {
      "minItems": 1,
      "maxItems": 14,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "uniqueItems": true
    },
    "view": {
      "default": "summary",
      "type": "string",
      "enum": [
        "summary",
        "full"
      ]
    },
    "at_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page_size": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "include_archived": {
      "default": false,
      "type": "boolean"
    }
  }
}
