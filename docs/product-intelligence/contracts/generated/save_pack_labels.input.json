{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_pack_labels_etag",
    "idempotency_key",
    "labels"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "support": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "badge": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "duration",
            "sharing",
            "spare",
            "gift",
            "savings",
            "other"
          ],
          "description": "En qué se apoya: duración real, compartir, repuesto, regalo, ahorro u otro."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "units",
        "label",
        "support",
        "badge",
        "basis",
        "reason"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_pack_labels_etag": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "labels": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "duration_fact_ids": {
      "default": [],
      "$ref": "#/$defs/__schema2"
    }
  }
}
