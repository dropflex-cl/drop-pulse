{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "expected_revision",
    "idempotency_key",
    "strategy_id",
    "confirmed_hooks",
    "auto_approve_and_publish"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "angle_id": {
          "$ref": "#/$defs/__schema0"
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "angle_id",
        "hook"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "strategy_id": {
      "$ref": "#/$defs/__schema0"
    },
    "confirmed_hooks": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "auto_approve_and_publish": {
      "type": "boolean",
      "const": true,
      "description": "El comerciante eligió estos hooks y autorizó aprobar el contenido y publicar en Shopify desde el chat."
    }
  }
}
