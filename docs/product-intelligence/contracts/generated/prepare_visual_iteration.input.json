{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "expected_etag",
    "expected_dependency_stamp",
    "idempotency_key",
    "plan_ref",
    "shot_key",
    "source_system"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_etag": {
      "$ref": "#/$defs/__schema1"
    },
    "expected_dependency_stamp": {
      "$ref": "#/$defs/__schema1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "plan_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "etag": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "version",
        "etag"
      ],
      "additionalProperties": false
    },
    "shot_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "parent_asset_id": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_asset_ids": {
      "default": [],
      "$ref": "#/$defs/__schema2"
    },
    "based_on_review_ids": {
      "default": [],
      "$ref": "#/$defs/__schema2"
    },
    "resolved_instruction": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_system": {
      "type": "string",
      "enum": [
        "chatgpt",
        "manual",
        "other"
      ]
    },
    "model": {
      "default": null,
      "anyOf": [
        {
          "maxLength": 120,
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
