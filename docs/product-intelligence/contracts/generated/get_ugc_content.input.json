{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    }
  },
  "properties": {
    "product_id": {
      "$ref": "#/$defs/__schema0"
    },
    "script_id": {
      "$ref": "#/$defs/__schema0"
    },
    "execution_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "include_contract": {
      "default": false,
      "type": "boolean"
    },
    "page_size": {
      "default": 12,
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "cursor": {
      "type": "string",
      "maxLength": 200
    }
  }
}
