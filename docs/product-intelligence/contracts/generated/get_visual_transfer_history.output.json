{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "NOT_FOUND",
                "FORBIDDEN",
                "INVALID_REFERENCE",
                "DEPENDENCY_IN_USE",
                "REVISION_CONFLICT",
                "ARTIFACT_CONFLICT",
                "IDEMPOTENCY_KEY_REUSED",
                "PAYLOAD_TOO_LARGE",
                "RESPONSE_TOO_LARGE",
                "SCHEMA_VERSION_UNSUPPORTED",
                "RATE_LIMITED",
                "CURSOR_EXPIRED",
                "CURSOR_INVALID",
                "EXECUTION_NOT_READY",
                "INTEGRATION_NOT_CONNECTED",
                "GENERATION_IN_PROGRESS",
                "PROVIDER_RECONCILIATION_REQUIRED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expected_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_artifact_etag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "missing_fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "fields": {
                  "minItems": 0,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "retry_after_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "format": "uuid"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "next_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "request_id": {
          "$ref": "#/$defs/__schema0"
        },
        "product_id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "object",
          "properties": {
            "events": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema3"
              }
            }
          },
          "required": [
            "events"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "request_id",
        "product_id",
        "revision",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "#/$defs/__schema0"
        },
        "attempt_id": {
          "$ref": "#/$defs/__schema0"
        },
        "stage": {
          "type": "string",
          "enum": [
            "reference_download",
            "host_upload",
            "followup",
            "tool_execution",
            "ingestion"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "started",
            "succeeded",
            "failed"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "reference_image_id": {
          "$ref": "#/$defs/__schema0"
        },
        "reference_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "iteration_id": {
          "$ref": "#/$defs/__schema0"
        },
        "operation_id": {
          "$ref": "#/$defs/__schema0"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z_]{1,80}$"
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z_]{1,80}$"
        },
        "reported_by": {
          "type": "string",
          "enum": [
            "widget",
            "server"
          ]
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "attempt_id",
        "stage",
        "state",
        "duration_ms",
        "reported_by",
        "created_at"
      ],
      "additionalProperties": false
    }
  },
  "type": "object"
}
