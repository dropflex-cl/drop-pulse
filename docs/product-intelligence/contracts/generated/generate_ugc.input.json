{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "schema_version",
    "expected_revision",
    "idempotency_key",
    "stage",
    "script_id",
    "expected_artifact_etag",
    "shot_keys"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[KAB][1-9][0-9]?$"
    }
  },
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "replace_existing": {
      "default": false,
      "type": "boolean"
    },
    "stage": {
      "type": "string",
      "enum": [
        "keyframes",
        "clips"
      ]
    },
    "script_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "expected_artifact_etag": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shot_keys": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  }
}
