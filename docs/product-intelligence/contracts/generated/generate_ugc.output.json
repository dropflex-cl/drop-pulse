              "pattern": "^[0-9a-f]{64}$"
            },
            "missing_fields": {
              "minItems": 0,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "fields": {
              "minItems": 0,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "operation_index": {
