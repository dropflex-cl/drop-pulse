{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:valores": "bash scripts/valores-sueltos.sh",
    "check:a11y": "tsx scripts/a11y.ts",
    "check:teclado": "tsx scripts/teclado.ts",
    "capturas": "tsx scripts/capturas.ts && tsx scripts/comparar-pantallas.ts",
    "capturas:componentes": "tsx scripts/componentes.ts && tsx scripts/comparar.ts componentes",
    "capturas:referencia": "tsx scripts/referencia/capturar.ts",
    "check:onboarding": "tsx scripts/onboarding.ts",
    "shopify:components": "tsx scripts/shopify-components.ts && tsx scripts/store-preview.ts && tsx scripts/kit-history.ts",
    "store-preview": "tsx scripts/store-preview.ts",
    "images:optimize": "tsx --conditions=react-server --env-file=.env.local scripts/optimize-existing-images.ts",
    "check:shopify": "tsx scripts/shopify-components.ts --check && tsx scripts/store-preview.ts --check && shopify theme check --path lib/shopify/themes/DropPulse --fail-level error"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
